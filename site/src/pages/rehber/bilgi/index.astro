---
import Temel from '../../../layouts/Temel.astro';
import { BILMENIZ_GEREKENLER } from '../../../lib/bilmeniz-gerekenler';

const sutunlar = [
  { kod: 'Tümü', ad: 'Tüm Rehberler' },
  { kod: 'S1', ad: 'Tapu & Mülkiyet' },
  { kod: 'S2', ad: 'Kira & Tahliye' },
  { kod: 'S3', ad: 'İmar & Dönüşüm' },
];
---

<Temel
  baslik="Mutlaka Bilmeniz Gerekenler — Gayrimenkul Rehberi"
  aciklama="Gayrimenkul işlemleri hakkında kaynaklı, gözden geçirilmiş açıklamalar ve dikkat edilmesi gereken noktalar."
>
  <section class="pt-28 pb-12 lg:pt-36 lg:pb-16">
    <div class="kab">
      <div class="max-w-3xl">
        <p class="etiket" data-belir>GAYRİMENKUL BİLGİ MERKEZİ</p>
        <h1 class="baslik-buyuk mt-3" data-belir data-gecikme="0.05">
          Mutlaka Bilmeniz Gerekenler
        </h1>
        <p class="mt-4 text-base leading-relaxed text-metin-2 lg:text-lg" data-belir data-gecikme="0.1">
          Gayrimenkul işlemlerindeki temel kavramları ve süreleri resmi kaynaklarla karşılaştırarak açıklıyoruz. Her işlemde sözleşmenizi ve güncel uygulamayı ayrıca kontrol edin.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-2">
        <a href="/sozluk" class="rounded-full bg-lacivert text-kagit px-4 py-2 text-xs font-bold hover:bg-lacivert/90 transition-colors">
          📖 Emlak Terimleri Sözlüğü'ne Git
        </a>
        <a href="/bulten" class="rounded-full bg-kagit-2 text-metin-2 px-4 py-2 text-xs font-bold hover:bg-kagit-3 transition-colors border border-cizgi">
          📰 Güncel Piyasa Bülteni
        </a>
      </div>
    </div>
  </section>

  <!-- Rehber Kartları Gridi -->
  <section class="pb-24 lg:pb-32">
    <div class="kab">
      <div class="grid gap-8 lg:grid-cols-2">
        {BILMENIZ_GEREKENLER.map((rehber) => (
          <article class="group flex flex-col justify-between rounded-2xl border border-cizgi bg-kagit-1 p-6 sm:p-8 transition-all duration-300 hover:border-metin-2/30 hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between gap-2 text-xs">
                <span class="rounded bg-lacivert/10 px-2.5 py-1 font-bold text-lacivert uppercase">
                  {rehber.sutunAdi}
                </span>
                <span class="text-metin-3 font-mono">{rehber.yasalDayanak}</span>
              </div>

              <h2 class="mt-4 font-serif text-xl font-bold leading-snug text-metin sm:text-2xl group-hover:text-kiremit transition-colors">
                <a href={`/rehber/bilgi/${rehber.slug}`}>
                  {rehber.baslik}
                </a>
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-metin-2 sm:text-base">
                {rehber.spot}
              </p>

              <!-- 3 Kritik Kural Kutuları -->
              <div class="mt-6 space-y-3">
                {rehber.kritikKurallar.map((k) => (
                  <div class={`rounded-lg p-3.5 border text-xs leading-relaxed ${
                    k.renk === 'kirmizi'
                      ? 'border-kiremit/30 bg-kiremit/5 text-metin'
                      : k.renk === 'altin'
                      ? 'border-amber-500/30 bg-amber-500/5 text-metin'
                      : 'border-lacivert/20 bg-lacivert/5 text-metin'
                  }`}>
                    <div class="flex items-center gap-2 font-bold mb-1">
                      <span class={`px-1.5 py-0.5 rounded text-[0.625rem] font-black uppercase text-white ${
                        k.renk === 'kirmizi' ? 'bg-kiremit' : k.renk === 'altin' ? 'bg-amber-600' : 'bg-lacivert'
                      }`}>
                        {k.etiket}
                      </span>
                      <span>{k.baslik}</span>
                    </div>
                    <p class="text-metin-2">{k.aciklama}</p>
                  </div>
                ))}
              </div>
            </div>

            <div class="mt-8 pt-4 border-t border-cizgi flex items-center justify-between">
              <span class="text-xs text-metin-3 font-medium">{rehber.okunmaSuresi}</span>
              <a
                href={`/rehber/bilgi/${rehber.slug}`}
                class="inline-flex items-center gap-1 text-sm font-bold text-kiremit hover:underline"
              >
                Çözüm Yolunu Oku
                <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 8h10M9 4l4 4-4 4" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Temel>
