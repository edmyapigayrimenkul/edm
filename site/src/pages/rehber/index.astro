---
import Temel from '../../layouts/Temel.astro';
import { bolgeler } from '../../lib/bolgeler';
import { fiyatYaz, portfoy } from '../../lib/ilanlar';
import { KURUM } from '../../lib/site';

const BOLGELER = await bolgeler();
const { sayimlar: SAYIMLAR, sonGuncelleme } = await portfoy();

const guncelleme = new Date(sonGuncelleme).toLocaleDateString('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const fiyatAraligi = (grup: (typeof BOLGELER)[number]['fiyatGruplari'][number]) => {
  const alt = fiyatYaz(grup.enDusuk, undefined, grup.paraBirimi);
  const ust = fiyatYaz(grup.enYuksek, undefined, grup.paraBirimi);
  return `${grup.enDusuk === grup.enYuksek ? alt : `${alt} — ${ust}`}${grup.donem ? ` ${grup.donem}` : ''}`;
};
---

<Temel
  baslik="Bölge Rehberi"
  aciklama={`Silivri, Edirne ve Tekirdağ'da ${SAYIMLAR.ilce} ilçe. Her bölgede kaç ilan var, fiyatlar nerede, arsada metrekare kaça geliyor — portföyümüzden hesaplanmış güncel veriler.`}
>
  <section class="pt-28 pb-14 lg:pt-36">
    <div class="kab">
      <p class="etiket" data-belir>Bölge Rehberi</p>
      <div class="mt-4 grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-end lg:gap-16">
        <h1 class="baslik-buyuk max-w-[15ch]" data-belir data-gecikme="0.05">
          Trakya’yı bölge bölge okuyalım
        </h1>
        <p class="max-w-[48ch] text-metin-2" data-belir data-gecikme="0.1">
          Aşağıdaki her rakam, kendi portföyümüzdeki {SAYIMLAR.toplam} ilandan hesaplandı —
          başka bir yerden alınmadı. Portföy değiştikçe sayılar da değişir. Bu örnekler bölgenin genel piyasa verisi değildir.
          <span class="block mt-2 etiket">Son güncelleme: {guncelleme}</span>
        </p>
      </div>

      <!-- Bilgi Rehberi & Sözlük Öne Çıkan Kartlar -->
      <div class="mt-12 grid gap-6 md:grid-cols-2" data-belir data-gecikme="0.15">
        <a
          href="/rehber/bilgi"
          class="group relative block overflow-hidden rounded-2xl border border-kiremit/20 bg-gradient-to-br from-kiremit/[0.05] via-transparent to-transparent p-7 transition-all duration-300 hover:border-kiremit/50 hover:shadow-xl hover:-translate-y-0.5"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-kiremit/10 px-3 py-1 font-mono text-[11px] font-semibold tracking-wider text-kiremit uppercase">
              Hukuk & Mevzuat
            </span>
            <span class="font-mono text-xs text-kursun group-hover:text-metin-1 transition-colors">Rehberi Gör &rarr;</span>
          </div>
          <h3 class="mt-4 font-serif text-2xl font-bold text-metin-1 group-hover:text-kiremit transition-colors">
            Mutlaka Bilmeniz Gerekenler
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-metin-2">
            Kentsel dönüşüm ve kira hukuku gibi gayrimenkul konularında kaynakları incelenmiş, adım adım rehberler.
          </p>
        </a>

        <a
          href="/sozluk"
          class="group relative block overflow-hidden rounded-2xl border border-lacivert/20 bg-gradient-to-br from-lacivert/[0.05] via-transparent to-transparent p-7 transition-all duration-300 hover:border-lacivert/50 hover:shadow-xl hover:-translate-y-0.5"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-lacivert/10 px-3 py-1 font-mono text-[11px] font-semibold tracking-wider text-lacivert uppercase">
              Terimler & İndeks
            </span>
            <span class="font-mono text-xs text-kursun group-hover:text-metin-1 transition-colors">Sözlüğe Git &rarr;</span>
          </div>
          <h3 class="mt-4 font-serif text-2xl font-bold text-metin-1 group-hover:text-lacivert transition-colors">
            Emlak Terimleri Sözlüğü
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-metin-2">
            Şufa, İfraz, Tevhid, İntifa, Gabari, KAKS, TAKS, Kat İrtifakı ve Aile Konutu Şerhi gibi tapuda ve sahada karşınıza çıkan tüm terimlerin yalın ve anlaşılır açıklamaları.
          </p>
        </a>
      </div>
    </div>
  </section>

  <section class="pb-20 lg:pb-28">
    <div class="kab">
      <div class="grid gap-5 lg:grid-cols-2" data-belir="sira">
        {
          BOLGELER.map((b) => (
            <a href={b.yol} class="bolge-kart grup-kart">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <h2 class="baslik-orta">{b.ad}</h2>
                  <p class="etiket mt-1.5">{b.il}</p>
                </div>
                <span class="bolge-adet font-veri">{b.adet}</span>
              </div>

              {b.giris && (
                <p class="mt-4 line-clamp-3 text-sm leading-relaxed text-metin-2">{b.giris}</p>
              )}

              <dl class="bolge-veri mt-5">
                <div>
                  <dt class="etiket">Konut</dt>
                  <dd class="font-veri">{b.konut}</dd>
                </div>
                <div>
                  <dt class="etiket">Arsa & tarla</dt>
                  <dd class="font-veri">{b.arsa}</dd>
                </div>
                {b.fiyatGruplari.slice(0, 3).map((grup) => <div class="bolge-fiyat">
                  <dt class="etiket">{grup.etiket}</dt>
                  <dd class="font-veri text-[0.8125rem]">{fiyatAraligi(grup)}</dd>
                </div>)}
                {b.ortancaBirimFiyat && (
                  <div>
                    <dt class="etiket">Satılık arazide ortanca ₺/m²</dt>
                    <dd class="font-veri">{b.ortancaBirimFiyat.toLocaleString('tr-TR')} ₺ <span class="block mt-1 text-xs text-kursun">{b.birimFiyatOrnekSayisi} taşınmaz</span></dd>
                  </div>
                )}
              </dl>

              <span class="bolge-git">
                Bölgeyi incele
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>

      <p class="mt-10 max-w-[62ch] text-sm leading-relaxed text-kursun">
        Not: Buradaki fiyatlar {KURUM.ad} portföyündeki güncel <strong>istek fiyatlarıdır</strong>;
        gerçekleşmiş satış fiyatı değildir. Taşınmazınıza özel bir piyasa değerlendirmesi
        için <a href="/degerleme" class="alt-cizgi text-metin-2">ücretsiz değerleme</a>
        talebinde bulunabilirsiniz.
      </p>
    </div>
  </section>
</Temel>

<style>
  .bolge-kart {
    display: block;
    background: #fff;
    border: 1px solid color-mix(in oklab, var(--color-murekkep) 10%, transparent);
    border-radius: var(--radius-kart);
    padding: clamp(1.4rem, 3vw, 2rem);
    transition: box-shadow 0.5s var(--ease-yumusak), transform 0.5s var(--ease-yumusak),
      border-color 0.5s var(--ease-yumusak);
  }
  .bolge-kart:hover {
    box-shadow: var(--shadow-kalkik);
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--color-murekkep) 16%, transparent);
  }

  .bolge-adet {
    font-family: var(--font-baslik);
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: color-mix(in oklab, var(--color-murekkep) 28%, transparent);
    font-variant-numeric: tabular-nums;
    transition: color 0.4s var(--ease-yumusak);
  }
  .bolge-kart:hover .bolge-adet {
    color: var(--color-kirmizi);
  }

  .bolge-veri {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(8rem, 45%), 1fr));
    gap: 1rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in oklab, var(--color-murekkep) 10%, transparent);
  }
  .bolge-veri dd {
    margin-top: 0.3rem;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }
  .bolge-veri .bolge-fiyat{grid-column:span 2}.bolge-veri .bolge-fiyat dd{font-size:.8125rem}

  .bolge-git {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-kirmizi);
  }
  .bolge-git svg {
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 0.4s var(--ease-yumusak);
  }
  .bolge-kart:hover .bolge-git svg {
    transform: translateX(3px);
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
