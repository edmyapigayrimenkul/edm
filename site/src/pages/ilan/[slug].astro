---
import Temel from '../../layouts/Temel.astro';
import Galeri from '../../components/Galeri.astro';
import Harita from '../../components/Harita.astro';
import IlanKart from '../../components/IlanKart.astro';
import FavoriDugme from '../../components/FavoriDugme.astro';
import PaylasDugme from '../../components/PaylasDugme.astro';
import { ilanBul, benzerIlanlar, aciklamaParcala, baglantiliIlanlar, m2Yaz } from '../../lib/ilanlar';
import { ilanSemasi, ilanSayfaYolu } from '../../lib/ilan-semasi';
import { KURUM, PORTALLAR } from '../../lib/site';
import { icerik, whatsappBaglanti } from '../../lib/icerik';
import { donanimGrupla, islemEtiketi, kunyeGrupla, tipEtiketi } from '../../lib/ilan-bilgileri';

const { slug } = Astro.params;
const ilan = slug ? await ilanBul(slug) : undefined;
if (!ilan) return Astro.rewrite('/404');
if (ilan.slug !== slug) return Astro.redirect(ilan.yol, 301);

const [benzer, paragraflar, baglantili, siteIcerigi] = await Promise.all([
  benzerIlanlar(ilan, 3),
  aciklamaParcala(ilan),
  baglantiliIlanlar(ilan),
  icerik(),
]);
const { ekip, iletisim } = siteIcerigi;
const danisman = ekip.find((d) =>
  (d.emlakjetSlug && d.emlakjetSlug === ilan.danismanSlug) || d.slug === ilan.danismanSlug
);

const tarihYaz = (ham: string | null | undefined): string | null => {
  if (!ham) return null;
  const tarih = new Date(ham);
  return Number.isNaN(tarih.getTime()) ? ham : tarih.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
};
const guvenliDisBaglanti = (ham: string | null | undefined): string | null => {
  if (!ham) return null;
  try { const url = new URL(ham); return ['http:', 'https:'].includes(url.protocol) ? url.href : null; } catch { return null; }
};

const islemAdi = islemEtiketi(ilan.islem);
const tipAdi = tipEtiketi(ilan.tipGrup, ilan.tip);
const satisMi = ilan.islem.endsWith('satilik');
const fiyatBasligi: Record<string, string> = {
  satilik: 'Satış fiyatı', kiralik: 'Aylık kira', 'gunluk-kiralik': 'Günlük fiyat',
  'sezonluk-kiralik': 'Sezon bedeli',
  'devren-satilik': 'Devir bedeli', 'devren-kiralik': 'Devir bedeli',
  'kat-karsiligi-satilik': 'Bedel türü',
};
const guncellemeTarihi = tarihYaz(ilan.guncellenme);
const yayinTarihi = tarihYaz(ilan.ilkGorulme);
const waMesaj = `Merhaba, “${ilan.baslikTemiz}” ilanı (No: ${ilan.id}) hakkında bilgi almak istiyorum.`;

const oz = ilan.ozellikler;
const brutAlanEtiketi = ilan.tipGrup === 'isyeri'
  ? 'Brüt kullanım alanı'
  : ilan.tipGrup === 'bina' || ilan.tipGrup === 'turistik'
    ? 'Toplam kapalı alan'
    : ilan.tipGrup === 'proje'
      ? 'Başlangıç brüt yapı alanı'
      : 'Brüt yapı alanı';
const netAlanEtiketi = ilan.tipGrup === 'isyeri' ? 'Net kullanım alanı' : 'Net yapı alanı';
const arsaAlanEtiketi = ilan.tipGrup === 'proje' ? 'Toplam arsa alanı' : 'Arsa alanı';
const acikAlanBilgileri = ilan.tipGrup === 'arsa'
  ? [
      ilan.alanlar.beyanEdilen != null && { etiket: 'Kaynak alanı · kapsamı teyit edilecek', deger: m2Yaz(ilan.alanlar.beyanEdilen)! },
      ilan.alanlar.toplamParsel != null && { etiket: 'Toplam parsel alanı', deger: m2Yaz(ilan.alanlar.toplamParsel)! },
      ilan.alanlar.satilanHisse != null && { etiket: 'Satılan hisse alanı', deger: m2Yaz(ilan.alanlar.satilanHisse)! },
    ]
  : [
      ilan.alanlar.brutYapi != null && { etiket: brutAlanEtiketi, deger: m2Yaz(ilan.alanlar.brutYapi)! },
      ilan.alanlar.netYapi != null && { etiket: netAlanEtiketi, deger: m2Yaz(ilan.alanlar.netYapi)! },
      ilan.alanlar.arsa != null && { etiket: arsaAlanEtiketi, deger: m2Yaz(ilan.alanlar.arsa)! },
    ];
const hizliBilgiler = [
  ...acikAlanBilgileri,
  ilan.oda && { etiket: 'Oda düzeni', deger: ilan.oda },
  oz['Krediye Uygunluk'] && { etiket: 'Krediye uygunluk', deger: oz['Krediye Uygunluk'] },
  oz['Isıtma Tipi'] && { etiket: 'Isıtma', deger: oz['Isıtma Tipi'] },
  oz['Bulunduğu Kat'] && { etiket: 'Bulunduğu kat', deger: oz['Bulunduğu Kat'] },
  oz['Bina Yaşı'] && { etiket: 'Bina yaşı', deger: oz['Bina Yaşı'] },
  oz['İmar Durumu'] && { etiket: 'İmar durumu', deger: oz['İmar Durumu'] },
  oz['Tapu Durumu'] && { etiket: 'Tapu durumu', deger: oz['Tapu Durumu'] },
  oz['Satış Durumu'] && { etiket: 'Satış durumu', deger: oz['Satış Durumu'] },
  oz['Teslim Durumu'] && { etiket: 'Teslim durumu', deger: oz['Teslim Durumu'] },
  oz['Proje Aşaması'] && { etiket: 'Proje aşaması', deger: oz['Proje Aşaması'] },
  oz['Oda Adedi'] && { etiket: 'Tesis oda sayısı', deger: oz['Oda Adedi'] },
  oz['Apart Sayısı'] && { etiket: 'Apart sayısı', deger: oz['Apart Sayısı'] },
  oz['Pompa Sayısı'] && { etiket: 'Pompa sayısı', deger: oz['Pompa Sayısı'] },
  oz['Kamp Ünitesi'] && { etiket: 'Kamp ünitesi', deger: oz['Kamp Ünitesi'] },
].filter(Boolean).slice(0, 6) as Array<{ etiket: string; deger: string }>;

const birimFiyatAciklamasi = ilan.birimFiyat && ilan.birimFiyatTemeli
  ? `${ilan.birimFiyat} · ${ilan.birimFiyatTemeli}`
  : ilan.birimFiyat;
const gruplanmisKunye = kunyeGrupla(ilan.tipGrup, oz, ilan.fiyatMetin, ilan.birimFiyat, ilan.birimFiyatTemeli, ilan.tip, ilan.islem);
const gruplanmisDonanim = donanimGrupla(ilan.donanim, ilan.tipGrup, ilan.islem, ilan.tip);

const videoUrl = guvenliDisBaglanti(oz['Video URL']);
const videoId = videoUrl?.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/)?.[1] ?? null;
const sanalTurUrl = guvenliDisBaglanti(oz['Sanal Tur URL']);

const imarDurumu = oz['İmar Bilgisi Durumu'];
const imarDurumlari: Record<string, { etiket: string; aciklama: string; ton: string }> = {
  dogrulandi: { etiket: 'Resmi kaynaktan doğrulandı', aciklama: 'Kaynak ve kontrol tarihi ilan dosyasında kayıtlıdır.', ton: 'olumlu' },
  beyan: { etiket: 'Yetkili beyanı', aciklama: 'Bilgi resmi belge kontrolü tamamlanmadan beyan olarak sunulmuştur.', ton: 'uyari' },
  arastiriliyor: { etiket: 'Araştırılıyor', aciklama: 'Resmi kaynak kontrolü devam ediyor; karar öncesinde güncel belge istenmelidir.', ton: 'bekliyor' },
  bilinmiyor: { etiket: 'Doğrulanmadı', aciklama: 'İmar bilgisi ilan dosyasında doğrulanmış değildir.', ton: 'belirsiz' },
};
const imarBilgisi = imarDurumlari[imarDurumu] ?? { etiket: 'Doğrulama bilgisi yok', aciklama: 'İmar bilgisi için danışmandan güncel resmi belge isteyin.', ton: 'belirsiz' };
const parselBilgileri = [
  oz['Ada'] && { etiket: 'Ada', deger: oz['Ada'] },
  oz['Parsel'] && { etiket: 'Parsel', deger: oz['Parsel'] },
  oz['Pafta'] && { etiket: 'Pafta', deger: oz['Pafta'] },
  oz['İmar Durumu'] && { etiket: 'İmar', deger: oz['İmar Durumu'] },
  oz['KAKS (Emsal)'] && { etiket: 'KAKS / emsal', deger: oz['KAKS (Emsal)'] },
  oz['TAKS'] && { etiket: 'TAKS', deger: oz['TAKS'] },
  oz['Gabari'] && { etiket: 'Gabari', deger: oz['Gabari'] },
].filter(Boolean) as Array<{ etiket: string; deger: string }>;

const sahibindenNo = oz['Sahibinden No'];
const hepsiemlakNo = oz['Hepsiemlak No'];
const emlakjetNo = oz['Emlakjet No'] || (ilan.kaynak === 'emlakjet' ? ilan.id : undefined);
const kaynakUrl = guvenliDisBaglanti(ilan.kaynakUrl);
const portalKayitlari = [
  sahibindenNo && { ad: PORTALLAR.sahibinden.ad, no: sahibindenNo, url: PORTALLAR.sahibinden.ofis, renk: '#e6bd00' },
  hepsiemlakNo && { ad: PORTALLAR.hepsiemlak.ad, no: hepsiemlakNo, url: PORTALLAR.hepsiemlak.ofis, renk: '#d60000' },
  emlakjetNo && { ad: PORTALLAR.emlakjet.ad, no: emlakjetNo, url: kaynakUrl ?? PORTALLAR.emlakjet.ofis, renk: '#5533ff' },
].filter(Boolean) as Array<{ ad: string; no: string; url: string; renk: string }>;

let bolumSirasi = 1;
const yeniBolumNo = () => String(bolumSirasi++).padStart(2, '0');
const aciklamaBolumNo = yeniBolumNo();
const medyaBolumNo = ilan.video || videoId || sanalTurUrl ? yeniBolumNo() : null;
const arsaBolumNo = ilan.tipGrup === 'arsa' ? yeniBolumNo() : null;
const kunyeBolumNo = gruplanmisKunye.length ? yeniBolumNo() : null;
const donanimBolumNo = gruplanmisDonanim.length ? yeniBolumNo() : null;
const konumBolumNo = yeniBolumNo();
const icerikBaglantilari = [
  { href: '#ilan-aciklamasi', etiket: 'Açıklama' },
  (ilan.video || videoId || sanalTurUrl) && { href: '#ilan-medya', etiket: 'Video ve tur' },
  ilan.tipGrup === 'arsa' && { href: '#ilan-imar', etiket: 'İmar ve parsel' },
  gruplanmisKunye.length > 0 && { href: '#ilan-kunye', etiket: 'Mülk bilgileri' },
  gruplanmisDonanim.length > 0 && { href: '#ilan-donanim', etiket: 'Olanaklar' },
  { href: '#ilan-konum', etiket: 'Konum' },
].filter(Boolean) as Array<{ href: string; etiket: string }>;

const jsonLd = ilanSemasi(ilan, Astro.site!);
const sayfaYolu = ilanSayfaYolu(ilan, Astro.site!);
const izYolu = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: sayfaYolu.map((adim, sira) => ({ '@type': 'ListItem', position: sira + 1, ...adim })),
};
---

<Temel baslik={ilan.baslikTemiz} aciklama={`${islemAdi} ${tipAdi} · ${ilan.konum} · ${ilan.fiyatMetin}. ${ilan.ozetMetin}`} gorsel={ilan.kapak ?? undefined} jsonLd={[jsonLd, izYolu]}>
  <div class="ilan-sayfasi">
    <div class="kab">
      <nav aria-label="Sayfa yolu" class="iz-yolu"><ol>
        {sayfaYolu.map((adim, sira) => <>
          {sira > 0 && <li aria-hidden="true">/</li>}
          <li>{sira === sayfaYolu.length - 1 ? <span aria-current="page">{adim.name}</span> : <a href={new URL(adim.item).pathname + new URL(adim.item).search}>{adim.name}</a>}</li>
        </>)}
      </ol></nav>

      <header class="ilan-baslik">
        <div class="ilan-baslik-ana">
          <div class="rozetler"><span class:list={['rozet', satisMi ? 'rozet--kirmizi' : 'rozet--murekkep']}>{islemAdi}</span><span class="rozet rozet--cizgili">{tipAdi}</span>{ilan.yeniMi && <span class="rozet rozet--cizgili">Yeni</span>}</div>
          <h1 class="baslik-buyuk">{ilan.baslikTemiz}</h1>
          <div class="baslik-alt"><span>{ilan.konum}</span><span aria-hidden="true">·</span><span class="font-veri">İlan no {ilan.id}</span>{(guncellemeTarihi || yayinTarihi) && <><span aria-hidden="true">·</span><span>{guncellemeTarihi ? `Güncelleme ${guncellemeTarihi}` : `Yayın ${yayinTarihi}`}</span></>}</div>
        </div>
        <div class="baslik-fiyat"><span>{fiyatBasligi[ilan.islem] ?? 'İlan fiyatı'}</span><strong>{ilan.fiyatMetin}</strong>{birimFiyatAciklamasi && <small>{birimFiyatAciklamasi}</small>}</div>
      </header>
    </div>

    <div class="kab galeri-alani">{ilan.gorseller.length ? <Galeri gorseller={ilan.gorseller} baslik={ilan.baslikTemiz} gecisAdi="ilan-foto" /> : <div class="gorsel-yok"><span>EDM</span><p>Bu portföyün fotoğrafları hazırlanıyor.</p></div>}</div>

    <div class="kab govde">
      <main class="ilan-icerik">
        {hizliBilgiler.length > 0 && <dl class="hizli-kunye" data-belir="sira">{hizliBilgiler.map((bilgi) => <div><dt>{bilgi.etiket}</dt><dd>{bilgi.deger}</dd></div>)}</dl>}

        {icerikBaglantilari.length > 1 && <nav class="ilan-ici-gezinme" aria-label="İlan bölümleri">
          <span>İLAN İÇERİĞİ</span>
          <div>{icerikBaglantilari.map((baglanti) => <a href={baglanti.href}>{baglanti.etiket}</a>)}</div>
        </nav>}

        {baglantili.length > 0 && <section class="baglantili-ilan" data-belir="yukari" aria-labelledby="baglantili-ilan-baslik">
          <div>
            <p>AYNI TAŞINMAZ</p>
            <h2 id="baglantili-ilan-baslik">Diğer işlem seçeneği</h2>
            <span>Bu portföy satış ve kiralama için ayrı ilan numaralarıyla sunuluyor.</span>
          </div>
          <div class="baglantili-secenekler">{baglantili.map((kayit) => <a href={kayit.yol}>
            <span class="baglantili-rozet">{islemEtiketi(kayit.islem)}</span>
            <strong>{kayit.fiyatMetin}</strong>
            <small>{kayit.baslikTemiz} · İlan no {kayit.id}</small>
            <b>İlanı incele <i aria-hidden="true">→</i></b>
          </a>)}</div>
        </section>}

        <section id="ilan-aciklamasi" class="icerik-bolumu aciklama-bolumu" data-belir="yukari">
          <div class="bolum-basligi"><span>{aciklamaBolumNo}</span><div><p>PORTFÖY NOTLARI</p><h2>İlan açıklaması</h2></div></div>
          <div class="aciklama">{paragraflar.map((paragraf) => <p>{paragraf}</p>)}</div>
        </section>

        {(ilan.video || videoId || sanalTurUrl) && <section id="ilan-medya" class="icerik-bolumu" data-belir="yukari">
          <div class="bolum-basligi"><span>{medyaBolumNo}</span><div><p>DİJİTAL GEZİ</p><h2>Video ve sanal tur</h2></div></div>
          {ilan.video ? <div class="video"><video controls preload="metadata" poster={ilan.video.poster}><source src={ilan.video.url} type={ilan.video.mime} />Tarayıcınız video oynatmayı desteklemiyor.</video></div> : videoId && <div class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${videoId}`} title={`${ilan.baslikTemiz} tanıtım videosu`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen /></div>}
          {sanalTurUrl && <a class="sanal-tur" href={sanalTurUrl} target="_blank" rel="noopener noreferrer"><span>Sanal turu yeni sekmede aç</span><b aria-hidden="true">↗</b></a>}
        </section>}

        {ilan.tipGrup === 'arsa' && <section id="ilan-imar" class="icerik-bolumu" data-belir="yukari">
          <div class="bolum-basligi"><span>{arsaBolumNo}</span><div><p>ARSA DOSYASI</p><h2>İmar ve parsel durumu</h2></div></div>
          <div class:list={['dogrulama-karti', `dogrulama-karti--${imarBilgisi.ton}`]}>
            <div class="dogrulama-durum"><i aria-hidden="true"></i><div><strong>{imarBilgisi.etiket}</strong><p>{imarBilgisi.aciklama}</p></div></div>
            {(oz['İmar Bilgisi Kaynağı'] || oz['İmar Belge Tarihi']) && <dl class="dogrulama-kaynak">
              {oz['İmar Bilgisi Kaynağı'] && <div><dt>Kaynak</dt><dd>{oz['İmar Bilgisi Kaynağı']}</dd></div>}
              {oz['İmar Belge Tarihi'] && <div><dt>Kontrol tarihi</dt><dd>{tarihYaz(oz['İmar Belge Tarihi'])}</dd></div>}
            </dl>}
          </div>
          {parselBilgileri.length > 0 && <dl class="parsel-izgara">{parselBilgileri.map((bilgi) => <div><dt>{bilgi.etiket}</dt><dd>{bilgi.deger}</dd></div>)}</dl>}
          <div class="resmi-kaynak"><p>Resmi kayıtlar zaman içinde değişebilir. Satın alma kararından önce güncel belgeyi ve parseli TKGM ile ilgili belediyeden kontrol edin.</p><a href="https://parselsorgu.tkgm.gov.tr/" target="_blank" rel="noopener noreferrer">TKGM Parsel Sorgu ↗</a></div>
        </section>}

        {gruplanmisKunye.length > 0 && <section id="ilan-kunye" class="icerik-bolumu" data-belir="yukari">
          <div class="bolum-basligi"><span>{kunyeBolumNo}</span><div><p>KATEGORİYE ÖZEL KÜNYE</p><h2>Mülk bilgileri</h2></div></div>
          <div class="kunye-gruplari" data-belir="sira">{gruplanmisKunye.map((grup, sira) => <details open={sira < 2}>
            <summary><span><strong>{grup.baslik}</strong>{grup.aciklama && <small>{grup.aciklama}</small>}</span><i aria-hidden="true"></i></summary>
            <dl>{grup.satirlar.map((satir) => <div><dt>{satir.etiket}</dt><dd class:list={[satir.vurgulu && 'vurgulu']}>{satir.deger}</dd></div>)}</dl>
          </details>)}</div>
        </section>}

        {gruplanmisDonanim.length > 0 && <section id="ilan-donanim" class="icerik-bolumu" data-belir="yukari">
          <div class="bolum-basligi"><span>{donanimBolumNo}</span><div><p>BEYAN EDİLEN NİTELİKLER</p><h2>Donanım ve olanaklar</h2></div></div>
          <p class="bolum-notu">Aşağıdaki nitelikler ilan dosyasındaki beyana dayanır; yerinde kontrol edilmesi önerilir.</p>
          <div class="donanim-gruplari" data-belir="sira">{gruplanmisDonanim.map((grup) => <div><h3>{grup.baslik}</h3><p>{grup.aciklama}</p><ul>{grup.ogeler.map((oge) => <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3.5 8.3 2.8 2.8 6.2-6.2" /></svg>{oge}</li>)}</ul></div>)}</div>
        </section>}

        <section id="ilan-konum" class="icerik-bolumu" data-belir="yukari">
          <div class="bolum-basligi"><span>{konumBolumNo}</span><div><p>YAKLAŞIK BÖLGE</p><h2>Konum</h2></div></div>
          <p class="konum-aciklama">{ilan.konum}. Mahremiyet ve güvenlik için harita yaklaşık bölgeyi gösterir; yerinde gösterim için randevu oluşturabilirsiniz.</p>
          {ilan.koordinat && <Harita enlem={ilan.koordinat.enlem} boylam={ilan.koordinat.boylam} etiket={[ilan.mahalle, ilan.ilce].filter(Boolean).join(', ')} yaricap={ilan.tipGrup === 'arsa' ? Math.max(1100, ilan.koordinatYaricapi) : ilan.koordinatYaricapi} />}
          <div class="konum-eylemleri"><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([ilan.mahalle, ilan.ilce, ilan.il].filter(Boolean).join(' '))}`} target="_blank" rel="noopener noreferrer" class="dugme dugme--hayalet">Bölgeyi haritada aç</a>{ilan.ilce && <a href={`/ilanlar?ilce=${encodeURIComponent(ilan.ilce)}`} class="dugme dugme--hayalet">{ilan.ilce} ilanları</a>}</div>
        </section>

        <section class="kaynak-bilgisi" data-belir="yukari" aria-label="İlan kaynağı ve güncelleme bilgisi">
          <strong>İlan bilgisi</strong><p>{ilan.kaynak === 'emlakjet' ? 'Bu portföy Emlakjet kaynağından alınmış, EDM tarafından düzenlenmiştir.' : 'Bu portföy EDM yönetim panelinde oluşturulmuştur.'} Fiyat ve müsaitlik için ilan numarasıyla güncel teyit alın.</p>
          {kaynakUrl && ilan.kaynak === 'emlakjet' && <a href={kaynakUrl} target="_blank" rel="noopener noreferrer">Kaynak kaydı aç ↗</a>}
        </section>
      </main>

      <aside class="yan-panel">
        <div class="iletisim-karti">
          <div class="yan-fiyat"><span>{fiyatBasligi[ilan.islem] ?? 'İlan fiyatı'}</span><strong>{ilan.fiyatMetin}</strong>{birimFiyatAciklamasi && <small>{birimFiyatAciklamasi}</small>}</div>
          <div class="cizgi"></div>
          {danisman ? <a href={`/danismanlar/${danisman.slug}`} class="danisman">
            {danisman.foto ? <img src={danisman.foto} alt="" loading="lazy" /> : <span>{danisman.ad.split(' ').map((parca) => parca[0]).join('')}</span>}
            <div><strong>{danisman.ad}</strong><small>{danisman.unvan}</small></div><b aria-hidden="true">→</b>
          </a> : <div class="danisman"><span>EDM</span><div><strong>EDM Portföy Ekibi</strong><small>Gayrimenkul danışmanlığı</small></div></div>}
          <p class="iletisim-notu">İlan no <b>{ilan.id}</b> ile fiyatı, müsaitliği ve randevu saatini teyit edin.</p>
          <div class="ana-eylemler"><a href={whatsappBaglanti(iletisim.whatsapp, waMesaj)} target="_blank" rel="noopener noreferrer" class="dugme dugme--kirmizi">WhatsApp’tan bilgi al</a><a href={`tel:${iletisim.sabitHam}`} class="dugme dugme--murekkep">Ofisi ara · {iletisim.sabit}</a><a href={`/iletisim?ilan=${encodeURIComponent(ilan.id)}`} class="dugme dugme--hayalet">Yerinde görme talebi</a></div>
          <div class="eylem-ikili"><FavoriDugme id={ilan.id} baslik={ilan.baslikTemiz} genis /><PaylasDugme baslik={ilan.baslikTemiz} metin={`${ilan.baslikTemiz} — ${ilan.fiyatMetin}`} /></div>
        </div>

        {portalKayitlari.length > 0 && <div class="portal-karti">
