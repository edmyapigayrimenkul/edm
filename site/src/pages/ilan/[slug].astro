---
import Temel from '../../layouts/Temel.astro';
import Galeri from '../../components/Galeri.astro';
import Harita from '../../components/Harita.astro';
import IlanKart from '../../components/IlanKart.astro';
import { ilanBul, benzerIlanlar, fiyatYaz, aciklamaParcala } from '../../lib/ilanlar';
import { PORTALLAR, KURUM } from '../../lib/site';
import { icerik, whatsappBaglanti } from '../../lib/icerik';
import FavoriDugme from '../../components/FavoriDugme.astro';
import PaylasDugme from '../../components/PaylasDugme.astro';
import { kunyeGrupla, donanimGrupla } from '../../lib/ilan-bilgileri';

const { slug } = Astro.params;
const ilan = slug ? await ilanBul(slug) : undefined;

// İlan portaldan düşmüşse ya da adres hatalıysa 404 sayfasına geç.
if (!ilan) return Astro.rewrite('/404');

// Başlık düzeldiğinde eski adres yaşamaya devam etmesin: kanonik adrese taşı.
if (ilan.slug !== slug) return Astro.redirect(ilan.yol, 301);

const benzer = await benzerIlanlar(ilan, 3);
const paragraflar = await aciklamaParcala(ilan);
const { ekip, iletisim } = await icerik();
const danisman = ekip.find(
  (d) =>
    (d.emlakjetSlug && d.emlakjetSlug === ilan.danismanSlug) ||
    d.slug === ilan.danismanSlug
);

const guncellemeTarihi = ilan.guncellenme
  ? new Date(ilan.guncellenme).toLocaleDateString('tr-TR', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null;

const waMesaj = `Merhaba, "${ilan.baslikTemiz}" ilanı (No: ${ilan.id}) hakkında bilgi almak istiyorum.`;

/** 3 Büyük Platform Referansları */
const sahibindenNo = ilan.ozellikler['Sahibinden No'];
const hepsiemlakNo = ilan.ozellikler['Hepsiemlak No'];
const emlakjetNo =
  ilan.ozellikler['Emlakjet No'] || (ilan.kaynak === 'emlakjet' ? ilan.id : undefined);

/** Video ve Sanal Tur */
const videoUrl = ilan.ozellikler['Video URL'];
const videoId = videoUrl
  ? videoUrl.match(
      /(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/
    )?.[1]
  : null;
const sanalTurUrl = ilan.ozellikler['Sanal Tur URL'];

/** Kadastro (Ada / Parsel / Pafta) */
const ada = ilan.ozellikler['Ada'];
const parsel = ilan.ozellikler['Parsel'];
const pafta = ilan.ozellikler['Pafta'];
const kadastroVar = Boolean(ada || parsel || pafta);

/** 3 Platform Standardında Gruplandırılmış Künye & Donanım */
const gruplanmisKunye = kunyeGrupla(
  ilan.tipGrup,
  ilan.ozellikler,
  ilan.fiyatMetin,
  ilan.birimFiyat
);
const gruplanmisDonanim = donanimGrupla(ilan.donanim);

/** Kart üstünde gösterilen ana ölçüler (Hızlı Künye Şeridi). */
const brutAlan = ilan.ozellikler['Brüt Metrekare'];
const netAlan = ilan.ozellikler['Net Metrekare'];
const alanDeger =
  brutAlan && netAlan
    ? `Brüt ${brutAlan} · Net ${netAlan}`
    : ilan.m2Metin ?? '—';

const kunye = [
  ilan.oda && { etiket: 'Oda', deger: ilan.oda },
  { etiket: ilan.tipGrup === 'arsa' ? 'Arsa Alanı' : 'Kullanım Alanı', deger: alanDeger },
  ilan.birimFiyat && { etiket: 'Birim Fiyat', deger: ilan.birimFiyat },
  ilan.ozellikler['Bulunduğu Kat'] && { etiket: 'Kat', deger: ilan.ozellikler['Bulunduğu Kat'] },
  ilan.ozellikler['İmar Durumu'] && { etiket: 'İmar', deger: ilan.ozellikler['İmar Durumu'] },
  ilan.ozellikler['Bina Yaşı'] && { etiket: 'Bina Yaşı', deger: ilan.ozellikler['Bina Yaşı'] },
].filter(Boolean) as Array<{ etiket: string; deger: string }>;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: ilan.baslikTemiz,
  description: ilan.aciklama.slice(0, 400),
  url: new URL(ilan.yol, Astro.site).href,
  image: ilan.gorseller.slice(0, 8),
  datePosted: ilan.ilkGorulme,
  ...(ilan.guncellenme ? { dateModified: ilan.guncellenme } : {}),
  ...(ilan.oda ? { numberOfRooms: ilan.oda } : {}),
  ...(ilan.m2 ? { floorSize: { '@type': 'QuantitativeValue', value: ilan.m2, unitCode: 'MTK' } } : {}),
  ...(ilan.koordinat
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: ilan.koordinat.enlem,
          longitude: ilan.koordinat.boylam,
        },
      }
    : {}),
  offers: {
    '@type': 'Offer',
    price: ilan.fiyat ?? undefined,
    priceCurrency: 'TRY',
    availability: 'https://schema.org/InStock',
    businessFunction:
      ilan.islem === 'satilik'
        ? 'http://purl.org/goodrelations/v1#Sell'
        : 'http://purl.org/goodrelations/v1#LeaseOut',
    seller: { '@id': `${KURUM.site}/#kurum` },
  },
  ...(ilan.ilce
    ? {
        address: {
          '@type': 'PostalAddress',
          addressLocality: ilan.ilce,
          addressRegion: ilan.il ?? undefined,
          addressCountry: 'TR',
        },
      }
    : {}),
};

const izYolu = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: KURUM.site },
    { '@type': 'ListItem', position: 2, name: 'İlanlar', item: `${KURUM.site}/ilanlar` },
    { '@type': 'ListItem', position: 3, name: ilan.baslikTemiz },
  ],
};
---

<Temel
  baslik={ilan.baslikTemiz}
  aciklama={`${ilan.kategori} · ${ilan.konum} · ${ilan.fiyatMetin}. ${ilan.ozetMetin}`}
  gorsel={ilan.kapak ?? undefined}
  jsonLd={[jsonLd, izYolu]}
>
  <div class="pt-24 lg:pt-28">
    <div class="kab">
      <!-- İz yolu -->
      <nav aria-label="Sayfa yolu" class="py-4">
        <ol class="flex flex-wrap items-center gap-2 text-[0.8125rem] text-kursun">
          <li><a href="/" class="hover:text-murekkep">Ana Sayfa</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/ilanlar" class="hover:text-murekkep">İlanlar</a></li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={`/ilanlar?ilce=${encodeURIComponent(ilan.ilce ?? '')}`} class="hover:text-murekkep">
              {ilan.ilce}
            </a>
          </li>
        </ol>
      </nav>

      <!-- Başlık -->
      <header class="pb-6">
        <div class="flex flex-wrap items-center gap-2">
          <span class:list={['rozet', ilan.islem === 'satilik' ? 'rozet--kirmizi' : 'rozet--murekkep']}>
            {ilan.islem === 'satilik' ? 'Satılık' : 'Kiralık'}
          </span>
          <span class="rozet rozet--cizgili">{ilan.kategori}</span>
          {ilan.yeniMi && <span class="rozet rozet--cizgili">Yeni eklendi</span>}
        </div>

        <h1 class="baslik-buyuk mt-5 max-w-[22ch]">{ilan.baslikTemiz}</h1>
        <p class="mt-3 text-metin-2">{ilan.konum}</p>

        <p class="baslik-fiyat font-veri mt-6">
          {fiyatYaz(ilan.fiyat)}
          {ilan.islem === 'kiralik' && <span class="baslik-fiyat-ek">/ay</span>}
        </p>
      </header>
    </div>

    <!-- Galeri -->
    <div class="kab">
      <Galeri gorseller={ilan.gorseller} baslik={ilan.baslikTemiz} gecisAdi="ilan-foto" />
    </div>

    <!-- Gövde -->
    <div class="kab">
      <div class="grid gap-10 py-12 lg:grid-cols-[1fr_22rem] lg:gap-14 lg:py-16">
        <!-- Sol: içerik -->
        <div class="min-w-0">
          <!-- Künye şeridi -->
          <dl class="kunye-serit">
            {
              kunye.map((k) => (
                <div>
                  <dt class="etiket">{k.etiket}</dt>
                  <dd class="kunye-deger">{k.deger}</dd>
                </div>
              ))
            }
          </dl>

          <!-- Açıklama -->
          <section class="mt-12">
            <h2 class="baslik-orta">İlan açıklaması</h2>
            <div class="aciklama mt-5">
              {paragraflar.map((p) => <p>{p}</p>)}
            </div>
          </section>

          <!-- Tanıtım Videosu -->
          {
            videoId && (
              <section class="mt-14 sinematik-video-bolumu">
                <div class="video-kart-cerceve">
                  <div class="video-kart-baslik">
                    <div class="flex items-center gap-2.5">
                      <span class="video-play-ikon">▶</span>
                      <span class="font-bold text-sm text-white">Özel Portföy Tanıtım Videosu</span>
                    </div>
                    <span class="text-xs text-white/60 font-veri">1080p HD</span>
                  </div>
                  <div class="video-sarici">
                    <iframe
                      src={`https://www.youtube-nocookie.com/embed/${videoId}`}
                      title={`${ilan.baslikTemiz} Videosu`}
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                      class="video-iframe"
                    />
                  </div>
                </div>
              </section>
            )
          }

          <!-- Tapu & Kadastro Vurgusu (Arsa / Müstakil) -->
          {
            kadastroVar && (
              <section class="kadastro-sertifika-kart mt-12">
                <div class="kadastro-sertifika-ust">
                  <div class="flex items-center gap-3">
                    <span class="kadastro-muhur">TKGM</span>
                    <div>
                      <h3 class="kadastro-resmi-baslik">Resmi Tapu & Kadastro Parsel Referansı</h3>
                      <p class="text-xs text-metin-2 mt-0.5">{[ilan.mahalle, ilan.ilce, ilan.il].filter(Boolean).join(' · ')}</p>
                    </div>
                  </div>
                  <a
                    href="https://parselsorgu.tkgm.gov.tr/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="kadastro-dogrula-btn"
                  >
                    <span>TKGM Parsel Sorgu</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>

                <div class="kadastro-grid-metrik mt-4">
                  {ada && (
                    <div class="kadastro-kare">
                      <span class="kadastro-kare-etiket">ADA NO</span>
                      <span class="kadastro-kare-deger font-veri">{ada}</span>
                    </div>
                  )}
                  {parsel && (
                    <div class="kadastro-kare">
                      <span class="kadastro-kare-etiket">PARSEL NO</span>
                      <span class="kadastro-kare-deger font-veri">{parsel}</span>
                    </div>
                  )}
                  {pafta && (
                    <div class="kadastro-kare">
                      <span class="kadastro-kare-etiket">PAFTA NO</span>
                      <span class="kadastro-kare-deger font-veri">{pafta}</span>
                    </div>
                  )}
                  {ilan.m2 && (
                    <div class="kadastro-kare">
                      <span class="kadastro-kare-etiket">TOPLAM ALAN</span>
                      <span class="kadastro-kare-deger font-veri">{ilan.m2.toLocaleString('tr-TR')} m²</span>
                    </div>
                  )}
                  {oz.imar_durumu && (
                    <div class="kadastro-kare">
                      <span class="kadastro-kare-etiket">İMAR DURUMU</span>
                      <span class="kadastro-kare-deger font-veri text-sm font-semibold">{oz.imar_durumu}</span>
                    </div>
                  )}
                  {oz.kaks && (
                    <div class="kadastro-kare">
                      <span class="kadastro-kare-etiket">KAKS / EMSAL</span>
                      <span class="kadastro-kare-deger font-veri">{oz.kaks}</span>
                    </div>
                  )}
                </div>
              </section>
            )
          }

          <!-- Özellikler (3 Platform Standartlarında Gruplanmış) -->
          {
            gruplanmisKunye.length > 0 && (
              <section class="mt-14">
                <div class="flex items-center justify-between pb-3 border-b border-murekkep/10">
                  <h2 class="baslik-orta">Mülk Özellikleri & Künye</h2>
                  <span class="text-xs text-kursun font-veri uppercase tracking-wider">3 Platform Uyumlu</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                  {gruplanmisKunye.map((grup) => (
                    <div class="kunye-editoryal-kart">
                      <div class="kunye-kart-baslik-alani">
                        <span class="kunye-nokta"></span>
                        <h3 class="kunye-kart-baslik">{grup.baslik}</h3>
                      </div>
                      <dl class="kunye-satirlar mt-3">
                        {grup.satirlar.map((s) => (
                          <div class="kunye-satir-oge">
                            <dt class="kunye-oge-etiket">{s.etiket}</dt>
                            <dd class:list={['kunye-oge-deger font-veri', s.vurgulu && 'vurgulu']}>
                              {s.deger}
                            </dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  ))}
                </div>
              </section>
            )
          }

          <!-- Donanım (Kategorize Edilmiş Çipler) -->
          {
            gruplanmisDonanim.length > 0 && (
              <section class="mt-14">
                <div class="flex items-center justify-between pb-3 border-b border-murekkep/10">
                  <h2 class="baslik-orta">Öne Çıkan Donanım & Nitelikler</h2>
                  <span class="text-xs text-kursun font-veri uppercase tracking-wider">Onaylı Özellikler</span>
                </div>

                <div class="space-y-6 mt-6">
                  {gruplanmisDonanim.map((grup) => (
                    <div class="donanim-luks-kart">
                      <h3 class="donanim-luks-baslik">{grup.baslik}</h3>
                      <div class="donanim-rozet-izgara mt-3">
                        {grup.ogeler.map((d) => (
                          <div class="donanim-rozet-oge">
                            <span class="donanim-rozet-tik">✓</span>
                            <span>{d}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            )
          }

          <!-- Konum -->
          <section class="mt-12">
            <h2 class="baslik-orta">Konum</h2>
            <p class="mt-4 text-metin-2">
              {ilan.konum}. Tam adres ve parsel bilgisi için bizimle iletişime geçin —
              yerinde göstermeyi tercih ediyoruz.
            </p>

            {
              ilan.koordinat && (
                <Harita
                  enlem={ilan.koordinat.enlem}
                  boylam={ilan.koordinat.boylam}
                  etiket={[ilan.mahalle, ilan.ilce].filter(Boolean).join(', ')}
                  yaricap={ilan.tipGrup === 'arsa' ? 1100 : 700}
                />
              )
            }

            <div class="mt-5 flex flex-wrap gap-3">
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
                  [ilan.mahalle, ilan.ilce, ilan.il].filter(Boolean).join(' ')
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                class="dugme dugme--hayalet"
              >
                Haritada bölgeyi gör
              </a>
              <a
                href={`/ilanlar?ilce=${encodeURIComponent(ilan.ilce ?? '')}`}
                class="dugme dugme--hayalet"
              >
                {ilan.ilce}’deki diğer ilanlar
              </a>
            </div>
          </section>

          <!-- Kaynak / şeffaflık -->
          <section class="mt-12 border-t border-murekkep/10 pt-6">
            <p class="text-[0.8125rem] leading-relaxed text-kursun">
              {guncellemeTarihi && <>Bu ilan {guncellemeTarihi} tarihinde güncellendi. </>}
              Aynı ilan
              <a href={ilan.kaynakUrl} target="_blank" rel="noopener noreferrer" class="alt-cizgi text-metin-2">
                {PORTALLAR.emlakjet.ad}
              </a>
              ve diğer portallarda da yayında. Fiyat ve durum bilgileri portföyümüzden
              otomatik olarak güncellenir.
            </p>
          </section>
        </div>

        <!-- Sağ: yapışkan iletişim -->
        <aside class="lg:sticky lg:top-28 lg:self-start">
          <div class="iletisim-kart">
            <p class="etiket">{ilan.islem === 'satilik' ? 'Satış fiyatı' : 'Aylık kira'}</p>
            <p class="fiyat-buyuk">{fiyatYaz(ilan.fiyat)}</p>
            {
              ilan.islem === 'kiralik' && (
                <p class="mt-1 text-sm text-metin-2">aylık</p>
              )
            }
            {
              ilan.birimFiyat && (
                <p class="mt-2 font-veri text-[0.8125rem] text-kursun">{ilan.birimFiyat}</p>
              )
            }

            <div class="cizgi my-5"></div>

            {
              danisman && (
                <a href={`/danismanlar/${danisman.slug}`} class="danisman-satir">
                  <span class="danisman-rozet" aria-hidden="true">
                    {danisman.ad
                      .split(' ')
                      .map((p) => p[0])
                      .join('')}
                  </span>
                  <span class="min-w-0">
                    <span class="block truncate font-medium">{danisman.ad}</span>
                    <span class="block truncate text-[0.8125rem] text-metin-2">
                      {danisman.unvan}
                    </span>
                  </span>
                </a>
              )
            }

            <div class="mt-5 flex flex-col gap-2.5">
              <a
                href={whatsappBaglanti(iletisim.whatsapp, waMesaj)}
                target="_blank"
                rel="noopener noreferrer"
                class="dugme dugme--kirmizi w-full"
              >
                WhatsApp’tan sor
              </a>
              <a href={`tel:${iletisim.telefonHam}`} class="dugme dugme--murekkep w-full">
                {iletisim.telefon}
              </a>
              <a href="/iletisim" class="dugme dugme--hayalet w-full">Yerinde görmek istiyorum</a>

              <div class="flex gap-2.5">
                <FavoriDugme id={ilan.id} baslik={ilan.baslikTemiz} genis />
                <PaylasDugme
                  baslik={ilan.baslikTemiz}
                  metin={`${ilan.baslikTemiz} — ${ilan.fiyatMetin}`}
                />
              </div>
            </div>

            <p class="mt-4 text-center text-[0.75rem] text-kursun">
              İlan no <span class="font-veri">{ilan.id}</span>
            </p>
          </div>

          <div class="portal-kutu">
            <div class="flex items-center justify-between">
              <p class="etiket">Büyük Portallarda İnceleyin</p>
              <span class="text-[0.6875rem] text-kursun font-veri">Resmi İlanlar</span>
            </div>
            <div class="mt-3 flex flex-col gap-2.5">
              <a
                href={
                  sahibindenNo
                    ? `https://www.sahibinden.com/ilan/${sahibindenNo}/detay`
                    : PORTALLAR.sahibinden.ofis
                }
                target="_blank"
                rel="noopener noreferrer"
                class="portal-luks-kart portal-luks--sahibinden"
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="portal-mini-rozet bg-[#FFD200] text-black">S</span>
                  <div class="min-w-0">
                    <span class="portal-kart-ad">{PORTALLAR.sahibinden.ad}</span>
                    <span class="block truncate text-[0.6875rem] text-kursun">
                      {sahibindenNo ? `İlan No: ${sahibindenNo}` : 'Doğrulanmış Ofis Portföyü'}
                    </span>
                  </div>
                </div>
                <span class="portal-kart-ok font-veri">↗</span>
              </a>

              <a
                href={
                  hepsiemlakNo
                    ? `https://www.hepsiemlak.com/${hepsiemlakNo}`
                    : PORTALLAR.hepsiemlak.ofis
                }
                target="_blank"
                rel="noopener noreferrer"
                class="portal-luks-kart portal-luks--hepsiemlak"
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="portal-mini-rozet bg-[#E60000] text-white">H</span>
                  <div class="min-w-0">
                    <span class="portal-kart-ad">{PORTALLAR.hepsiemlak.ad}</span>
                    <span class="block truncate text-[0.6875rem] text-kursun">
                      {hepsiemlakNo ? `İlan No: ${hepsiemlakNo}` : 'Doğrulanmış Ofis Portföyü'}
                    </span>
                  </div>
                </div>
                <span class="portal-kart-ok font-veri">↗</span>
              </a>

              <a
                href={
                  emlakjetNo
                    ? `https://www.emlakjet.com/ilan/${emlakjetNo}`
                    : ilan.kaynakUrl || PORTALLAR.emlakjet.ofis
                }
                target="_blank"
                rel="noopener noreferrer"
                class="portal-luks-kart portal-luks--emlakjet"
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="portal-mini-rozet bg-[#5533FF] text-white">E</span>
                  <div class="min-w-0">
                    <span class="portal-kart-ad">{PORTALLAR.emlakjet.ad}</span>
                    <span class="block truncate text-[0.6875rem] text-kursun">
                      {emlakjetNo ? `İlan No: ${emlakjetNo}` : ilan.id ? `İlan No: ${ilan.id}` : 'Doğrulanmış Ofis Portföyü'}
                    </span>
                  </div>
                </div>
                <span class="portal-kart-ok font-veri">↗</span>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <!-- Benzer ilanlar -->
    {
      benzer.length > 0 && (
        <section class="border-t border-murekkep/10 py-16 lg:py-20">
          <div class="kab">
            <div class="flex flex-wrap items-end justify-between gap-6">
              <h2 class="baslik-orta">Bunlar da ilginizi çekebilir</h2>
              <a href="/ilanlar" class="dugme dugme--hayalet">Tüm ilanlar</a>
            </div>
            <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-belir="sira">
              {benzer.map((b) => (
                <IlanKart ilan={b} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>

  <!-- Mobilde ekranın altına sabitlenen eylem çubuğu.
       Telefonda sağdaki yapışkan kart her şeyin altına iniyor; fiyatı
       görmek için 4 ekran inen kişi aramak için de oraya inmesin. -->
  <div class="ilan-cubuk" data-ilan-cubuk>
    <div class="min-w-0">
      <p class="etiket etiket--acik">
        {ilan.islem === 'satilik' ? 'Satış fiyatı' : 'Aylık kira'}
      </p>
      <p class="cubuk-fiyat font-veri">{fiyatYaz(ilan.fiyat)}</p>
    </div>
    <div class="flex flex-none gap-2">
      <a href={`tel:${iletisim.telefonHam}`} class="cubuk-dugme">Ara</a>
      <a
        href={whatsappBaglanti(iletisim.whatsapp, waMesaj)}
        target="_blank"
        rel="noopener noreferrer"
        class="cubuk-dugme cubuk-dugme--kirmizi"
      >
        WhatsApp
      </a>
    </div>
  </div>

  <script is:inline define:vars={{ ilanId: ilan.id }}>
    // Görüntülenme sinyali — sayfa okunmaya başladıktan 3 saniye sonra,
    // böylece yanlışlıkla açılıp hemen kapatılanlar sayılmıyor.
    setTimeout(() => {
      navigator.sendBeacon?.(
        '/api/goruntulenme',
        new Blob([JSON.stringify({ id: ilanId })], { type: 'application/json' })
      );
    }, 3000);
  </script>
