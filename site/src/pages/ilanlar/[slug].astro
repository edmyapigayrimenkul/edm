---
import Temel from '../../layouts/Temel.astro';
import IlanKart from '../../components/IlanKart.astro';
import { ARAMA_SAYFALARI, aramaSayfasiBul, aramaSayfasiIlanlari } from '../../lib/arama-sayfalari';
import { portfoy } from '../../lib/ilanlar';
import { KURUM } from '../../lib/site';

const sayfa = aramaSayfasiBul(Astro.params.slug);
if (!sayfa) return Astro.rewrite('/404');
const { ilanlar } = await portfoy();
const seciliIlanlar = aramaSayfasiIlanlari(sayfa, ilanlar);
const yol = `/ilanlar/${sayfa.slug}`;
const adres = `${KURUM.site}${yol}`;
const filtreler = new URLSearchParams({ il: 'İstanbul', ilce: 'Silivri', islem: 'satilik', tip: sayfa.grup });
if (sayfa.grup === 'konut') filtreler.set('tur', 'daire');
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  '@id': `${adres}#sayfa`, url: adres, name: sayfa.baslik, description: sayfa.aciklama,
  mainEntity: {
    '@type': 'ItemList', numberOfItems: seciliIlanlar.length,
    itemListElement: seciliIlanlar.map((ilan, sira) => ({
      '@type': 'ListItem', position: sira + 1, name: ilan.baslikTemiz, url: `${KURUM.site}${ilan.yol}`,
    })),
  },
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: KURUM.site },
    { '@type': 'ListItem', position: 2, name: 'İlanlar', item: `${KURUM.site}/ilanlar` },
    { '@type': 'ListItem', position: 3, name: sayfa.baslik, item: adres },
  ],
}];
---

<Temel baslik={sayfa.baslik} aciklama={sayfa.aciklama} jsonLd={jsonLd}>
  <section class="pt-28 pb-12 lg:pt-36 lg:pb-16">
    <div class="kab">
      <nav aria-label="Sayfa yolu" class="text-sm text-kursun">
        <ol class="flex flex-wrap gap-2">
          <li><a href="/">Ana Sayfa</a></li><li aria-hidden="true">/</li>
          <li><a href="/ilanlar">İlanlar</a></li><li aria-hidden="true">/</li>
          <li aria-current="page">{sayfa.baslik}</li>
        </ol>
      </nav>
      <p class="etiket mt-8">İstanbul · Silivri</p>
      <h1 class="baslik-buyuk mt-4 max-w-[20ch]">{sayfa.baslik}</h1>
      <p class="mt-6 max-w-[68ch] text-lg leading-relaxed text-metin-2">{sayfa.giris}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#secili-ilanlar" class="dugme dugme--murekkep">İlanları inceleyin <span class="font-veri">{seciliIlanlar.length}</span></a>
        <a href="/rehber/istanbul-silivri" class="dugme dugme--hayalet">Silivri bölge rehberi</a>
      </div>
    </div>
  </section>
  <section aria-labelledby="olcut-baslik" class="border-y border-murekkep/10 py-12 lg:py-16">
    <div class="kab">
      <p class="etiket">Karşılaştırma notları</p>
      <h2 id="olcut-baslik" class="baslik-orta mt-3">Seçenekleri birlikte değerlendirin</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {sayfa.olcutler.map((olcut, sira) => <article class="arama-olcut">
          <span class="font-veri text-sm text-kursun">0{sira + 1}</span>
          <h3 class="mt-4 text-xl font-baslik">{olcut.baslik}</h3>
          <p class="mt-3 text-sm leading-relaxed text-metin-2">{olcut.metin}</p>
        </article>)}
      </div>
    </div>
  </section>
  <section id="secili-ilanlar" aria-labelledby="ilan-baslik" class="arama-hedef py-12 lg:py-16">
    <div class="kab">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div><p class="etiket">Güncel EDM portföyü</p><h2 id="ilan-baslik" class="baslik-orta mt-3">{sayfa.kisaBaslik} <span class="font-veri text-lg text-kursun">{seciliIlanlar.length}</span></h2></div>
        <a href={`/ilanlar?${filtreler}`} class="dugme dugme--hayalet">Aramayı ayrıntılandırın</a>
      </div>
      <p class="mt-4 max-w-[70ch] text-sm leading-relaxed text-kursun">Liste yalnız EDM’nin güncel portföyüdür. Silivri’deki bütün ilanları kapsamaz; ilan fiyatları gerçekleşmiş satış fiyatları değildir.</p>
      {seciliIlanlar.length > 0 ? <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {seciliIlanlar.map((ilan, sira) => <IlanKart ilan={ilan} oncelikli={sira < 4} />)}
      </div> : <div class="arama-bos mt-8">
        <h3 class="text-xl font-baslik">Şu anda bu aramaya uyan aktif ilanımız yok</h3>
        <p class="mt-3 text-metin-2">Konum, ihtiyaç ve bütçenizi danışmanlarımızla paylaşabilirsiniz.</p>
        <a href="/iletisim" class="dugme dugme--hayalet mt-5">Danışmanla iletişime geçin</a>
      </div>}
    </div>
  </section>
  <section aria-labelledby="sorular-baslik" class="border-t border-murekkep/10 py-12 lg:py-16">
    <div class="kab max-w-4xl">
      <h2 id="sorular-baslik" class="baslik-orta">Aramanız için kısa yanıtlar</h2>
      <div class="mt-8">
        {sayfa.sorular.map((oge) => <details class="arama-soru">
          <summary>{oge.soru}</summary><p class="mt-4 max-w-[70ch] text-sm leading-relaxed text-metin-2">{oge.yanit}</p>
        </details>)}
      </div>
      <nav aria-label="Diğer Silivri aramaları" class="mt-8 flex flex-wrap gap-3">
        {ARAMA_SAYFALARI.filter((diger) => diger.slug !== sayfa.slug).map((diger) => <a href={`/ilanlar/${diger.slug}`} class="dugme dugme--hayalet">{diger.baslik}</a>)}
        <a href="/ilanlar" class="dugme dugme--hayalet">Tüm ilanlar</a>
      </nav>
    </div>
  </section>
</Temel>
<style>
  .arama-olcut, .arama-bos { padding: 1.5rem; border: 1px solid var(--color-murekkep-10, #1213161a); border-radius: 1rem; background: var(--color-kagit-2); }
  .arama-soru { padding: 1.25rem 0; border-bottom: 1px solid #1213161a; }
  .arama-soru summary { cursor: pointer; font-weight: 600; line-height: 1.6; }
  .arama-hedef { scroll-margin-top: 7rem; }
</style>
