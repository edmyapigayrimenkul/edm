---
import Temel from '../../layouts/Temel.astro';
import { SOZLUK_TERIMLERI } from '../../lib/sozluk';

const harfler = Array.from(new Set(SOZLUK_TERIMLERI.map((t) => t.harf))).sort((a, b) => a.localeCompare('tr'));
const kategoriler = ['Tümü', 'Tapu & Mülkiyet', 'İmar & Kadastro', 'Kira & Tahliye', 'Vergi & Harç'];
---

<Temel
  baslik="Emlak Terimleri Sözlüğü"
  aciklama="Gayrimenkul, tapu, imar, vergi ve kira hukukundaki en kritik terimler için kanuni dayanaklı, saha gerçeklerini içeren açıklamalar."
>
  <!-- KOMPAKT KAHRAMAN BÖLÜMÜ -->
  <section class="pt-20 pb-4 lg:pt-24 lg:pb-6">
    <div class="kab">
      <!-- Başlık Satırı -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-murekkep/10 pb-5" data-belir>
        <div>
          <div class="inline-flex items-center gap-1.5 text-[11px] font-mono font-bold tracking-widest text-kirmizi uppercase mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-kirmizi animate-pulse"></span>
            EDM AKADEMİ · MEVZUAT VE SAHA SÖZLÜĞÜ
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-black text-murekkep tracking-tight">
            Emlak Terimleri Sözlüğü
          </h1>
          <p class="mt-1.5 text-xs sm:text-sm text-metin-2 max-w-xl leading-relaxed">
            Detayını ve saha gerçeğini öğrenmek istediğiniz <strong>kelimeye tıklayarak bilgi kartını büyütebilirsiniz</strong>.
          </p>
        </div>

        <div class="flex items-center gap-2 font-mono text-xs text-kursun shrink-0">
          <span class="px-2.5 py-1 rounded bg-murekkep text-white font-bold">{SOZLUK_TERIMLERI.length} Terim</span>
          <button
            type="button"
            id="tumunu-ac-kapat"
            class="px-2.5 py-1 rounded bg-kagit-2 text-murekkep font-semibold hover:bg-murekkep hover:text-white transition-colors border border-murekkep/10 cursor-pointer"
          >
            Tümünü Büyüt
          </button>
        </div>
      </div>

      <!-- KOMPAKT ARAMA VE FİLTRE KONTROL PANELİ -->
      <div class="mt-4 rounded-xl border border-murekkep/10 bg-white p-3 sm:p-4 shadow-sm space-y-3" data-belir data-gecikme="0.05">
        <!-- Arama Alanı -->
        <div class="relative">
          <input
            type="text"
            id="terim-arama"
            placeholder="Terim ara (şufa, ifraz, kat mülkiyeti, emsal, tahliye...)"
            class="w-full rounded-lg border border-murekkep/15 bg-kagit px-3.5 py-2 pl-10 text-xs sm:text-sm text-murekkep placeholder:text-kursun focus:border-kirmizi focus:bg-white focus:outline-none transition-all"
          />
          <svg class="absolute left-3 top-2.5 h-4 w-4 text-kursun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="7" cy="7" r="5" />
            <path d="m11 11 3.5 3.5" />
          </svg>
          <button
            type="button"
            id="arama-temizle"
            class="hidden absolute right-2.5 top-2 text-[11px] font-mono text-kursun hover:text-kirmizi transition-colors px-1.5 py-0.5 rounded bg-kagit-2 cursor-pointer"
          >
            ✕
          </button>
        </div>

        <!-- Filtre ve Alfabe Satırı -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2 border-t border-murekkep/8 text-xs font-mono">
          <!-- Kategori Butonları -->
          <div class="flex flex-wrap items-center gap-1.5">
            {kategoriler.map((kat, index) => (
              <button
                type="button"
                class={`kategori-buton px-2.5 py-1 rounded-full text-[11px] cursor-pointer transition-all ${
                  index === 0
                    ? 'bg-murekkep text-white font-bold shadow-sm'
                    : 'bg-kagit text-metin-2 hover:bg-murekkep/10 hover:text-murekkep'
                }`}
                data-kategori-deger={kat === 'Tümü' ? 'hepsi' : kat}
              >
                {kat}
              </button>
            ))}
          </div>

          <!-- Alfabe Hızlı Gezinme -->
          <div class="flex flex-wrap items-center gap-1">
            {harfler.map((h) => (
              <a
                href={`#harf-${h}`}
                class="harf-baglanti inline-flex h-6 w-6 items-center justify-center rounded bg-kagit text-[11px] font-bold text-murekkep hover:bg-kirmizi hover:text-white transition-colors"
                data-harf-hedef={h}
              >
                {h}
              </a>
            ))}
          </div>
        </div>

        <!-- Canlı Durum -->
        <div class="pt-1 text-[11px] font-mono text-kursun flex items-center justify-between">
          <span id="arama-sayac">{SOZLUK_TERIMLERI.length} terim listeleniyor</span>
          <span class="text-kursun/70 hidden sm:inline">EDM Yapı & Gayrimenkul Hukuk & Saha Arşivi</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TERİMLER ALANI: TIKLANDIĞINDA BÜYÜYEN BİLGİ KARTLARI (EDM POST TASARIMI) -->
  <section class="pb-16 lg:pb-24">
    <div class="kab">
      <!-- Boş Durum -->
      <div id="bos-durum" class="hidden text-center py-12 px-4 rounded-xl bg-white border border-murekkep/10 shadow-sm max-w-md mx-auto my-6">
        <h3 class="font-serif text-lg font-bold text-murekkep">Terim Bulunamadı</h3>
        <p class="text-xs text-metin-2 mt-1">Farklı bir kelime arayabilir veya filtreleri sıfırlayabilirsiniz.</p>
        <button
          type="button"
          id="filtreleri-sifirla"
          class="mt-3 px-3 py-1.5 rounded bg-murekkep text-white text-xs font-mono font-semibold hover:bg-kirmizi transition-colors cursor-pointer"
        >
          Filtreleri Sıfırla
        </button>
      </div>

      <div class="space-y-8" id="terimler-alani">
        {harfler.map((harf) => {
          const buHarftekiTerimler = SOZLUK_TERIMLERI.filter((t) => t.harf === harf);
          return (
            <div id={`harf-${harf}`} class="harf-bolumu scroll-mt-24" data-harf-bolumu={harf}>
              <!-- Harf Ayırıcı Başlık -->
              <div class="flex items-center justify-between border-b border-murekkep/15 pb-1.5 mb-3">
                <div class="flex items-baseline gap-2">
                  <span class="font-serif text-2xl font-black text-murekkep">{harf}</span>
                  <span class="text-[10px] font-mono text-kursun uppercase tracking-wider">
                    {buHarftekiTerimler.length} Terim
                  </span>
                </div>
                <a
                  href="#terim-arama"
                  class="text-[10px] font-mono text-kursun hover:text-kirmizi transition-colors"
                >
                  ↑ Yukarı
                </a>
              </div>

              <!-- Kompakt Kelime Izgarası (Tıklanınca Büyür) -->
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 items-start">
                {buHarftekiTerimler.map((t) => (
                  <div
                    class="terim-kapsayici group transition-all duration-200"
                    data-terim-adi={t.terim.toLowerCase()}
                    data-terim-metin={`${t.terim} ${t.kisaTanim} ${t.pratikteNeAnlamaGelir} ${t.hukukiKarsilik} ${t.kategori} ${t.harf}`.toLowerCase()}
                    data-terim-kategori={t.kategori}
                    data-terim-harf={t.harf}
                    data-terim-slug={t.slug}
                    data-durum="kapali"
                  >
                    <!-- 1. TIKLANMADIĞINDA: KÜÇÜK SADECE KELİME YAZAN HALİ -->
                    <button
                      type="button"
                      class="terim-kapali w-full text-left flex items-center justify-between gap-3 p-3 bg-white rounded-xl border border-murekkep/12 hover:border-kirmizi hover:shadow-sm transition-all duration-150 cursor-pointer"
                      aria-expanded="false"
                      title="Detaylı bilgi kartını açmak için tıklayın"
                    >
                      <div class="flex items-center gap-2.5 min-w-0">
                        <span class="w-2 h-2 rounded-full bg-kursun/40 group-hover:bg-kirmizi transition-colors shrink-0"></span>
                        <span class="font-serif text-sm sm:text-base font-bold text-murekkep group-hover:text-kirmizi transition-colors truncate">
                          {t.terim}
                        </span>
                      </div>
                      <div class="flex items-center gap-2 shrink-0">
                        <span class="text-[10px] font-mono text-kursun bg-kagit px-2 py-0.5 rounded border border-murekkep/8">
                          {t.kategori.split(' ')[0]}
                        </span>
                        <span class="w-6 h-6 rounded-full bg-kagit flex items-center justify-center text-xs font-mono font-bold text-kursun group-hover:bg-kirmizi group-hover:text-white transition-colors">
                          +
                        </span>
                      </div>
                    </button>

                    <!-- 2. TIKLANDIĞINDA: BÜYÜYEN EDM POST / PAFTA TASARIMI -->
                    <article
                      class="terim-acik relative flex-col justify-between rounded-2xl bg-[#121316] text-[#f5f7fa] p-5 sm:p-7 shadow-2xl border border-[#24272d] overflow-hidden transition-all duration-200"
                    >
                      <!-- Mimari Arka Plan Filigranı (Harf Rölöve İmzası) -->
                      <span class="absolute right-4 -bottom-6 font-serif text-9xl font-black text-white/[0.03] select-none pointer-events-none leading-none">
                        {t.harf}
                      </span>

                      <div class="relative z-10">
                        <!-- ÜST ŞERİT: KATEGORİ ROZETİ + HUKUKİ ETİKET + KÜÇÜLT BUTONU -->
                        <div class="flex items-center justify-between gap-2 border-b border-[#24272d] pb-3.5">
                          <div class="flex flex-wrap items-center gap-2">
                            <!-- Kırmızı Oval Kategori Rozeti (EDM Post İmza Rozeti) -->
                            <span class="px-2.5 py-0.5 rounded-full bg-[#f0000d] text-white text-[11px] font-mono font-bold uppercase tracking-wider shadow-sm">
                              {t.kategori}
                            </span>
                            <!-- Teknik Mevzuat Kod Rozeti -->
                            <span class="px-2 py-0.5 rounded bg-[#1a1c21] text-[#8a8b8f] border border-[#24272d] text-[10px] font-mono">
                              {t.hukukiKarsilik.split(' ')[0]}
                            </span>
                          </div>

                          <!-- Küçült / Kapat Butonu -->
                          <button
                            type="button"
                            class="terim-kapat-btn inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold text-[#8a8b8f] hover:text-white bg-[#1a1c21] hover:bg-[#f0000d] border border-[#24272d] hover:border-[#f0000d] px-2.5 py-1 rounded-lg transition-all cursor-pointer"
                            title="Kartı küçült"
                          >
                            <span>✕</span>
                            <span>Küçült</span>
                          </button>
                        </div>

                        <!-- İRİ VE VURUCU TERİM MANŞETİ (EDM POST TİPOGRAFİSİ) -->
                        <h3 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight leading-tight mt-4">
                          {t.terim}
                        </h3>

                        <!-- HUKUKİ DAYANAK ŞERHİ -->
                        <div class="flex items-center gap-2 mt-1.5 text-[11px] font-mono text-[#8a8b8f]">
                          <span class="w-1.5 h-1.5 rounded-full bg-[#f0000d]"></span>
                          <span>Hukuki Dayanak: {t.hukukiKarsilik}</span>
                        </div>

                        <!-- TANIM VE DETAY METNİ -->
                        <div class="mt-4 space-y-3 font-sans">
                          <p class="text-sm sm:text-base leading-relaxed text-[#f5f7fa]">
                            {t.kisaTanim}
                          </p>

                          <!-- SAHA GERÇEĞİ VE PRATİK UYGULAMA PANELİ -->
                          <div class="rounded-xl bg-[#1a1c21] border border-[#24272d] p-3.5 sm:p-4 text-xs sm:text-sm text-[#dadee6] leading-relaxed">
                            <div class="flex items-center gap-1.5 text-[#8a8b8f] font-mono text-[10px] font-bold uppercase tracking-wider mb-1">
                              <span class="w-1.5 h-1.5 rounded-full bg-[#8a8b8f]"></span>
                              <span>SAHA GERÇEĞİ & PRATİK ANLAMI</span>
                            </div>
                            <p class="text-[#f5f7fa]">{t.pratikteNeAnlamaGelir}</p>
                          </div>
                        </div>

                        <!-- KRİTİK RİSK VE UYARI KUTUSU (EDM POST İMZA SOL KIRMIZI ŞERİT) -->
                        <div class="mt-4 rounded-xl bg-[#16181f] border border-[#24272d] border-l-4 border-l-[#f0000d] p-3.5 sm:p-4 text-xs sm:text-sm leading-relaxed shadow-lg">
                          <div class="flex items-center gap-1.5 text-[#ff3b30] font-mono text-[11px] font-bold uppercase tracking-wider mb-1">
                            <svg class="w-4 h-4 shrink-0 text-[#f0000d]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                              <line x1="12" y1="9" x2="12" y2="13" />
                              <line x1="12" y1="17" x2="12.01" y2="17" />
                            </svg>
                            <span>DİKKAT · KRİTİK RİSK & UYARI</span>
                          </div>
                          <p class="text-[#f5f7fa]">{t.kritikUyari}</p>
                        </div>
                      </div>

                      <!-- KART ALTI: RESMİ MEVZUAT VE KURUMSAL MARKA DAMGASI -->
                      <div class="relative z-10 mt-5 pt-3.5 border-t border-[#24272d] flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-[#8a8b8f]">
                        <div class="flex flex-wrap items-center gap-2">
                          {t.kaynaklar.map((kaynak) => (
                            <a
                              href={kaynak.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-white hover:text-[#f0000d] bg-[#1a1c21] hover:bg-[#24272d] border border-[#24272d] px-3 py-1.5 rounded-lg transition-colors"
                            >
                              <span>{kaynak.baslik}</span>
                              <span class="text-[#8a8b8f]">↗</span>
                            </a>
                          ))}
                        </div>
                        <div class="flex items-center gap-2 text-[10px] font-mono text-[#8a8b8f] tracking-wider uppercase">
                          <span class="w-1.5 h-1.5 rounded-full bg-[#f0000d]"></span>
                          <span>EDM YAPI & GAYRİMENKUL // ARŞİV</span>
                        </div>
                      </div>
                    </article>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- GENEL YASAL BİLGİLENDİRME ŞERHİ -->
      <div class="mt-14 pt-6 border-t border-murekkep/10 text-center max-w-2xl mx-auto">
        <p class="text-[11px] font-mono text-kursun leading-relaxed">
          Genel bilgilendirme içindir. Taşınmaz işlemlerinizde kesin hukuki sonuç için tapu sicil kayıtlarını, güncel mevzuatı ve uzman danışmanlarımızı esas alınız.
        </p>
      </div>
    </div>
  </section>
</Temel>

<style is:global>
  /* Kapalı durum (Kompakt kelime görünümü) */
  .terim-kapsayici .terim-acik {
    display: none !important;
  }
  .terim-kapsayici .terim-kapali {
    display: flex !important;
  }

  /* Açık durum (Büyümüş EDM Post / Pafta Görünümü) */
  .terim-kapsayici[data-durum="acik"] .terim-acik {
    display: flex !important;
    animation: slideGrow 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .terim-kapsayici[data-durum="acik"] .terim-kapali {
    display: none !important;
  }

  @keyframes slideGrow {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(-6px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
</style>

<script is:inline>
  (() => {
    // 1. TIKLAYINCA BÜYÜME VE KÜÇÜLME (EVENT DELEGATION: EN SAĞLAM YÖNTEM)
    document.addEventListener('click', (e) => {
      // Kapalı kart tıklandı -> BÜYÜT
      const kapaliBtn = e.target.closest('.terim-kapali');
      if (kapaliBtn) {
        e.preventDefault();
        const kapsayici = kapaliBtn.closest('.terim-kapsayici');
        if (kapsayici) {
          kapsayici.setAttribute('data-durum', 'acik');
        }
        return;
      }

      // Küçült butonu tıklandı -> KÜÇÜLT
      const kapatBtn = e.target.closest('.terim-kapat-btn');
      if (kapatBtn) {
        e.preventDefault();
        e.stopPropagation();
        const kapsayici = kapatBtn.closest('.terim-kapsayici');
        if (kapsayici) {
          kapsayici.setAttribute('data-durum', 'kapali');
        }
        return;
      }
    });

    function sayfaBagla() {
      const aramaGirdisi = document.getElementById('terim-arama');
      const aramaTemizle = document.getElementById('arama-temizle');
      const filtreleriSifirla = document.getElementById('filtreleri-sifirla');
      const tumunuAcKapatBtn = document.getElementById('tumunu-ac-kapat');
      const kategoriButonlari = document.querySelectorAll('.kategori-buton');
      const kapsayicilar = document.querySelectorAll('.terim-kapsayici');
      const harfBolumleri = document.querySelectorAll('.harf-bolumu');
      const harfBaglantilari = document.querySelectorAll('.harf-baglanti');
      const bosDurum = document.getElementById('bos-durum');
      const aramaSayac = document.getElementById('arama-sayac');

      let seciliKategori = 'hepsi';
      let aktifSorgu = '';
      let hepsiAcik = false;

      // Tümünü Büyüt / Küçült
      tumunuAcKapatBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        hepsiAcik = !hepsiAcik;
        tumunuAcKapatBtn.textContent = hepsiAcik ? 'Tümünü Küçült' : 'Tümünü Büyüt';

        kapsayicilar.forEach((kapsayici) => {
          if (kapsayici.style.display !== 'none') {
            kapsayici.setAttribute('data-durum', hepsiAcik ? 'acik' : 'kapali');
          }
        });
      });

      // Filtreleme fonksiyonu
      function filtrele() {
        let gorunenSayisi = 0;
        const gorunenHarfler = new Set();

        kapsayicilar.forEach((kapsayici) => {
          const metin = kapsayici.getAttribute('data-terim-metin') || '';
          const kategori = kapsayici.getAttribute('data-terim-kategori') || '';
          const harf = kapsayici.getAttribute('data-terim-harf') || '';

          const sorguUyumu = !aktifSorgu || metin.includes(aktifSorgu);
          const kategoriUyumu = seciliKategori === 'hepsi' || kategori === seciliKategori;

          if (sorguUyumu && kategoriUyumu) {
            kapsayici.style.display = 'block';
            gorunenSayisi++;
            if (harf) gorunenHarfler.add(harf);

            // Arama yapıldıysa eşleşen terimleri otomatik büyüt
            if (aktifSorgu.length >= 2) {
              kapsayici.setAttribute('data-durum', 'acik');
            }
          } else {
            kapsayici.style.display = 'none';
          }
        });

        // Harf başlıklarını göster/gizle
        harfBolumleri.forEach((bolum) => {
          const harf = bolum.getAttribute('data-harf-bolumu') || '';
          bolum.style.display = gorunenHarfler.has(harf) ? 'block' : 'none';
        });

        // Alfabe butonlarını pasif/aktif yap
        harfBaglantilari.forEach((baglanti) => {
          const harf = baglanti.getAttribute('data-harf-hedef') || '';
          if (gorunenHarfler.has(harf)) {
            baglanti.style.opacity = '1';
            baglanti.style.pointerEvents = 'auto';
          } else {
            baglanti.style.opacity = '0.3';
            baglanti.style.pointerEvents = 'none';
          }
        });

        // Boş durum bildirimi
        if (bosDurum) {
          bosDurum.style.display = gorunenSayisi === 0 ? 'block' : 'none';
        }

        // Sayaç güncelle
        if (aramaSayac) {
          if (aktifSorgu || seciliKategori !== 'hepsi') {
            aramaSayac.textContent = `${gorunenSayisi} terim bulundu`;
          } else {
            aramaSayac.textContent = `${gorunenSayisi} terim listeleniyor`;
          }
        }

        // Temizle butonunu göster/gizle
        if (aramaTemizle) {
          aramaTemizle.style.display = aktifSorgu ? 'inline-block' : 'none';
        }
      }

      aramaGirdisi?.addEventListener('input', (e) => {
        aktifSorgu = e.target.value.trim().toLocaleLowerCase('tr');
        filtrele();
      });

      aramaTemizle?.addEventListener('click', () => {
        if (aramaGirdisi) {
          aramaGirdisi.value = '';
          aktifSorgu = '';
          filtrele();
          aramaGirdisi.focus();
        }
      });

      kategoriButonlari.forEach((btn) => {
        btn.addEventListener('click', () => {
          kategoriButonlari.forEach((b) => {
            b.classList.remove('bg-murekkep', 'text-white', 'font-bold', 'shadow-sm');
            b.classList.add('bg-kagit', 'text-metin-2');
          });

          btn.classList.remove('bg-kagit', 'text-metin-2');
          btn.classList.add('bg-murekkep', 'text-white', 'font-bold', 'shadow-sm');

          seciliKategori = btn.getAttribute('data-kategori-deger') || 'hepsi';
          filtrele();
        });
      });

      filtreleriSifirla?.addEventListener('click', () => {
        if (aramaGirdisi) aramaGirdisi.value = '';
        aktifSorgu = '';
        seciliKategori = 'hepsi';

        kategoriButonlari.forEach((b, index) => {
          if (index === 0) {
            b.classList.add('bg-murekkep', 'text-white', 'font-bold', 'shadow-sm');
            b.classList.remove('bg-kagit', 'text-metin-2');
          } else {
            b.classList.remove('bg-murekkep', 'text-white', 'font-bold', 'shadow-sm');
            b.classList.add('bg-kagit', 'text-metin-2');
          }
        });

        filtrele();
      });

      // URL hash varsa doğrudan büyüt
      if (window.location.hash) {
        const slug = window.location.hash.replace('#', '');
        const hedef = document.querySelector(`[data-terim-slug="${slug}"]`);
        if (hedef) {
          hedef.setAttribute('data-durum', 'acik');
          hedef.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    }

    sayfaBagla();
    document.addEventListener('astro:page-load', sayfaBagla);
  })();
</script>
