---
import Panel from '../../layouts/Panel.astro';
import IlanFormu from '../../components/panel/IlanFormu.astro';
import { adminProfiliniBul, paneleGiris } from '../../lib/panel/yetki';
import { env } from 'cloudflare:workers';
import { onbellegiTemizle } from '../../lib/ilanlar';
import { icerik } from '../../lib/icerik';
import { ilanKaydetVeyaGuncelle, semayiKur } from '../../lib/senkron/depo';
import {
  hatirlatmaKaydet,
  ilanYayinDurumuDegistir,
  paylasimKuyrugunaEkle,
  platformlariOku,
} from '../../lib/ilan-isletim';
import {
  IlanFormHatasi,
  formdanIlanVerisi,
  formDegerleriniOku,
  yeniIlanProfiliniDestekleniyor,
  type IlanDogrulamaHatasi,
} from '../../lib/ilan-bilgileri';
import { islemKaydet } from '../../lib/panel/islem-gecmisi';
import { rolYetkisiGerekli } from '../../lib/panel/roller';

const giris = await paneleGiris(Astro.request);
if ('yanit' in giris) return giris.yanit;

const vt = env.VT as D1Database;
await semayiKur(vt);
const admin = adminProfiliniBul(giris.kimlik.eposta);
const { ekip } = await icerik();
let degerler: Record<string, string | string[]> = {
  tip_grup: 'konut',
  islem: 'satilik',
  para_birimi: 'TRY',
  il: 'İstanbul',
  ilce: 'Silivri',
};
let hatalar: IlanDogrulamaHatasi[] = [];
let genelHata = '';
let taslakId = `elle-${Date.now().toString(36)}-${crypto.randomUUID().slice(0, 6)}`;
let gorselSayisi = 0;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  degerler = formDegerleriniOku(form);
  const gelenTaslak = String(form.get('taslak_id') ?? '');
  if (/^elle-[a-z0-9-]{6,34}$/i.test(gelenTaslak)) taslakId = gelenTaslak;
  try {
    rolYetkisiGerekli(admin?.rol ?? null, 'ilan-yonet');
    const veri = formdanIlanVerisi(form);
    if (!yeniIlanProfiliniDestekleniyor(veri.tipGrup, veri.islem, veri.tip)) {
      throw new Error('Bu nadir alt tür için kaynak form doğrulanamadığı için yeni ilan girişi kapalı. Var olan ilanlar düzenlenebilir.');
    }
    const yayinlansin = String(form.get('yayin_durumu') ?? 'aktif') !== 'pasif';
    const paylasilsin = form.get('sosyal_medya_paylas') === 'evet';
    const platformlar = platformlariOku(form.getAll('sosyal_platform'));
    if (paylasilsin && !yayinlansin) throw new Error('Pasif oluşturulan ilan sosyal medya kuyruğuna eklenemez.');
    if (paylasilsin && !platformlar.length) throw new Error('Sosyal paylaşım için en az bir hesap seçin.');

    const yeniId = await ilanKaydetVeyaGuncelle(vt, veri, undefined, taslakId);
    await ilanYayinDurumuDegistir(vt, yeniId, yayinlansin);
    await hatirlatmaKaydet(
      vt,
      yeniId,
      String(form.get('hatirlatma_tarihi') ?? ''),
      String(form.get('hatirlatma_notu') ?? '')
    );
    if (paylasilsin) await paylasimKuyrugunaEkle(vt, yeniId, platformlar, 'panel-kayit');
    await islemKaydet(vt, giris.kimlik, {
      eylem: 'ilan-eklendi',
      varlikTuru: 'ilan',
      varlikId: yeniId,
      ozet: `${veri.baslik} ${yayinlansin ? 'yayında' : 'pasif'} olarak eklendi.`,
      sonraki: { baslik: veri.baslik, fiyat: veri.fiyat, islem: veri.islem, kategori: veri.kategori, tip: veri.tip, yayin_durumu: yayinlansin ? 'aktif' : 'pasif', sosyal_paylasim: paylasilsin },
    });
    onbellegiTemizle();
    return Astro.redirect(`/yonetim/ilanlar?eklendi=${encodeURIComponent(yeniId)}${paylasilsin ? '&paylasim=1' : ''}`);
  } catch (hata) {
    if (hata instanceof IlanFormHatasi) hatalar = hata.alanlar;
    else genelHata = (hata as Error).message || 'İlan kaydedilemedi. Bilgiler formda korundu; yeniden deneyin.';
  }
}

gorselSayisi = await vt
  .prepare(`SELECT COUNT(*) AS adet FROM ilan_foto WHERE ilan_id = ?`)
  .bind(taslakId)
  .first<{ adet: number }>()
  .then((sonuc) => sonuc?.adet ?? 0)
  .catch(() => 0);
---

<Panel
  baslik="Yeni İlan"
  eposta={giris.kimlik.eposta}
  ozet="Kategoriye göre uyarlanan, doğrulamalı portföy girişi"
>
  <div slot="eylem" class="flex items-center gap-2.5">
    <a href="/yonetim/ilanlar" class="pd pd--sade">← İlan listesi</a>
  </div>

  {genelHata && <div class="genel-hata" role="alert">{genelHata}</div>}
  <IlanFormu mod="ekle" ekip={ekip} degerler={degerler} hatalar={hatalar} ilanId={taslakId} gorselSayisi={gorselSayisi} />
</Panel>

<style>
  .genel-hata {
    max-width: 86rem;
    margin: 0 auto 1rem;
    padding: 1rem;
    border: 1px solid #e6a2a5;
    border-radius: 7px;
    background: #fff1f1;
    color: #8d1118;
    font-size: 0.82rem;
    font-weight: 600;
  }
</style>
