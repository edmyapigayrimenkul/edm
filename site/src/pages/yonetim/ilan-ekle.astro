---
import Panel from '../../layouts/Panel.astro';
import { paneleGiris } from '../../lib/panel/yetki';
import { env } from 'cloudflare:workers';
import { onbellegiTemizle } from '../../lib/ilanlar';
import { icerik } from '../../lib/icerik';
import { ilanKaydetVeyaGuncelle } from '../../lib/senkron/depo';
import {
  ISLEM_TURLERI,
  TIP_GRUPLARI,
  MULK_TIPLERI,
  PARA_BIRIMLERI,
  PAZARLIK_DURUMLARI,
  TAKAS_DURUMLARI,
  KREDI_UYGUNLUKLARI,
  ODA_SECENEKLERI,
  BINA_YASLARI,
  KAT_SECENEKLERI,
  ISITMA_TIPLERI,
  BANYO_SAYILARI,
  BALKON_DURUMLARI,
  OTOPARK_DURUMLARI,
  ESYA_DURUMLARI,
  KULLANIM_DURUMLARI,
  TAPU_DURUMLARI,
  YAPI_DURUMLARI,
  YAPI_TIPLERI,
  IMAR_DURUMLARI,
  KAKS_EMSAL_SECENEKLERI,
  GABARI_SECENEKLERI,
  ARSA_YOL_DURUMLARI,
  ZEMIN_YAPILARI,
  DONANIM_KATALOGU,
  formdanIlanVerisi,
} from '../../lib/ilan-bilgileri';

const giris = await paneleGiris(Astro.request);
if ('yanit' in giris) return giris.yanit;

const vt = env.VT as D1Database;
const { ekip } = await icerik();

let bildirim: { tur: 'basari' | 'hata'; metin: string } | null = null;

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const veri = formdanIlanVerisi(form);

    if (!veri.baslik) throw new Error('İlan başlığı zorunludur.');
    if (!veri.fiyat) throw new Error('İlan fiyatı zorunludur.');

    const yeniId = await ilanKaydetVeyaGuncelle(vt, veri);
    onbellegiTemizle();

    return Astro.redirect(`/yonetim/ilanlar?eklendi=${yeniId}`);
  } catch (hata) {
    bildirim = { tur: 'hata', metin: (hata as Error).message };
  }
}
---

<Panel baslik="Yeni İlan Ekle" eposta={giris.kimlik.eposta} ozet="3 Büyük Emlak Platformu Standartlarında Profesyonel Giriş">
  <div slot="eylem" class="flex items-center gap-3">
    <a href="/yonetim/ilanlar" class="pd pd--sade text-sm">← İlan Listesi</a>
    <button type="button" class="pd pd--kirmizi text-sm font-semibold" onclick="document.getElementById('ana-ilan-formu').requestSubmit()">
      İlanı Yayınla
    </button>
  </div>

  {bildirim && <div class={`bildirim bildirim--${bildirim.tur}`}>{bildirim.metin}</div>}

  <!-- Yapışkan Hızlı Gezinme Çubuğu -->
  <nav class="form-hizli-gezinti" aria-label="Form bölümleri">
    <a href="#bolum-kategori" class="hizli-sekme aktif">01. Kategori & İşlem</a>
    <a href="#bolum-fiyat" class="hizli-sekme">02. Fiyat & Finans</a>
    <a href="#bolum-konum" class="hizli-sekme">03. Konum & Kadastro</a>
    <a href="#bolum-teknik" class="hizli-sekme">04. Teknik Künye</a>
    <a href="#bolum-donanim" class="hizli-sekme">05. Donanım (100+)</a>
    <a href="#bolum-medya" class="hizli-sekme">06. Medya & Portallar</a>
    <a href="#bolum-aciklama" class="hizli-sekme">07. Açıklama</a>
  </nav>

  <form method="POST" id="ana-ilan-formu" class="ilan-form-alani">
    <!-- 1. KATEGORİ VE MÜLK TÜRÜ (LÜKS GÖRSEL SEÇİCİ) -->
    <section id="bolum-kategori" class="kutu form-kart-premium">
      <div class="kutu-bas">
        <div>
          <span class="bolum-rozet">BÖLÜM 01</span>
          <h2 class="baslik-kutu">Kategori & Temel Bilgiler</h2>
        </div>
        <span class="kutu-alt-not">Mülkün türüne göre gerekli alanlar otomatik şekillenir</span>
      </div>

      <!-- Büyük Görsel Kategori Seçim Kartları -->
      <div class="kategori-kart-izgara mt-4">
        <label class="kategori-kart aktif" data-grup="konut">
          <input type="radio" name="tip_grup" value="konut" checked class="sr-only" />
          <div class="kategori-ikon">🏠</div>
          <div class="kategori-bilgi">
            <span class="kategori-ad">Konut</span>
            <span class="kategori-aciklama">Daire, Villa, Müstakil Ev, Yazlık</span>
          </div>
          <span class="kategori-isaret">✓</span>
        </label>

        <label class="kategori-kart" data-grup="arsa">
          <input type="radio" name="tip_grup" value="arsa" class="sr-only" />
          <div class="kategori-ikon">🌾</div>
          <div class="kategori-bilgi">
            <span class="kategori-ad">Arsa & Tarla</span>
            <span class="kategori-aciklama">İmarlı Arsa, Tarla, Bahçe, Çiftlik</span>
          </div>
          <span class="kategori-isaret">✓</span>
        </label>

        <label class="kategori-kart" data-grup="isyeri">
          <input type="radio" name="tip_grup" value="isyeri" class="sr-only" />
          <div class="kategori-ikon">🏢</div>
          <div class="kategori-bilgi">
            <span class="kategori-ad">İş Yeri & Ticari</span>
            <span class="kategori-aciklama">Dükkan, Ofis, Mağaza, Depo, Fabrika</span>
          </div>
          <span class="kategori-isaret">✓</span>
        </label>

        <label class="kategori-kart" data-grup="diger">
          <input type="radio" name="tip_grup" value="diger" class="sr-only" />
          <div class="kategori-ikon">🏗️</div>
          <div class="kategori-bilgi">
            <span class="kategori-ad">Diğer & Proje</span>
            <span class="kategori-aciklama">Turistik Tesis, Bina, Özel Mülk</span>
          </div>
          <span class="kategori-isaret">✓</span>
        </label>
      </div>

      <div class="p-izgara mt-6">
        <label class="p-alan col-span-full">
          <span>İlan Başlığı *</span>
          <input
            type="text"
            name="baslik"
            id="baslik-girdi"
            required
            maxlength="160"
            class="vurgulu-girdi"
            placeholder="Örn: Silivri Mimar Sinan'da Deniz Manzaralı Geniş 3+1 Lüks Daire"
          />
          <span class="alan-ipucu">Alıcıların ilk gördüğü alan. Bölge, m² ve en önemli avantajı başlıkta belirtin.</span>
        </label>

        <!-- İşlem Türü (Segmentli Seçici) -->
        <div class="p-alan col-span-full">
          <span>İşlem Türü *</span>
          <div class="islem-segment-izgara">
            {ISLEM_TURLERI.map((islem, i) => (
              <label class="islem-segment-kart">
                <input type="radio" name="islem" value={islem.deger} checked={i === 0} class="sr-only" />
                <span class="segment-etiket">{islem.etiket}</span>
              </label>
            ))}
          </div>
        </div>

        <label class="p-alan md:col-span-2">
          <span>Mülk Tipi (Alt Kategori) *</span>
          <select name="tip" id="secim-tip" required class="secim-kutusu">
            {MULK_TIPLERI.konut.map((t) => <option value={t.deger}>{t.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan md:col-span-2">
          <span>Kategori Başlığı (Otomatik / Vitrin)</span>
          <input type="text" name="kategori" id="kategori-baslik-girdi" placeholder="Örn: Satılık Daire, Satılık Tarla" />
        </label>

        <label class="p-alan md:col-span-2">
          <span>Portföy Sorumlusu Danışman</span>
          <select name="danisman_slug" class="secim-kutusu">
            <option value="">Ofis Ortak Portföyü</option>
            {ekip.map((d) => (
              <option value={d.emlakjetSlug || d.slug}>
                {d.ad} — {d.unvan}
              </option>
            ))}
          </select>
        </label>
      </div>
    </section>

    <!-- 2. FİYAT VE TİCARİ ŞARTLAR (FİNANSAL VURGU KARTI) -->
    <section id="bolum-fiyat" class="kutu form-kart-premium mt-8">
      <div class="kutu-bas">
        <div>
          <span class="bolum-rozet">BÖLÜM 02</span>
          <h2 class="baslik-kutu">Fiyat & Finansal Koşullar</h2>
        </div>
        <span class="kutu-alt-not">Para birimi, birim metrekare fiyatı ve satış şartları</span>
      </div>

      <div class="fiyat-hesap-panosu mt-4">
        <div class="fiyat-ana-giris">
          <label class="p-alan">
            <span class="text-sm font-semibold text-murekkep">Satış / Kiralama Fiyatı *</span>
            <div class="fiyat-giris-sarmal">
              <input
                type="number"
                name="fiyat"
                id="fiyat-girdi"
                min="0"
                required
                inputmode="numeric"
                class="fiyat-buyuk-girdi font-veri"
                placeholder="0"
              />
              <select name="para_birimi" id="para-birimi-secim" class="para-birimi-secici font-veri">
                {PARA_BIRIMLERI.map((p) => <option value={p.deger}>{p.etiket}</option>)}
              </select>
            </div>
          </label>
          <p class="fiyat-okunus mt-1.5 font-veri text-xs text-kursun" id="fiyat-okunus-metin">0 TL</p>
        </div>

        <!-- Canlı Hesaplanan Metrekare ve Birim Fiyat Kutusu -->
        <div class="fiyat-metrik-izgara">
          <div class="metrik-kutu">
            <span class="metrik-baslik">m² BİRİM FİYATI</span>
            <span class="metrik-deger font-veri text-kirmizi" id="gosterge-birim-fiyat">—</span>
            <span class="metrik-alt">Toplam m² girildiğinde hesaplanır</span>
          </div>

          <div class="metrik-kutu" id="donum-kutu" style="display:none">
            <span class="metrik-baslik">DÖNÜM (1.000 m²) FİYATI</span>
            <span class="metrik-deger font-veri text-murekkep" id="gosterge-donum-fiyat">—</span>
            <span class="metrik-alt">Arsa & Tarla için referans</span>
          </div>
        </div>
      </div>

      <div class="p-izgara mt-6">
        <label class="p-alan">
          <span>Pazarlık Durumu</span>
          <select name="pazarlik" class="secim-kutusu">
            {PAZARLIK_DURUMLARI.map((p) => <option value={p.deger}>{p.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Takas Durumu</span>
          <select name="takas" class="secim-kutusu">
            {TAKAS_DURUMLARI.map((t) => <option value={t.deger}>{t.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Krediye Uygunluk</span>
          <select name="kredi_uygunluk" class="secim-kutusu">
            {KREDI_UYGUNLUKLARI.map((k) => <option value={k.deger}>{k.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Tahmini / Mevcut Kira Getirisi (₺ / ay)</span>
          <input type="number" name="kira_getirisi" min="0" placeholder="Örn: 25000" />
        </label>

        <label class="p-alan">
          <span>Aidat Tutarı (₺ / ay)</span>
          <input type="number" name="aidat" min="0" placeholder="Örn: 750" />
        </label>

        <label class="p-alan">
          <span>Depozito (₺ - Kiralık İse)</span>
          <input type="number" name="depozito" min="0" placeholder="Örn: 30000" />
        </label>
      </div>
    </section>

    <!-- 3. KONUM VE RESMİ KADASTRO KARTI -->
    <section id="bolum-konum" class="kutu form-kart-premium mt-8">
      <div class="kutu-bas">
        <div>
          <span class="bolum-rozet">BÖLÜM 03</span>
          <h2 class="baslik-kutu">Konum & Kadastro / Parsel Bilgisi</h2>
        </div>
        <span class="kutu-alt-not">Resmi tapu kayıtlarıyla uyumlu konum bilgileri</span>
      </div>

      <div class="p-izgara mt-4">
        <label class="p-alan">
          <span>İl *</span>
          <input type="text" name="il" required value="İstanbul" class="font-medium" />
        </label>

        <label class="p-alan">
          <span>İlçe *</span>
          <input type="text" name="ilce" required value="Silivri" class="font-medium" />
        </label>

        <label class="p-alan">
          <span>Mahalle / Köy *</span>
          <input type="text" name="mahalle" required placeholder="Örn: Alibey Mahallesi, Selimpaşa, Çanta" />
        </label>

        <label class="p-alan">
          <span>Cadde / Sokak / Mevkii</span>
          <input type="text" name="mevkii" placeholder="Örn: Araptepe Mevkii, Halim Uluşahin Cad." />
        </label>
      </div>

      <!-- Kadastro Vurgu Kutusu (Ada / Parsel / Pafta) -->
      <div class="kadastro-form-kutusu mt-6">
        <div class="kadastro-baslik-serit">
          <div class="flex items-center gap-2">
            <span class="text-lg">📍</span>
            <span class="font-semibold text-sm text-murekkep">Resmi Kadastro Referansı (TKGM)</span>
          </div>
          <a href="https://parselsorgu.tkgm.gov.tr/" target="_blank" rel="noopener noreferrer" class="text-xs text-kirmizi hover:underline font-medium">
            TKGM Parsel Sorgu Ekranını Aç ↗
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-3">
          <label class="p-alan">
            <span class="text-xs font-semibold text-kursun">Ada No</span>
            <input type="text" name="ada" placeholder="Örn: 104" class="font-veri text-base" />
          </label>

          <label class="p-alan">
            <span class="text-xs font-semibold text-kursun">Parsel No</span>
            <input type="text" name="parsel" placeholder="Örn: 18" class="font-veri text-base" />
          </label>

          <label class="p-alan">
            <span class="text-xs font-semibold text-kursun">Pafta No</span>
            <input type="text" name="pafta" placeholder="Örn: F21D12" class="font-veri text-base" />
          </label>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4 pt-4 border-t border-murekkep/10">
          <label class="p-alan">
            <span class="text-xs text-kursun">Harita Enlem (Latitude)</span>
            <input type="text" name="enlem" placeholder="41.074" class="font-veri text-xs" />
          </label>
          <label class="p-alan">
            <span class="text-xs text-kursun">Harita Boylam (Longitude)</span>
            <input type="text" name="boylam" placeholder="28.247" class="font-veri text-xs" />
          </label>
        </div>
      </div>
    </section>

    <!-- 4. MÜLK TEKNİK KÜNYESİ (KATEGORİYE DUYARLI FORM ALANLARI) -->
    <section id="bolum-teknik" class="kutu form-kart-premium mt-8">
      <div class="kutu-bas">
        <div>
          <span class="bolum-rozet">BÖLÜM 04</span>
          <h2 class="baslik-kutu">Mülk Teknik Künyesi & Alan Ölçüleri</h2>
        </div>
        <span class="kutu-alt-not">M² ölçüleri, bina detayları veya imar kriterleri</span>
      </div>

      <!-- Ana m2 Girdisi -->
      <div class="ana-m2-serit mt-4">
        <label class="p-alan max-w-sm">
          <span class="text-sm font-semibold text-murekkep">Ana Metrekare (m²) *</span>
          <div class="relative">
            <input
              type="number"
              name="m2"
              id="ana-m2"
              min="1"
              required
              class="font-veri text-xl font-bold py-2.5 px-3.5 pr-12 w-full border border-murekkep/20 rounded-md"
              placeholder="120"
            />
            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-sm text-kursun font-veri">m²</span>
          </div>
        </label>
        <div class="text-xs text-kursun max-w-md">
          Bu değer ilan kartlarında, filtrelerde ve ana birim fiyat hesaplamasında baz alınan temel metrekaredir.
        </div>
      </div>

      <!-- 4.A KONUT ÖZEL KÜNYESİ -->
      <div id="alanlar-konut" class="kategori-bolumu p-izgara mt-6 pt-6 border-t border-murekkep/10">
        <label class="p-alan">
          <span>Brüt Metrekare</span>
          <input type="number" name="m2_brut" min="1" placeholder="130" />
        </label>

        <label class="p-alan">
          <span>Net Metrekare</span>
          <input type="number" name="m2_net" min="1" placeholder="110" />
        </label>

        <label class="p-alan">
          <span>Açık Alan / Bahçe m²</span>
          <input type="number" name="m2_acik" min="0" placeholder="Villa bahçesi vb." />
        </label>

        <label class="p-alan">
          <span>Oda Sayısı</span>
          <select name="oda" class="secim-kutusu">
            <option value="">Seçiniz</option>
            {ODA_SECENEKLERI.map((o) => <option value={o.deger}>{o.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Salon Sayısı</span>
          <select name="salon_sayisi" class="secim-kutusu">
            <option value="1">1 Salon</option>
            <option value="2">2 Salon</option>
            <option value="3">3+ Salon</option>
          </select>
        </label>

        <label class="p-alan">
          <span>Bina Yaşı</span>
          <select name="bina_yasi" class="secim-kutusu">
            <option value="">Seçiniz</option>
            {BINA_YASLARI.map((b) => <option value={b.deger}>{b.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Bulunduğu Kat</span>
          <select name="bulundugu_kat" class="secim-kutusu">
            <option value="">Seçiniz</option>
            {KAT_SECENEKLERI.map((k) => <option value={k.deger}>{k.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Binadaki Kat Sayısı</span>
          <input type="number" name="kat_sayisi" min="1" max="60" placeholder="5" />
        </label>

        <label class="p-alan">
          <span>Isıtma Tipi</span>
          <select name="isitma_tipi" class="secim-kutusu">
            <option value="">Seçiniz</option>
            {ISITMA_TIPLERI.map((i) => <option value={i.deger}>{i.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Banyo Sayısı</span>
          <select name="banyo_sayisi" class="secim-kutusu">
            <option value="">Seçiniz</option>
            {BANYO_SAYILARI.map((b) => <option value={b.deger}>{b.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Tuvalet / WC</span>
          <select name="tuvalet_sayisi" class="secim-kutusu">
            <option value="">Seçiniz</option>
            <option value="1">1 Tuvalet</option>
            <option value="2">2 Tuvalet</option>
            <option value="3+">3+ Tuvalet</option>
          </select>
        </label>

        <label class="p-alan">
          <span>Balkon</span>
          <select name="balkon" class="secim-kutusu">
            <option value="">Seçiniz</option>
            {BALKON_DURUMLARI.map((b) => <option value={b.deger}>{b.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Asansör</span>
          <select name="asansor" class="secim-kutusu">
            <option value="Var">Var</option>
            <option value="Yok">Yok</option>
          </select>
        </label>

        <label class="p-alan">
          <span>Otopark</span>
          <select name="otopark" class="secim-kutusu">
            <option value="">Seçiniz</option>
            {OTOPARK_DURUMLARI.map((o) => <option value={o.deger}>{o.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Eşya Durumu</span>
          <select name="esya_durumu" class="secim-kutusu">
            {ESYA_DURUMLARI.map((e) => <option value={e.deger}>{e.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Kullanım Durumu</span>
          <select name="kullanim_durumu" class="secim-kutusu">
            {KULLANIM_DURUMLARI.map((k) => <option value={k.deger}>{k.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Site İçerisinde mi?</span>
          <select name="site_icerisinde" class="secim-kutusu">
            <option value="Hayır">Hayır</option>
            <option value="Evet">Evet</option>
          </select>
        </label>

        <label class="p-alan">
          <span>Site / Proje Adı</span>
          <input type="text" name="site_adi" placeholder="Örn: Klassis Konakları, Alkent 2000" />
        </label>

        <label class="p-alan">
          <span>Tapu Durumu</span>
          <select name="tapu_durumu" class="secim-kutusu">
            <option value="">Seçiniz</option>
            {TAPU_DURUMLARI.map((t) => <option value={t.deger}>{t.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Yapı Durumu</span>
          <select name="yapi_durumu" class="secim-kutusu">
            <option value="">Seçiniz</option>
            {YAPI_DURUMLARI.map((y) => <option value={y.deger}>{y.etiket}</option>)}
          </select>
        </label>

        <label class="p-alan">
          <span>Yapı Tipi</span>
          <select name="yapi_tipi" class="secim-kutusu">
            <option value="">Seçiniz</option>
