    </section>
  </form>
</Panel>

<script is:inline define:vars={{ mulkTipleri: MULK_TIPLERI, varsayilanTip: guncelSatir.tip }}>
  const tipGrupSelect = document.getElementById('secim-tip-grup');
  const tipSelect = document.getElementById('secim-tip');
  const alanKonut = document.getElementById('alanlar-konut');
  const alanArsa = document.getElementById('alanlar-arsa');
  const alanIsyeri = document.getElementById('alanlar-isyeri');

  function grupGuncelle() {
    const secilen = tipGrupSelect.value;
    const tipler = mulkTipleri[secilen] || mulkTipleri.diger || [];
    tipSelect.innerHTML = tipler
      .map((t) => `<option value="${t.deger}" ${t.deger === varsayilanTip ? 'selected' : ''}>${t.etiket}</option>`)
      .join('');

    if (secilen === 'arsa') {
      alanKonut.style.display = 'none';
      alanArsa.style.display = 'grid';
      alanIsyeri.style.display = 'none';
    } else if (secilen === 'isyeri') {
      alanKonut.style.display = 'none';
      alanArsa.style.display = 'none';
      alanIsyeri.style.display = 'grid';
    } else {
      alanKonut.style.display = 'grid';
      alanArsa.style.display = 'none';
      alanIsyeri.style.display = 'none';
    }
  }

  tipGrupSelect.addEventListener('change', grupGuncelle);

  // Canlı birim fiyat
  const fiyatGirdi = document.getElementById('fiyat-girdi');
  const m2Girdi = document.getElementById('ana-m2');
  const birimFiyatGosterge = document.getElementById('birim-fiyat-gosterge');

  function birimFiyatHesapla() {
    const fiyat = Number(fiyatGirdi.value) || 0;
    const m2 = Number(m2Girdi.value) || 0;
    if (fiyat > 0 && m2 > 0) {
      const birim = Math.round(fiyat / m2);
      birimFiyatGosterge.textContent = `${birim.toLocaleString('tr-TR')} ₺/m²`;
    } else {
      birimFiyatGosterge.textContent = '—';
    }
  }

  fiyatGirdi.addEventListener('input', birimFiyatHesapla);
  m2Girdi.addEventListener('input', birimFiyatHesapla);
  birimFiyatHesapla();

  // Donanım arama
  const donanimAra = document.getElementById('donanim-ara');
  const donanimEtiketleri = document.querySelectorAll('.donanim-etiket');

  donanimAra.addEventListener('input', (e) => {
    const aranan = e.target.value.toLocaleLowerCase('tr').trim();
    donanimEtiketleri.forEach((etiket) => {
      const metin = etiket.getAttribute('data-etiket') || '';
      if (!aranan || metin.includes(aranan)) {
        etiket.style.display = 'inline-flex';
      } else {
        etiket.style.display = 'none';
      }
    });
  });
</script>

