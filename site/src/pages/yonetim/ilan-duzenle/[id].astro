---
import Panel from '../../../layouts/Panel.astro';
import IlanFormu from '../../../components/panel/IlanFormu.astro';
import { adminProfiliniBul, paneleGiris } from '../../../lib/panel/yetki';
import { env } from 'cloudflare:workers';
import { baslikTemizle, onbellegiTemizle } from '../../../lib/ilanlar';
import { kaynakOzellikleriniUygula, kaynakSunumDuzeltmesi } from '../../../lib/ilan-butunlugu';
import { alanOzellikleriniBirlestir, ilanAlanlariniCoz } from '../../../lib/ilan-alanlari';
import { icerik } from '../../../lib/icerik';
import { duzenlemeleriGetir, ilanKaydetVeyaGuncelle, ilanSatiri, semayiKur, type SatirIlan } from '../../../lib/senkron/depo';
import {
  hatirlatmaKaydet,
  hatirlatmalariGetir,
  elleIlaniKaliciSil,
  ilanYayinDurumuDegistir,
  paylasimKuyrugunaEkle,
  platformlariOku,
} from '../../../lib/ilan-isletim';
import {
  IlanFormHatasi,
  formTipDegeri,
  formdanIlanVerisi,
  formDegerleriniOku,
  ozellikleriFormDegerlerine,
  type IlanDogrulamaHatasi,
} from '../../../lib/ilan-bilgileri';
import { islemKaydet } from '../../../lib/panel/islem-gecmisi';
import { rolYetkisiGerekli, rolYetkisiVar } from '../../../lib/panel/roller';

const giris = await paneleGiris(Astro.request);
if ('yanit' in giris) return giris.yanit;

const vt = env.VT as D1Database;
await semayiKur(vt);
const admin = adminProfiliniBul(giris.kimlik.eposta);
const kaliciSilebilir = rolYetkisiVar(admin?.rol ?? null, 'kalici-sil');
const id = Astro.params.id!;
const ilkSatir = await ilanSatiri(vt, id);
if (!ilkSatir) return Astro.rewrite('/404');

const { ekip } = await icerik();
let hatalar: IlanDogrulamaHatasi[] = [];
let genelHata = '';
let kaydedildi = false;
let paylasimSirada = false;
let gonderilen: Record<string, string | string[]> | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    if (form.get('eylem') === 'elle-sil' && ilkSatir.kaynak === 'elle') {
      rolYetkisiGerekli(admin?.rol ?? null, 'kalici-sil');
      await elleIlaniKaliciSil(vt, (env as Record<string, unknown>).GORSELLER as R2Bucket | undefined, id);
      await islemKaydet(vt, giris.kimlik, { eylem: 'ilan-kalici-silindi', varlikTuru: 'ilan', varlikId: id, ozet: `${baslikTemizle(ilkSatir.baslik)} kalıcı olarak silindi.`, onceki: { baslik: ilkSatir.baslik, durum: ilkSatir.durum, kaynak: ilkSatir.kaynak } });
      onbellegiTemizle();
      return Astro.redirect(`/yonetim/ilanlar?silindi=${encodeURIComponent(id)}`);
    }
    if (form.get('eylem') === 'kaynaga-don' && ilkSatir.kaynak !== 'elle') {
      rolYetkisiGerekli(admin?.rol ?? null, 'ilan-yonet');
      await vt.prepare(
        `UPDATE ilan_duzenleme SET
           baslik = NULL, aciklama = NULL, temel = NULL,
           ozellikler = NULL, donanim = NULL, guncelleme = ?
         WHERE ilan_id = ?`
      ).bind(new Date().toISOString(), id).run();
      await islemKaydet(vt, giris.kimlik, { eylem: 'ilan-kaynaga-dondu', varlikTuru: 'ilan', varlikId: id, ozet: 'Panel düzenlemeleri kaldırıldı; portal verisine dönüldü.' });
      onbellegiTemizle();
      return Astro.redirect(`/yonetim/ilan-duzenle/${encodeURIComponent(id)}?kaynaga-donuldu=1`);
    }
    gonderilen = formDegerleriniOku(form);
    rolYetkisiGerekli(admin?.rol ?? null, 'ilan-yonet');
    const veri = formdanIlanVerisi(form);
    const yayinlansin = String(form.get('yayin_durumu') ?? 'aktif') !== 'pasif';
    const paylasilsin = form.get('sosyal_medya_paylas') === 'evet';
    const platformlar = platformlariOku(form.getAll('sosyal_platform'));
    if (paylasilsin && !yayinlansin) throw new Error('Pasif ilan sosyal medya kuyruğuna eklenemez.');
    if (paylasilsin && !platformlar.length) throw new Error('Sosyal paylaşım için en az bir hesap seçin.');
    await ilanKaydetVeyaGuncelle(vt, veri, id);
    // Kaynakta zaten pasif olan portal ilanına sırf form kaydedildi diye kalıcı
    // yönetici pasifi yazmayız; portal geri gelirse kendiliğinden açılabilsin.
    if (ilkSatir.kaynak === 'elle' || ilkSatir.durum === 'aktif' || yayinlansin) {
      await ilanYayinDurumuDegistir(vt, id, yayinlansin);
    }
    await hatirlatmaKaydet(
      vt,
      id,
      String(form.get('hatirlatma_tarihi') ?? ''),
      String(form.get('hatirlatma_notu') ?? '')
    );
    if (paylasilsin) {
      await paylasimKuyrugunaEkle(vt, id, platformlar, 'panel-duzenleme');
      paylasimSirada = true;
    }
    await islemKaydet(vt, giris.kimlik, {
      eylem: 'ilan-guncellendi',
      varlikTuru: 'ilan',
      varlikId: id,
      ozet: `${baslikTemizle(String(veri.baslik ?? ilkSatir.baslik))} güncellendi${yayinlansin ? ' ve yayında tutuldu' : ' ve pasife alındı'}.`,
      onceki: { baslik: ilkSatir.baslik, fiyat: ilkSatir.fiyat, islem: ilkSatir.islem, kategori: ilkSatir.kategori, durum: ilkSatir.durum },
      sonraki: { baslik: veri.baslik, fiyat: veri.fiyat, islem: veri.islem, kategori: veri.kategori, yayin_durumu: yayinlansin ? 'aktif' : 'pasif', sosyal_paylasim: paylasilsin },
    });
    onbellegiTemizle();
    kaydedildi = true;
    gonderilen = null;
  } catch (hata) {
    if (hata instanceof IlanFormHatasi) hatalar = hata.alanlar;
    else genelHata = (hata as Error).message || 'İlan güncellenemedi. Bilgiler formda korundu; yeniden deneyin.';
  }
}

const satir = (await ilanSatiri(vt, id)) ?? ilkSatir;
const duzenleme = (await duzenlemeleriGetir(vt)).get(id);
const gorunurluk = await vt
  .prepare(`SELECT COALESCE(gizli, 0) AS gizli FROM ilan_duzenleme WHERE ilan_id = ?`)
  .bind(id)
  .first<{ gizli: number }>()
  .catch(() => null);
const hatirlatma = (await hatirlatmalariGetir(vt)).get(id);
const guvenliJson = <T,>(ham: string | null | undefined, varsayilan: T): T => {
  try { return ham ? JSON.parse(ham) as T : varsayilan; } catch { return varsayilan; }
};
const temel = guvenliJson<Partial<SatirIlan>>(duzenleme?.temel, {});
const kaynakDuzeltme = kaynakSunumDuzeltmesi(satir.id);
const etkinSatir: SatirIlan = {
  ...satir,
  ...temel,
  baslik: duzenleme?.baslik ?? temel.baslik ?? kaynakDuzeltme?.baslik ?? satir.baslik,
  aciklama: duzenleme?.aciklama ?? temel.aciklama ?? kaynakDuzeltme?.aciklama ?? satir.aciklama,
  id: satir.id,
  kaynak: satir.kaynak,
  kaynak_url: satir.kaynak_url,
};
const hamOzellikler = guvenliJson<Record<string, string>>(etkinSatir.ozellikler, {});
const duzOzellikler = guvenliJson<Record<string, string>>(duzenleme?.ozellikler, {});
const ozellikler = alanOzellikleriniBirlestir({
  tipGrup: etkinSatir.tip_grup,
  m2: etkinSatir.m2,
  ozellikler: temel.ozellikler != null
    ? guvenliJson<Record<string, string>>(temel.ozellikler, {})
    : kaynakOzellikleriniUygula(hamOzellikler, kaynakDuzeltme),
}, duzOzellikler, Boolean(duzenleme?.temel && duzenleme?.ozellikler));
const alanlar = ilanAlanlariniCoz({ tipGrup: etkinSatir.tip_grup, m2: etkinSatir.m2, ozellikler });
const hamDonanim = guvenliJson<string[]>(etkinSatir.donanim, []);
const duzDonanim = duzenleme?.donanim == null ? null : guvenliJson<string[]>(duzenleme.donanim, []);
const donanim = duzDonanim ?? hamDonanim;
const gorseller = guvenliJson<string[]>(etkinSatir.gorseller, []);
const yuklenenGorselSayisi = await vt
  .prepare(`SELECT COUNT(*) AS adet FROM ilan_foto WHERE ilan_id = ?`)
  .bind(id)
  .first<{ adet: number }>()
  .then((sonuc) => sonuc?.adet ?? 0)
  .catch(() => 0);
const videoSatiri = await vt.prepare(`SELECT video_anahtar, poster_anahtar, sure_saniye, boyut FROM ilan_video WHERE ilan_id = ?`)
  .bind(id)
  .first<{ video_anahtar: string; poster_anahtar: string; sure_saniye: number; boyut: number }>()
  .catch(() => null);
const videoKaydi = videoSatiri ? {
  video: `/g/${videoSatiri.video_anahtar}`,
  poster: `/g/${videoSatiri.poster_anahtar}`,
  sure: videoSatiri.sure_saniye,
  boyut: videoSatiri.boyut,
} : null;

const formOzellikleri = ozellikleriFormDegerlerine(ozellikler, donanim, etkinSatir.tip_grup);
const kayitDegerleri: Record<string, string | string[]> = {
  ...formOzellikleri,
  baslik: baslikTemizle(etkinSatir.baslik),
  aciklama: etkinSatir.aciklama,
  fiyat: etkinSatir.fiyat == null ? '' : String(etkinSatir.fiyat),
  para_birimi: etkinSatir.para_birimi || 'TRY',
  islem: etkinSatir.islem,
  tip_grup: etkinSatir.tip_grup === 'diger' ? 'turistik' : etkinSatir.tip_grup,
  tip: formTipDegeri(etkinSatir.tip_grup, etkinSatir.tip),
  m2_brut: formOzellikleri.m2_brut
    ?? (etkinSatir.tip_grup === 'arsa'
      ? alanlar.toplamParsel == null ? '' : String(alanlar.toplamParsel)
      : alanlar.brutYapi == null ? '' : String(alanlar.brutYapi)),
  oda: etkinSatir.oda ?? '',
  il: etkinSatir.il ?? '',
  ilce: etkinSatir.ilce ?? '',
  mahalle: etkinSatir.mahalle ?? '',
  danisman_slug: ekip.find((d) => d.slug === etkinSatir.danisman_slug || d.emlakjetSlug === etkinSatir.danisman_slug)?.slug ?? etkinSatir.danisman_slug ?? '',
  gorseller: gorseller.join('\n'),
  yayin_durumu: satir.durum === 'aktif' && gorunurluk?.gizli !== 1 ? 'aktif' : 'pasif',
  hatirlatma_tarihi: hatirlatma?.planlanan ?? '',
  hatirlatma_notu: hatirlatma?.notu ?? '',
};
if (!kayitDegerleri.yetki_durumu) kayitDegerleri.yetki_durumu = etkinSatir.kaynak === 'elle' ? '' : 'bekliyor';
if (!kayitDegerleri.emlakjet_no && etkinSatir.kaynak === 'emlakjet') kayitDegerleri.emlakjet_no = etkinSatir.id;
const degerler = gonderilen ?? kayitDegerleri;
const kaynagaDonuldu = Astro.url.searchParams.get('kaynaga-donuldu') === '1';
---

<Panel
  baslik="İlanı Düzenle"
  eposta={giris.kimlik.eposta}
  ozet={`No: ${id} · ${baslikTemizle(etkinSatir.baslik)}`}
>
  <div slot="eylem" class="flex flex-wrap items-center gap-2.5">
    <a href="/yonetim/ilanlar" class="pd pd--sade">← İlan listesi</a>
    <a href={`/ilan/${id}`} target="_blank" rel="noopener" class="pd pd--sade">Sitede gör ↗</a>
    <a href={`/yonetim/portal-onizleme/${id}`} class="pd pd--sade">Portal önizlemesi →</a>
    {etkinSatir.kaynak !== 'elle' && <form method="POST"><input type="hidden" name="eylem" value="kaynaga-don" /><button type="submit" class="pd pd--tehlike">Portal verisine dön</button></form>}
    {etkinSatir.kaynak === 'elle' && kaliciSilebilir && <form method="POST" onsubmit="return confirm('Bu ilan kalıcı olarak silinecek. Devam edilsin mi?')"><input type="hidden" name="eylem" value="elle-sil" /><button type="submit" class="pd pd--tehlike">İlanı sil</button></form>}
  </div>

  {kaydedildi && <div class="bildirim bildirim--basari" role="status">Değişiklikler kaydedildi ve ilan sayfasına uygulandı.</div>}
  {paylasimSirada && <div class="bildirim bildirim--basari" role="status">Sosyal medya paylaşımı kuyruğa eklendi; otomasyon yayından önce ilanı yeniden doğrulayacak.</div>}
  {kaynagaDonuldu && <div class="bildirim bildirim--basari" role="status">Paneldeki içerik düzenlemesi kaldırıldı; portal verisi yeniden kullanılıyor.</div>}
  {genelHata && <div class="bildirim bildirim--hata" role="alert">{genelHata}</div>}
  <IlanFormu
    mod="duzenle"
    ekip={ekip}
    degerler={degerler}
    hatalar={hatalar}
    ilanId={id}
    kaynak={etkinSatir.kaynak}
    kaydedildi={kaydedildi}
    gorselSayisi={gorseller.length + yuklenenGorselSayisi}
    videoKaydi={videoKaydi}
  />
</Panel>

<style>
  .bildirim{max-width:86rem;margin:0 auto 1rem;padding:1rem;border-radius:7px;font-size:.82rem;font-weight:600}.bildirim--basari{border:1px solid #9ecbad;background:#effaf2;color:#205d35}.bildirim--hata{border:1px solid #e6a2a5;background:#fff1f1;color:#8d1118}
</style>
