<script is:inline define:vars={{ mulkTipleri: MULK_TIPLERI, baslangicGrup: aktifTipGrup }}>
  // 1. KATEGORİ SEÇİMİ VE ŞABLON DÖNÜŞÜMÜ
  const radioKategoriler = document.querySelectorAll('input[name="tip_grup"]');
  const tipSelect = document.getElementById('secim-tip');
  const aktifSablonEtiketi = document.getElementById('aktif-sablon-etiketi');
  const donanimAltIzahat = document.getElementById('donanim-alt-izahat');
  const etiketAnaM2 = document.getElementById('etiket-ana-m2');
  const kutuDonumFiyat = document.getElementById('kutu-donum-fiyat');

  const sablonlar = {
    konut: document.getElementById('sablon-konut'),
    arsa: document.getElementById('sablon-arsa'),
    isyeri: document.getElementById('sablon-isyeri'),
  };

  const kataloglar = {
    konut: document.getElementById('katalog-konut'),
    arsa: document.getElementById('katalog-arsa'),
    isyeri: document.getElementById('katalog-isyeri'),
    diger: document.getElementById('katalog-diger'),
  };

  function kategoriAyarla(grup) {
    // Rozet güncelle
    const adlar = { konut: 'Konut', arsa: 'Arsa & Tarla', isyeri: 'İş Yeri & Ticari', diger: 'Diğer & Proje' };
    if (aktifSablonEtiketi) aktifSablonEtiketi.textContent = `Aktif Şablon: ${adlar[grup] || 'Konut'}`;

    // Mülk tipleri dropdownını güncelle (mevcut seçimi korumaya çalış)
    const eskiDeger = tipSelect?.value;
    const tipler = mulkTipleri[grup] || mulkTipleri.diger || [];
    if (tipSelect) {
      tipSelect.innerHTML = tipler.map((t) => `<option value="${t.deger}">${t.etiket}</option>`).join('');
      if (eskiDeger && tipler.some((t) => t.deger === eskiDeger)) {
        tipSelect.value = eskiDeger;
      }
    }

    // Şablon alanlarını göster/gizle
    if (sablonlar.konut) sablonlar.konut.style.display = grup === 'konut' ? 'block' : 'none';
    if (sablonlar.arsa) sablonlar.arsa.style.display = grup === 'arsa' ? 'block' : 'none';
    if (sablonlar.isyeri) sablonlar.isyeri.style.display = grup === 'isyeri' ? 'block' : 'none';

    // Donanım kataloglarını göster/gizle
    Object.keys(kataloglar).forEach((k) => {
      if (kataloglar[k]) {
        kataloglar[k].style.display = k === grup ? 'block' : 'none';
      }
    });

    // m² Etiketi ve Dönüm kutusu
    if (grup === 'arsa') {
      if (etiketAnaM2) etiketAnaM2.innerHTML = 'PARSEL ALANI (m²) <span class="text-kirmizi">*</span>';
      if (kutuDonumFiyat) kutuDonumFiyat.style.display = 'flex';
      if (donanimAltIzahat) donanimAltIzahat.textContent = 'Arsa & araziye özel altyapı, imar, kadastro ve ulaşım donanımları';
    } else if (grup === 'isyeri') {
      if (etiketAnaM2) etiketAnaM2.innerHTML = 'TOPLAM ALAN (m²) <span class="text-kirmizi">*</span>';
      if (kutuDonumFiyat) kutuDonumFiyat.style.display = 'none';
      if (donanimAltIzahat) donanimAltIzahat.textContent = 'İş yerine özel ticari güç, sanayi altyapısı, vitrin ve lojistik donanımları';
    } else {
      if (etiketAnaM2) etiketAnaM2.innerHTML = 'BRÜT ALAN (m²) <span class="text-kirmizi">*</span>';
      if (kutuDonumFiyat) kutuDonumFiyat.style.display = 'none';
      if (donanimAltIzahat) donanimAltIzahat.textContent = 'Konut mimarisine özel iç mekan, site olanakları ve sosyal donatılar';
    }

    birimFiyatHesapla();
    sayaciGuncelle();
  }

  radioKategoriler.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      if (e.target.checked) {
        kategoriAyarla(e.target.value);
      }
    });
  });

  // 2. FİYAT VE METREKARE BİRİM HESAPLAYICI
  const fiyatGirdi = document.getElementById('fiyat-girdi');
  const paraBirimiSecici = document.getElementById('para-birimi-secim');
  const m2Girdi = document.getElementById('ana-m2');
  const gostergeBirim = document.getElementById('gosterge-birim-fiyat');
  const gostergeDonum = document.getElementById('gosterge-donum-fiyat');
  const fiyatOkunusMetin = document.getElementById('fiyat-okunus-metin');
  const baslikGirdi = document.getElementById('baslik-girdi');
  const baslikSayac = document.getElementById('baslik-sayac');

  if (baslikGirdi && baslikSayac) {
    baslikGirdi.addEventListener('input', (e) => {
      baslikSayac.textContent = `${e.target.value.length} / 160`;
    });
  }

  function birimFiyatHesapla() {
    const fiyat = Number(fiyatGirdi.value) || 0;
    const m2 = Number(m2Girdi.value) || 0;
    const para = paraBirimiSecici.value || 'TRY';
    const sembol = para === 'USD' ? '$' : para === 'EUR' ? '€' : para === 'GBP' ? '£' : '₺';

    if (fiyat > 0) {
      fiyatOkunusMetin.textContent = `${fiyat.toLocaleString('tr-TR')} ${para}`;
    } else {
      fiyatOkunusMetin.textContent = '0 TL';
    }

    if (fiyat > 0 && m2 > 0) {
      const birim = Math.round(fiyat / m2);
      gostergeBirim.textContent = `${birim.toLocaleString('tr-TR')} ${sembol} / m²`;

      const donum = Math.round((fiyat / m2) * 1000);
      gostergeDonum.textContent = `${donum.toLocaleString('tr-TR')} ${sembol} / Dönüm`;
    } else {
      gostergeBirim.textContent = '—';
      gostergeDonum.textContent = '—';
    }
  }

  if (fiyatGirdi) fiyatGirdi.addEventListener('input', birimFiyatHesapla);
  if (paraBirimiSecici) paraBirimiSecici.addEventListener('change', birimFiyatHesapla);
  if (m2Girdi) m2Girdi.addEventListener('input', birimFiyatHesapla);
  birimFiyatHesapla();

  // 3. DONANIM ÇİP SAYACI & CANLI ARAMA
  const donanimSayac = document.getElementById('donanim-sayac');
  const donanimAra = document.getElementById('donanim-ara');
  const donanimSifirla = document.getElementById('donanim-sifirla');

  function sayaciGuncelle() {
    const seciliSayisi = document.querySelectorAll('.cip-checkbox:checked').length;
    if (donanimSayac) donanimSayac.textContent = `${seciliSayisi} özellik seçildi`;
  }

  document.getElementById('ana-ilan-formu')?.addEventListener('change', (e) => {
    if (e.target && e.target.classList.contains('cip-checkbox')) {
      sayaciGuncelle();
    }
  });

  if (donanimSifirla) {
    donanimSifirla.addEventListener('click', () => {
      document.querySelectorAll('.cip-checkbox').forEach((cb) => (cb.checked = false));
      sayaciGuncelle();
    });
  }

  if (donanimAra) {
    donanimAra.addEventListener('input', (e) => {
      const q = e.target.value.toLocaleLowerCase('tr').trim();
      document.querySelectorAll('.donanim-cip').forEach((cip) => {
        const metin = cip.getAttribute('data-metin') || '';
        cip.style.display = !q || metin.includes(q) ? 'inline-flex' : 'none';
      });
    });
  }

  // 4. METİN VE KELİME SAYACI
  const aciklamaAlani = document.getElementById('aciklama-alani');
  const kelimeSayac = document.getElementById('kelime-sayac');
  if (aciklamaAlani && kelimeSayac) {
    aciklamaAlani.addEventListener('input', (e) => {
      const val = e.target.value.trim();
      const kelimeler = val ? val.split(/\s+/).length : 0;
      kelimeSayac.textContent = `${kelimeler} kelime · ${val.length} karakter`;
    });
  }
</script>

