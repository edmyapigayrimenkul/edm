---
import Panel from '../../../layouts/Panel.astro';
import { paneleGiris } from '../../../lib/panel/yetki';
import { env } from 'cloudflare:workers';
import { onbellegiTemizle, baslikTemizle } from '../../../lib/ilanlar';
import { icerik } from '../../../lib/icerik';
import { ilanSatiri, duzenlemeleriGetir, ilanKaydetVeyaGuncelle } from '../../../lib/senkron/depo';
import {
  ISLEM_TURLERI,
  TIP_GRUPLARI,
  MULK_TIPLERI,
  PARA_BIRIMLERI,
  PAZARLIK_DURUMLARI,
  TAKAS_DURUMLARI,
  KREDI_UYGUNLUKLARI,
  ODA_SECENEKLERI,
  BINA_YASLARI,
  KAT_SECENEKLERI,
  ISITMA_TIPLERI,
  BANYO_SAYILARI,
  BALKON_DURUMLARI,
  OTOPARK_DURUMLARI,
  ESYA_DURUMLARI,
  KULLANIM_DURUMLARI,
  TAPU_DURUMLARI,
  YAPI_DURUMLARI,
  YAPI_TIPLERI,
  IMAR_DURUMLARI,
  KAKS_EMSAL_SECENEKLERI,
  GABARI_SECENEKLERI,
  ARSA_YOL_DURUMLARI,
  ZEMIN_YAPILARI,
  DONANIM_KATALOGU,
  formdanIlanVerisi,
} from '../../../lib/ilan-bilgileri';

const giris = await paneleGiris(Astro.request);
if ('yanit' in giris) return giris.yanit;

const vt = env.VT as D1Database;
const id = Astro.params.id!;
const satir = await ilanSatiri(vt, id);

if (!satir) return Astro.rewrite('/404');

const { ekip } = await icerik();
const duzenlemeler = await duzenlemeleriGetir(vt);
const duz = duzenlemeler.get(id);

let bildirim: { tur: 'basari' | 'hata'; metin: string } | null = null;

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const veri = formdanIlanVerisi(form);

    if (!veri.baslik) throw new Error('İlan başlığı zorunludur.');
    if (!veri.fiyat) throw new Error('İlan fiyatı zorunludur.');

    await ilanKaydetVeyaGuncelle(vt, veri, id);
    onbellegiTemizle();

    bildirim = {
      tur: 'basari',
      metin: 'İlan başarıyla güncellendi. Değişiklikler sitede anında yayına alındı.',
    };
  } catch (hata) {
    bildirim = { tur: 'hata', metin: (hata as Error).message };
  }
}

// Güncel veriyi hazırla
const guncelSatir = (await ilanSatiri(vt, id)) ?? satir;
const guncelDuzenleme = (await duzenlemeleriGetir(vt)).get(id) ?? duz;

const guvenliJson = <T,>(m: string | null | undefined, v: T): T => {
  try {
    return m ? (JSON.parse(m) as T) : v;
  } catch {
    return v;
  }
};

const hamOz = guvenliJson<Record<string, string>>(guncelSatir.ozellikler, {});
const duzOz = guncelDuzenleme?.ozellikler
  ? guvenliJson<Record<string, string>>(guncelDuzenleme.ozellikler, {})
  : {};
const oz = { ...hamOz, ...duzOz };

const hamDonanim = guvenliJson<string[]>(guncelSatir.donanim ?? '[]', []);
const duzDonanim = guncelDuzenleme?.donanim
  ? guvenliJson<string[]>(guncelDuzenleme.donanim, [])
  : null;
const seciliDonanim = new Set(duzDonanim && duzDonanim.length ? duzDonanim : hamDonanim);

const gorsellerDizi = guvenliJson<string[]>(guncelSatir.gorseller, []);
const gorselMetin = gorsellerDizi.join('\n');

const baslik = guncelDuzenleme?.baslik ?? baslikTemizle(guncelSatir.baslik);
const aciklama = guncelDuzenleme?.aciklama ?? guncelSatir.aciklama;

// Sayısal temizleme yardımcıları
const sayiAl = (val?: string) => {
  if (!val) return '';
  const m = val.match(/\d+/);
  return m ? m[0] : '';
};
---

<Panel baslik={`İlan Düzenle: ${baslik}`} eposta={giris.kimlik.eposta} ozet={`İlan No: ${id} · Kaynak: ${satir.kaynak}`}>
  <div slot="eylem" class="flex items-center gap-2.5">
    <a href={`/yonetim/gorsel/${id}`} class="pd pd--sade">
      Görsel Sırası & Kapak
    </a>
    <a href={`/ilan/${guncelSatir.slug || id}`} target="_blank" rel="noopener noreferrer" class="pd pd--sade">
      Sitede Gör ↗
    </a>
    <a href="/yonetim/ilanlar" class="pd pd--sade">← İlanlar</a>
    <button type="button" class="pd pd--kirmizi" onclick="document.getElementById('duzenle-ilan-formu').requestSubmit()">
      Kaydet
    </button>
  </div>

  {bildirim && <div class={`bildirim bildirim--${bildirim.tur}`}>{bildirim.metin}</div>}

  <form method="POST" id="duzenle-ilan-formu" class="ilan-form-alani">
    <!-- 1. KATEGORİ VE TEMEL BİLGİLER -->
    <section class="kutu mb-6">
      <div class="kutu-bas">
        <div class="flex items-baseline gap-2.5">
          <span class="font-veri text-xs font-semibold text-kirmizi">[01]</span>
          <h2 class="text-sm font-semibold text-murekkep">Kategori & Temel Bilgiler</h2>
        </div>
        <span class="text-xs text-kursun">Mülk grubu, işlem tipi ve vitrin başlığı</span>
      </div>

      <div class="p-5 md:p-6 space-y-6">
        <!-- Mülk Grubu (Segment Seçici) -->
        <div class="space-y-1.5">
          <label class="form-etiket">MÜLK GRUBU <span class="text-kirmizi">*</span></label>
          <div class="segment-grup" role="radiogroup">
            <label class:list={['segment-oge', guncelSatir.tip_grup === 'konut' && 'aktif']} data-grup="konut">
              <input type="radio" name="tip_grup" value="konut" checked={guncelSatir.tip_grup === 'konut'} class="sr-only" />
              <span>Konut</span>
            </label>
            <label class:list={['segment-oge', guncelSatir.tip_grup === 'arsa' && 'aktif']} data-grup="arsa">
              <input type="radio" name="tip_grup" value="arsa" checked={guncelSatir.tip_grup === 'arsa'} class="sr-only" />
              <span>Arsa & Tarla</span>
            </label>
            <label class:list={['segment-oge', guncelSatir.tip_grup === 'isyeri' && 'aktif']} data-grup="isyeri">
              <input type="radio" name="tip_grup" value="isyeri" checked={guncelSatir.tip_grup === 'isyeri'} class="sr-only" />
              <span>İş Yeri & Ticari</span>
            </label>
            <label class:list={['segment-oge', guncelSatir.tip_grup === 'diger' && 'aktif']} data-grup="diger">
              <input type="radio" name="tip_grup" value="diger" checked={guncelSatir.tip_grup === 'diger'} class="sr-only" />
              <span>Diğer & Proje</span>
            </label>
          </div>
        </div>

        <!-- İşlem Türü (Segment Seçici) -->
        <div class="space-y-1.5">
          <label class="form-etiket">İŞLEM TÜRÜ <span class="text-kirmizi">*</span></label>
          <div class="segment-grup max-w-2xl" role="radiogroup">
            {ISLEM_TURLERI.map((islem) => (
              <label class:list={['segment-oge', guncelSatir.islem === islem.deger && 'aktif']}>
                <input
                  type="radio"
                  name="islem"
                  value={islem.deger}
                  checked={guncelSatir.islem === islem.deger}
                  class="sr-only"
                />
                <span>{islem.etiket}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- İlan Başlığı -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label class="form-etiket" for="baslik-girdi">
              İLAN BAŞLIĞI <span class="text-kirmizi">*</span>
            </label>
            <span class="text-[0.6875rem] font-veri text-kursun" id="baslik-sayac">{baslik.length} / 160</span>
          </div>
          <input
            type="text"
            name="baslik"
            id="baslik-girdi"
            required
            maxlength="160"
            value={baslik}
            class="form-girdi form-girdi--vurgulu"
            placeholder="Örn: Silivri Selimpaşa'da Deniz Manzaralı Müstakil Villa"
          />
        </div>

        <!-- 3 Sütunlu Grid: Alt Tip, Vitrin Kategori, Danışman -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="space-y-1.5">
            <label class="form-etiket" for="secim-tip">
              MÜLK TİPİ (ALT KATEGORİ) <span class="text-kirmizi">*</span>
            </label>
            <select name="tip" id="secim-tip" required class="form-secim">
              {(MULK_TIPLERI[guncelSatir.tip_grup] || MULK_TIPLERI.konut).map((t) => (
                <option value={t.deger} selected={t.deger === guncelSatir.tip}>
                  {t.etiket}
                </option>
              ))}
            </select>
          </div>

          <div class="space-y-1.5">
            <label class="form-etiket" for="kategori-baslik-girdi">VİTRİN KATEGORİ ETİKETİ</label>
            <input
              type="text"
              name="kategori"
              id="kategori-baslik-girdi"
              value={guncelSatir.kategori}
              class="form-girdi"
              placeholder="Örn: Satılık Villa, Satılık Tarla"
            />
          </div>

          <div class="space-y-1.5">
            <label class="form-etiket" for="danisman-secim">PORTFÖY SORUMLUSU</label>
            <select name="danisman_slug" id="danisman-secim" class="form-secim">
              <option value="">Ofis Ortak Portföyü</option>
              {ekip.map((d) => (
                <option
                  value={d.emlakjetSlug || d.slug}
                  selected={(d.emlakjetSlug && d.emlakjetSlug === guncelSatir.danisman_slug) || d.slug === guncelSatir.danisman_slug}
                >
                  {d.ad} — {d.unvan}
                </option>
              ))}
            </select>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. FİYAT VE FİNANSAL KOŞULLAR -->
    <section class="kutu mb-6">
      <div class="kutu-bas">
        <div class="flex items-baseline gap-2.5">
          <span class="font-veri text-xs font-semibold text-kirmizi">[02]</span>
          <h2 class="text-sm font-semibold text-murekkep">Fiyat & Finansal Koşullar</h2>
        </div>
        <span class="text-xs text-kursun">Para birimi, birim fiyat hesaplamaları ve ödeme şartları</span>
      </div>

      <div class="p-5 md:p-6 space-y-6">
        <!-- Fiyat Girişi ve Hesaplanan Göstergeler -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
          <div class="lg:col-span-7 space-y-2">
            <label class="form-etiket" for="fiyat-girdi">
              SATIŞ / KİRALAMA FİYATI <span class="text-kirmizi">*</span>
            </label>
            <div class="fiyat-bilesik-alan">
              <input
                type="number"
                name="fiyat"
                id="fiyat-girdi"
                min="0"
                required
                inputmode="numeric"
                value={guncelSatir.fiyat ?? 0}
                class="fiyat-ana-girdi font-veri"
                placeholder="0"
              />
              <select name="para_birimi" id="para-birimi-secim" class="fiyat-birim-secici font-veri">
                {PARA_BIRIMLERI.map((p) => (
                  <option value={p.deger} selected={p.deger === (guncelSatir.para_birimi || 'TRY')}>
                    {p.etiket}
                  </option>
                ))}
              </select>
            </div>
            <p class="font-veri text-xs text-kursun" id="fiyat-okunus-metin">0 TL</p>
          </div>

          <!-- Hesaplanan Metrik Şeridi -->
          <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            <div class="metrik-hucre">
              <span class="metrik-hucre-etiket">m² BİRİM FİYATI</span>
              <span class="metrik-hucre-deger text-murekkep" id="gosterge-birim-fiyat">—</span>
              <span class="metrik-hucre-alt">Fiyat / Toplam m²</span>
            </div>
            <div class="metrik-hucre" id="donum-kutu" style={guncelSatir.tip_grup === 'arsa' ? 'display:flex' : 'display:none'}>
              <span class="metrik-hucre-etiket">DÖNÜM FİYATI</span>
              <span class="metrik-hucre-deger text-kirmizi" id="gosterge-donum-fiyat">—</span>
              <span class="metrik-hucre-alt">1.000 m² referansı</span>
            </div>
          </div>
        </div>

        <div class="cizgi"></div>

        <!-- Finansal Şartlar Izgarası -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="space-y-1.5">
            <label class="form-etiket">PAZARLIK DURUMU</label>
            <select name="pazarlik" class="form-secim">
              {PAZARLIK_DURUMLARI.map((p) => (
                <option value={p.deger} selected={p.deger === oz.pazarlik}>{p.etiket}</option>
              ))}
            </select>
          </div>

          <div class="space-y-1.5">
            <label class="form-etiket">TAKAS SEÇENEĞİ</label>
            <select name="takas" class="form-secim">
              {TAKAS_DURUMLARI.map((t) => (
                <option value={t.deger} selected={t.deger === oz.takas}>{t.etiket}</option>
              ))}
            </select>
          </div>

          <div class="space-y-1.5">
            <label class="form-etiket">KREDİYE UYGUNLUK</label>
            <select name="kredi_uygunluk" class="form-secim">
              {KREDI_UYGUNLUKLARI.map((k) => (
                <option value={k.deger} selected={k.deger === oz.kredi_uygunluk}>{k.etiket}</option>
              ))}
            </select>
          </div>

          <div class="space-y-1.5">
            <label class="form-etiket">AİDAT TUTARI (₺ / AY)</label>
            <input type="number" name="aidat" min="0" value={sayiAl(oz.aidat)} placeholder="0" class="form-girdi font-veri" />
          </div>

          <div class="space-y-1.5">
            <label class="form-etiket">TAHMİNİ KİRA GETİRİSİ (₺ / AY)</label>
            <input type="number" name="kira_getirisi" min="0" value={sayiAl(oz.kira_getirisi)} placeholder="0" class="form-girdi font-veri" />
          </div>

          <div class="space-y-1.5">
            <label class="form-etiket">DEPOZİTO (₺ - KİRALIK İSE)</label>
            <input type="number" name="depozito" min="0" value={sayiAl(oz.depozito)} placeholder="0" class="form-girdi font-veri" />
          </div>
        </div>
      </div>
    </section>

    <!-- 3. KONUM VE RESMİ KADASTRO -->
    <section class="kutu mb-6">
      <div class="kutu-bas">
        <div class="flex items-baseline gap-2.5">
          <span class="font-veri text-xs font-semibold text-kirmizi">[03]</span>
          <h2 class="text-sm font-semibold text-murekkep">Konum & Resmi Kadastro</h2>
        </div>
        <span class="text-xs text-kursun">İdari adres ve TKGM parsel koordinatları</span>
      </div>

      <div class="p-5 md:p-6 space-y-6">
        <!-- 4 Sütunlu Adres Izgarası -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="space-y-1.5">
            <label class="form-etiket">İL <span class="text-kirmizi">*</span></label>
            <input type="text" name="il" required value={guncelSatir.il || 'İstanbul'} class="form-girdi" />
          </div>

          <div class="space-y-1.5">
            <label class="form-etiket">İLÇE <span class="text-kirmizi">*</span></label>
            <input type="text" name="ilce" required value={guncelSatir.ilce || 'Silivri'} class="form-girdi" />
          </div>

          <div class="space-y-1.5">
            <label class="form-etiket">MAHALLE / KÖY <span class="text-kirmizi">*</span></label>
            <input type="text" name="mahalle" required value={guncelSatir.mahalle || ''} class="form-girdi" />
          </div>

          <div class="space-y-1.5">
            <label class="form-etiket">CADDE / SOKAK / MEVKİİ</label>
            <input type="text" name="mevkii" value={oz.mevkii || ''} placeholder="Örn: Araptepe Mevkii, Plaj Cad." class="form-girdi" />
          </div>
        </div>

        <!-- Resmi Kadastro Pafta Bloğu -->
        <div class="pafta-blok">
          <div class="pafta-blok-baslik">
            <div class="flex items-center gap-2">
              <span class="pafta-nokta"></span>
              <span class="font-veri text-xs font-semibold uppercase tracking-wider text-murekkep">
                TKGM RESMİ KADASTRO REFERANSI
              </span>
            </div>
            <a
              href="https://parselsorgu.tkgm.gov.tr/"
              target="_blank"
              rel="noopener noreferrer"
              class="font-veri text-xs text-kursun hover:text-murekkep transition"
            >
              Parsel Sorgu Ekranı ↗
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4">
            <div class="space-y-1.5">
              <label class="form-etiket">ADA NO</label>
              <input type="text" name="ada" value={oz.ada || ''} placeholder="Örn: 104" class="form-girdi font-veri" />
            </div>

            <div class="space-y-1.5">
              <label class="form-etiket">PARSEL NO</label>
              <input type="text" name="parsel" value={oz.parsel || ''} placeholder="Örn: 18" class="form-girdi font-veri" />
            </div>

            <div class="space-y-1.5">
              <label class="form-etiket">PAFTA NO</label>
              <input type="text" name="pafta" value={oz.pafta || ''} placeholder="Örn: F21D12" class="form-girdi font-veri" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4 pt-4 border-t border-murekkep/8">
            <div class="space-y-1.5">
              <label class="form-etiket">HARİTA ENLEM (LATITUDE)</label>
              <input type="text" name="enlem" value={oz.enlem || ''} placeholder="41.074" class="form-girdi font-veri text-xs" />
            </div>
            <div class="space-y-1.5">
              <label class="form-etiket">HARİTA BOYLAM (LONGITUDE)</label>
              <input type="text" name="boylam" value={oz.boylam || ''} placeholder="28.247" class="form-girdi font-veri text-xs" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. MÜLK KÜNYESİ (DİNAMİK KATEGORİ ALANLARI) -->
    <section class="kutu mb-6">
      <div class="kutu-bas">
        <div class="flex items-baseline gap-2.5">
          <span class="font-veri text-xs font-semibold text-kirmizi">[04]</span>
          <h2 class="text-sm font-semibold text-murekkep">Mülk Teknik Künyesi</h2>
        </div>
        <span class="text-xs text-kursun">Metrekare ölçüleri, bina özellikleri ve imar verileri</span>
      </div>

      <div class="p-5 md:p-6 space-y-6">
        <!-- Ana m2 Girdisi -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
          <div class="space-y-1.5">
            <label class="form-etiket" for="ana-m2">
              ANA METREKARE (m²) <span class="text-kirmizi">*</span>
            </label>
            <div class="bilesik-m2-alan">
              <input
                type="number"
                name="m2"
                id="ana-m2"
                min="1"
                required
                value={guncelSatir.m2 ?? ''}
                class="form-girdi font-veri font-bold"
                placeholder="120"
              />
              <span class="bilesik-m2-ek font-veri">m²</span>
            </div>
          </div>
          <p class="md:col-span-2 text-xs text-kursun leading-relaxed">
            Bu değer vitrinde, filtrelerde ve ana birim fiyat hesabında baz alınan temel alandır.
          </p>
        </div>

        <!-- 4.A KONUT ALANLARI -->
        <div id="alanlar-konut" class="space-y-6 pt-4 border-t border-murekkep/8" style={guncelSatir.tip_grup === 'konut' ? 'display:block' : 'display:none'}>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="space-y-1.5">
              <label class="form-etiket">BRÜT METREKARE</label>
              <input type="number" name="m2_brut" min="1" value={sayiAl(oz.m2_brut) || guncelSatir.m2 || ''} class="form-girdi font-veri" />
            </div>

            <div class="space-y-1.5">
              <label class="form-etiket">NET METREKARE</label>
              <input type="number" name="m2_net" min="1" value={sayiAl(oz.m2_net) || ''} class="form-girdi font-veri" />
            </div>

            <div class="space-y-1.5">
              <label class="form-etiket">AÇIK ALAN / BAHÇE m²</label>
              <input type="number" name="m2_acik" min="0" value={sayiAl(oz.m2_acik) || ''} class="form-girdi font-veri" />
            </div>

            <div class="space-y-1.5">
              <label class="form-etiket">ODA SAYISI</label>
              <select name="oda" class="form-secim">
                <option value="">Seçiniz</option>
                {ODA_SECENEKLERI.map((o) => (
                  <option value={o.deger} selected={o.deger === (guncelSatir.oda || oz.oda)}>{o.etiket}</option>
                ))}
              </select>
            </div>

            <div class="space-y-1.5">
              <label class="form-etiket">SALON SAYISI</label>
              <select name="salon_sayisi" class="form-secim">
                <option value="1" selected={oz.salon_sayisi === '1'}>1 Salon</option>
                <option value="2" selected={oz.salon_sayisi === '2'}>2 Salon</option>
                <option value="3" selected={oz.salon_sayisi === '3'}>3+ Salon</option>
              </select>
            </div>

