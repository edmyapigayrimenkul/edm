---
import Panel from '../../../layouts/Panel.astro';
import { paneleGiris } from '../../../lib/panel/yetki';
import { env } from 'cloudflare:workers';
import { onbellegiTemizle, baslikTemizle } from '../../../lib/ilanlar';
import { icerik } from '../../../lib/icerik';
import { ilanSatiri, duzenlemeleriGetir, ilanKaydetVeyaGuncelle } from '../../../lib/senkron/depo';
import {
  ISLEM_TURLERI,
  TIP_GRUPLARI,
  MULK_TIPLERI,
  PARA_BIRIMLERI,
  PAZARLIK_DURUMLARI,
  TAKAS_DURUMLARI,
  KREDI_UYGUNLUKLARI,
  ODA_SECENEKLERI,
  BINA_YASLARI,
  KAT_SECENEKLERI,
  ISITMA_TIPLERI,
  BANYO_SAYILARI,
  BALKON_DURUMLARI,
  OTOPARK_DURUMLARI,
  ESYA_DURUMLARI,
  KULLANIM_DURUMLARI,
  TAPU_DURUMLARI,
  YAPI_DURUMLARI,
  YAPI_TIPLERI,
  IMAR_DURUMLARI,
  KAKS_EMSAL_SECENEKLERI,
  GABARI_SECENEKLERI,
  ARSA_YOL_DURUMLARI,
  ZEMIN_YAPILARI,
  KATEGORI_DONANIM_KATALOGU,
  formdanIlanVerisi,
} from '../../../lib/ilan-bilgileri';

const giris = await paneleGiris(Astro.request);
if ('yanit' in giris) return giris.yanit;

const vt = env.VT as D1Database;
const id = Astro.params.id!;
const satir = await ilanSatiri(vt, id);

if (!satir) return Astro.rewrite('/404');

const { ekip } = await icerik();
const duzenlemeler = await duzenlemeleriGetir(vt);
const duz = duzenlemeler.get(id);

let bildirim: { tur: 'basari' | 'hata'; metin: string } | null = null;

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const veri = formdanIlanVerisi(form);

    if (!veri.baslik) throw new Error('İlan başlığı zorunludur.');
    if (!veri.fiyat) throw new Error('İlan fiyatı zorunludur.');

    await ilanKaydetVeyaGuncelle(vt, veri, id);
    onbellegiTemizle();

    bildirim = {
      tur: 'basari',
      metin: 'İlan başarıyla güncellendi. Değişiklikler sitede anında yayına alındı.',
    };
  } catch (hata) {
    bildirim = { tur: 'hata', metin: (hata as Error).message };
  }
}

// Güncel veriyi hazırla
const guncelSatir = (await ilanSatiri(vt, id)) ?? satir;
const guncelDuzenleme = (await duzenlemeleriGetir(vt)).get(id) ?? duz;

const guvenliJson = <T,>(m: string | null | undefined, v: T): T => {
  try {
    return m ? (JSON.parse(m) as T) : v;
  } catch {
    return v;
  }
};

const hamOz = guvenliJson<Record<string, string>>(guncelSatir.ozellikler, {});
const duzOz = guncelDuzenleme?.ozellikler
  ? guvenliJson<Record<string, string>>(guncelDuzenleme.ozellikler, {})
  : {};
const oz = { ...hamOz, ...duzOz };

const hamDonanim = guvenliJson<string[]>(guncelSatir.donanim ?? '[]', []);
const duzDonanim = guncelDuzenleme?.donanim
  ? guvenliJson<string[]>(guncelDuzenleme.donanim, [])
  : null;
const seciliDonanim = new Set(duzDonanim && duzDonanim.length ? duzDonanim : hamDonanim);

const gorsellerDizi = guvenliJson<string[]>(guncelSatir.gorseller, []);
const gorselMetin = gorsellerDizi.join('\n');

const baslik = guncelDuzenleme?.baslik ?? baslikTemizle(guncelSatir.baslik);
const aciklama = guncelDuzenleme?.aciklama ?? guncelSatir.aciklama;

const aktifTipGrup = guncelSatir.tip_grup || 'konut';

// Anahtar okuyucu yardımcı
const degerAl = (...anahtarlar: string[]) => {
  for (const a of anahtarlar) {
    if (oz[a] && oz[a] !== 'Belirtilmemiş' && oz[a] !== 'Seçiniz') return oz[a];
  }
  return '';
};
---

<Panel baslik={`İlan Düzenle: ${id}`} eposta={giris.kimlik.eposta} ozet={`No: ${id} · ${baslik}`}>
  <div slot="eylem" class="flex flex-wrap items-center gap-2.5">
    <a href="/yonetim/ilanlar" class="pd pd--sade">← İlan Listesi</a>
    <a href={`/yonetim/gorsel/${id}`} class="pd pd--sade text-kirmizi">
      Görsel Sırası & Kapak ({gorsellerDizi.length})
    </a>
    <a href={guncelSatir.yol || `/ilan/${id}`} target="_blank" class="pd pd--sade">
      Sitede Gör ↗
    </a>
    <button type="button" class="pd pd--kirmizi" onclick="document.getElementById('ana-ilan-formu').requestSubmit()">
      Değişiklikleri Kaydet
    </button>
  </div>

  {bildirim && (
    <div class:list={['p-4 mb-6 rounded border text-sm font-medium', bildirim.tur === 'hata' ? 'bg-red-50 text-red-700 border-red-200' : 'bg-green-50 text-green-700 border-green-200']}>
      {bildirim.metin}
    </div>
  )}

  <form method="POST" id="ana-ilan-formu" class="space-y-8 pb-16">
    <!-- ADIM 1: MÜLK KATEGORİSİ SEÇİMİ (ŞABLON BELİRLEYİCİ) -->
    <section class="kart">
      <div class="kart-ust">
        <div>
          <span class="kart-rozet">ADIM 01</span>
          <h2 class="kart-baslik">Mülk Kategorisi & Şablon Seçimi</h2>
          <p class="kart-alt">Seçili kategoriye göre form alanları ve teknik donanım kataloğu uyarlanır.</p>
        </div>
        <span id="aktif-sablon-etiketi" class="aktif-sablon-rozet">
          Aktif Şablon: {aktifTipGrup === 'arsa' ? 'Arsa & Tarla' : aktifTipGrup === 'isyeri' ? 'İş Yeri & Ticari' : aktifTipGrup === 'diger' ? 'Diğer & Proje' : 'Konut'}
        </span>
      </div>

      <div class="kart-govde">
        <div class="kategori-izgara" role="radiogroup" aria-label="Mülk Kategorisi">
          <!-- Konut -->
          <label class="kategori-kart">
            <input type="radio" name="tip_grup" value="konut" checked={aktifTipGrup === 'konut'} class="sr-only" />
            <div class="kategori-kart-icerik">
              <div class="kategori-kart-ikon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="w-6 h-6">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
              </div>
              <div class="kategori-kart-metin">
                <div class="kategori-kart-baslik">Konut</div>
                <div class="kategori-kart-izahat">Daire, Villa, Müstakil Ev, Rezidans, Yazlık</div>
              </div>
              <div class="kategori-kart-isaret"></div>
            </div>
          </label>

          <!-- Arsa & Tarla -->
          <label class="kategori-kart">
            <input type="radio" name="tip_grup" value="arsa" checked={aktifTipGrup === 'arsa'} class="sr-only" />
            <div class="kategori-kart-icerik">
              <div class="kategori-kart-ikon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="w-6 h-6">
                  <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                  <polyline points="2 17 12 22 22 17"></polyline>
                  <polyline points="2 12 12 17 22 12"></polyline>
                </svg>
              </div>
              <div class="kategori-kart-metin">
                <div class="kategori-kart-baslik">Arsa & Tarla</div>
                <div class="kategori-kart-izahat">İmarlı Arsa, Tarla, Bağ, Bahçe, Çiftlik Arazisi</div>
              </div>
              <div class="kategori-kart-isaret"></div>
            </div>
          </label>

          <!-- İş Yeri & Ticari -->
          <label class="kategori-kart">
            <input type="radio" name="tip_grup" value="isyeri" checked={aktifTipGrup === 'isyeri'} class="sr-only" />
            <div class="kategori-kart-icerik">
              <div class="kategori-kart-ikon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="w-6 h-6">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </div>
              <div class="kategori-kart-metin">
                <div class="kategori-kart-baslik">İş Yeri & Ticari</div>
                <div class="kategori-kart-izahat">Dükkan, Mağaza, Ofis, Depo, Fabrika</div>
              </div>
              <div class="kategori-kart-isaret"></div>
            </div>
          </label>

          <!-- Diğer & Proje -->
          <label class="kategori-kart">
            <input type="radio" name="tip_grup" value="diger" checked={aktifTipGrup === 'diger'} class="sr-only" />
            <div class="kategori-kart-icerik">
              <div class="kategori-kart-ikon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="w-6 h-6">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
              </div>
              <div class="kategori-kart-metin">
                <div class="kategori-kart-baslik">Diğer & Proje</div>
                <div class="kategori-kart-izahat">Turistik Tesis, Otel, Komple Bina, Proje</div>
              </div>
              <div class="kategori-kart-isaret"></div>
            </div>
          </label>
        </div>
      </div>
    </section>

    <!-- ADIM 2: TEMEL BİLGİLER & FİYATLANDIRMA -->
    <section class="kart">
      <div class="kart-ust">
        <div>
          <span class="kart-rozet">ADIM 02</span>
          <h2 class="kart-baslik">Temel Bilgiler, Fiyat & Konum</h2>
          <p class="kart-alt">İlan başlığı, işlem türü, parasal değerler ve konum koordinatları</p>
        </div>
      </div>

      <div class="kart-govde space-y-6">
        <!-- İşlem Türü (Segment) -->
        <div class="space-y-2">
          <label class="alan-etiket">İŞLEM TÜRÜ <span class="text-kirmizi">*</span></label>
          <div class="islem-segment-grup" role="radiogroup">
            {ISLEM_TURLERI.map((islem) => (
              <label class="islem-segment-oge">
                <input
                  type="radio"
                  name="islem"
                  value={islem.deger}
                  checked={guncelSatir.islem === islem.deger}
                  class="sr-only"
                />
                <span>{islem.etiket}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- İlan Başlığı -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label class="alan-etiket" for="baslik-girdi">
              İLAN BAŞLIĞI <span class="text-kirmizi">*</span>
            </label>
            <span class="font-veri text-xs text-kursun" id="baslik-sayac">{baslik.length} / 160</span>
          </div>
          <input
            type="text"
            name="baslik"
            id="baslik-girdi"
            required
            maxlength="160"
            value={baslik}
            class="alan-girdi alan-girdi--buyuk"
            placeholder="Örn: Silivri Selimpaşa'da Deniz Manzaralı Müstakil Havuzlu Lüks Villa"
          />
        </div>

        <!-- 3'lü Satır: Alt Tip, Vitrin Başlığı, Danışman -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="space-y-1.5">
            <label class="alan-etiket" for="secim-tip">
              MÜLK TİPİ (ALT KATEGORİ) <span class="text-kirmizi">*</span>
            </label>
            <select name="tip" id="secim-tip" required class="alan-secim">
              {(MULK_TIPLERI[aktifTipGrup] || MULK_TIPLERI.konut).map((t) => (
                <option value={t.deger} selected={guncelSatir.tip === t.deger}>{t.etiket}</option>
              ))}
            </select>
          </div>

          <div class="space-y-1.5">
            <label class="alan-etiket" for="kategori-girdi">VİTRİN KATEGORİ ETİKETİ</label>
            <input
              type="text"
              name="kategori"
              id="kategori-girdi"
              value={guncelSatir.kategori || ''}
              class="alan-girdi"
              placeholder="Örn: Satılık Villa veya Yatırımlık Tarla"
            />
          </div>

          <div class="space-y-1.5">
            <label class="alan-etiket" for="secim-danisman">SORUMLU DANIŞMAN</label>
            <select name="danisman_slug" id="secim-danisman" class="alan-secim">
              <option value="">Ofis Portföyü / Genel</option>
              {ekip.map((d) => (
                <option value={d.slug} selected={guncelSatir.danisman_slug === d.slug}>
                  {d.ad} ({d.unvan})
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="ayirici"></div>

        <!-- Fiyat ve Metrekare Bloğu -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
          <!-- Fiyat Alanı -->
          <div class="lg:col-span-5 space-y-1.5">
            <label class="alan-etiket" for="fiyat-girdi">
              FİYAT VE PARA BİRİMİ <span class="text-kirmizi">*</span>
            </label>
            <div class="fiyat-bilesik-kutu">
              <input
                type="number"
                name="fiyat"
                id="fiyat-girdi"
                required
                min="0"
                step="1"
                value={guncelSatir.fiyat || ''}
                placeholder="0"
                class="fiyat-girdi"
              />
              <select name="para_birimi" id="para-birimi-secim" class="fiyat-para-secici">
                {PARA_BIRIMLERI.map((p) => (
                  <option value={p.deger} selected={(guncelSatir.para_birimi || 'TRY') === p.deger}>
                    {p.etiket}
                  </option>
                ))}
              </select>
            </div>
            <div class="text-xs text-kursun font-veri pt-1" id="fiyat-okunus-metin">
              {guncelSatir.fiyat ? `${guncelSatir.fiyat.toLocaleString('tr-TR')} ${guncelSatir.para_birimi || 'TRY'}` : '0 ₺'}
            </div>
          </div>

          <!-- Metrekare Alanı -->
          <div class="lg:col-span-3 space-y-1.5">
            <label class="alan-etiket" for="ana-m2" id="etiket-ana-m2">
              {aktifTipGrup === 'arsa' ? 'PARSEL ALANI (m²)' : 'ALAN (m²)'} <span class="text-kirmizi">*</span>
            </label>
            <div class="relative">
              <input
                type="number"
                name="m2"
                id="ana-m2"
                required
                min="1"
                step="any"
                value={guncelSatir.m2 || ''}
                placeholder="Örn: 250"
                class="alan-girdi font-veri pr-10"
              />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-veri text-kursun pointer-events-none">m²</span>
            </div>
          </div>

          <!-- Canlı Metrik Göstergeleri -->
          <div class="lg:col-span-4 grid grid-cols-2 gap-3 pt-6 lg:pt-0">
            <div class="metrik-kutu">
              <span class="metrik-etiket">m² BİRİM FİYATI</span>
              <span class="metrik-deger font-veri text-murekkep" id="gosterge-birim-fiyat">—</span>
            </div>
            <div class="metrik-kutu" id="kutu-donum-fiyat" style={aktifTipGrup === 'arsa' ? 'display:flex' : 'display:none'}>
              <span class="metrik-etiket">DÖNÜM FİYATI</span>
              <span class="metrik-deger font-veri text-kirmizi" id="gosterge-donum-fiyat">—</span>
            </div>
          </div>
        </div>

        <!-- Finansal Ek Koşullar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
          <div class="space-y-1">
            <label class="alan-etiket">KREDİYE UYGUNLUK</label>
            <select name="kredi_uygunluk" class="alan-secim text-xs">
              {KREDI_UYGUNLUKLARI.map((k) => (
                <option value={k.deger} selected={degerAl('Krediye Uygunluk', 'kredi_uygunluk') === k.deger}>
                  {k.etiket}
                </option>
              ))}
            </select>
          </div>
          <div class="space-y-1">
            <label class="alan-etiket">TAKAS DURUMU</label>
            <select name="takas" class="alan-secim text-xs">
              {TAKAS_DURUMLARI.map((t) => (
                <option value={t.deger} selected={degerAl('Takas', 'takas') === t.deger}>
                  {t.etiket}
                </option>
              ))}
            </select>
          </div>
          <div class="space-y-1">
            <label class="alan-etiket">PAZARLIK PAYI</label>
            <select name="pazarlik" class="alan-secim text-xs">
              {PAZARLIK_DURUMLARI.map((p) => (
                <option value={p.deger} selected={degerAl('Pazarlık', 'pazarlik') === p.deger}>
                  {p.etiket}
                </option>
              ))}
            </select>
          </div>
          <div class="space-y-1">
            <label class="alan-etiket">TAHMİNİ KİRA GETİRİSİ</label>
            <input
              type="number"
              name="kira_getirisi"
              min="0"
              value={degerAl('Kira Getirisi', 'kira_getirisi').replace(/\D/g, '')}
              placeholder="₺ / Ay"
              class="alan-girdi font-veri text-xs"
            />
          </div>
        </div>

        <div class="ayirici"></div>

        <!-- Konum & Adres -->
        <div class="space-y-3">
          <div class="alan-etiket">KONUM BİLGİLERİ</div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="space-y-1">
              <label class="text-[0.6875rem] font-veri text-kursun uppercase">İL</label>
              <input type="text" name="il" required value={guncelSatir.il || 'İstanbul'} class="alan-girdi" />
            </div>
            <div class="space-y-1">
              <label class="text-[0.6875rem] font-veri text-kursun uppercase">İLÇE</label>
              <input type="text" name="ilce" required value={guncelSatir.ilce || 'Silivri'} class="alan-girdi" />
            </div>
            <div class="space-y-1">
              <label class="text-[0.6875rem] font-veri text-kursun uppercase">MAHALLE / MEVKİİ</label>
              <input
                type="text"
                name="mahalle"
                required
                value={guncelSatir.mahalle || ''}
                placeholder="Örn: Selimpaşa, Çanta, Alibey"
                class="alan-girdi"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ADIM 3: KATEGORİYE ÖZEL ŞABLON (DİNAMİK ALANLAR) -->
    
    <!-- 3.A: KONUT ŞABLONU -->
    <section class="kart sablon-bolumu" id="sablon-konut" style={aktifTipGrup === 'konut' ? 'display:block' : 'display:none'}>
      <div class="kart-ust">
        <div>
          <span class="kart-rozet kart-rozet--konut">KONUT ŞABLONU</span>
          <h2 class="kart-baslik">Mimari, Kat & Yaşam Parametreleri</h2>
          <p class="kart-alt">Daire, villa ve konutlara özgü teknik oda, bina ve kullanım özellikleri</p>
        </div>
      </div>

      <div class="kart-govde space-y-5">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          <div class="space-y-1.5">
            <label class="alan-etiket">ODA SAYISI</label>
            <select name="oda" class="alan-secim">
              <option value="">Seçiniz</option>
              {ODA_SECENEKLERI.map((o) => (
                <option value={o.deger} selected={(guncelSatir.oda || degerAl('Oda Sayısı', 'oda')) === o.deger}>{o.etiket}</option>
              ))}
            </select>
          </div>

          <div class="space-y-1.5">
            <label class="alan-etiket">SALON SAYISI</label>
            <select name="salon_sayisi" class="alan-secim">
              <option value="1" selected={degerAl('Salon Sayısı', 'salon_sayisi') === '1'}>1 Salon</option>
              <option value="2" selected={degerAl('Salon Sayısı', 'salon_sayisi') === '2'}>2 Salon</option>
              <option value="3+" selected={degerAl('Salon Sayısı', 'salon_sayisi') === '3+'}>3+ Salon</option>
              <option value="0" selected={degerAl('Salon Sayısı', 'salon_sayisi') === '0'}>Stüdyo / Salon Yok</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label class="alan-etiket">BULUNDUĞU KAT</label>
            <select name="bulundugu_kat" class="alan-secim">
              <option value="">Seçiniz</option>
              {KAT_SECENEKLERI.map((k) => (
                <option value={k.deger} selected={degerAl('Bulunduğu Kat', 'bulundugu_kat') === k.deger}>{k.etiket}</option>
              ))}
            </select>
          </div>

          <div class="space-y-1.5">
            <label class="alan-etiket">BİNA KAT SAYISI</label>
            <input
              type="number"
              name="kat_sayisi"
              min="1"
              max="100"
              value={degerAl('Kat Sayısı', 'kat_sayisi')}
              placeholder="Örn: 4"
              class="alan-girdi font-veri"
            />
          </div>

          <div class="space-y-1.5">
            <label class="alan-etiket">BİNA YAŞI</label>
            <select name="bina_yasi" class="alan-secim">
              <option value="">Seçiniz</option>
              {BINA_YASLARI.map((b) => (
