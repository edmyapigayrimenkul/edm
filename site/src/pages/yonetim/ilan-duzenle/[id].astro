---
import Panel from '../../../layouts/Panel.astro';
import { paneleGiris } from '../../../lib/panel/yetki';
import { env } from 'cloudflare:workers';
import { onbellegiTemizle, baslikTemizle } from '../../../lib/ilanlar';
import { icerik } from '../../../lib/icerik';
import { ilanSatiri, duzenlemeleriGetir, ilanKaydetVeyaGuncelle } from '../../../lib/senkron/depo';
import {
  ISLEM_TURLERI,
  TIP_GRUPLARI,
  MULK_TIPLERI,
  PARA_BIRIMLERI,
  PAZARLIK_DURUMLARI,
  TAKAS_DURUMLARI,
  KREDI_UYGUNLUKLARI,
  ODA_SECENEKLERI,
  BINA_YASLARI,
  KAT_SECENEKLERI,
  ISITMA_TIPLERI,
  BANYO_SAYILARI,
  BALKON_DURUMLARI,
  OTOPARK_DURUMLARI,
  ESYA_DURUMLARI,
  KULLANIM_DURUMLARI,
  TAPU_DURUMLARI,
  YAPI_DURUMLARI,
  YAPI_TIPLERI,
  IMAR_DURUMLARI,
  KAKS_EMSAL_SECENEKLERI,
  GABARI_SECENEKLERI,
  ARSA_YOL_DURUMLARI,
  ZEMIN_YAPILARI,
  DONANIM_KATALOGU,
  formdanIlanVerisi,
} from '../../../lib/ilan-bilgileri';

const giris = await paneleGiris(Astro.request);
if ('yanit' in giris) return giris.yanit;

const vt = env.VT as D1Database;
const id = Astro.params.id!;
const satir = await ilanSatiri(vt, id);

if (!satir) return Astro.rewrite('/404');

const { ekip } = await icerik();
const duzenlemeler = await duzenlemeleriGetir(vt);
const duz = duzenlemeler.get(id);

let bildirim: { tur: 'basari' | 'hata'; metin: string } | null = null;

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const veri = formdanIlanVerisi(form);

    if (!veri.baslik) throw new Error('İlan başlığı zorunludur.');
    if (!veri.fiyat) throw new Error('İlan fiyatı zorunludur.');

    await ilanKaydetVeyaGuncelle(vt, veri, id);
    onbellegiTemizle();

    bildirim = {
      tur: 'basari',
      metin: 'İlan başarıyla güncellendi. Değişiklikler sitede anında yayına alındı.',
    };
  } catch (hata) {
    bildirim = { tur: 'hata', metin: (hata as Error).message };
  }
}

// Güncel veriyi hazırla
const guncelSatir = (await ilanSatiri(vt, id)) ?? satir;
const guncelDuzenleme = (await duzenlemeleriGetir(vt)).get(id) ?? duz;

const guvenliJson = <T,>(m: string | null | undefined, v: T): T => {
  try {
    return m ? (JSON.parse(m) as T) : v;
  } catch {
    return v;
  }
};

const hamOz = guvenliJson<Record<string, string>>(guncelSatir.ozellikler, {});
const duzOz = guncelDuzenleme?.ozellikler
  ? guvenliJson<Record<string, string>>(guncelDuzenleme.ozellikler, {})
  : {};
const oz = { ...hamOz, ...duzOz };

const hamDonanim = guvenliJson<string[]>(guncelSatir.donanim ?? '[]', []);
const duzDonanim = guncelDuzenleme?.donanim
  ? guvenliJson<string[]>(guncelDuzenleme.donanim, [])
  : null;
const seciliDonanim = new Set(duzDonanim && duzDonanim.length ? duzDonanim : hamDonanim);

const gorsellerDizi = guvenliJson<string[]>(guncelSatir.gorseller, []);
const gorselMetin = gorsellerDizi.join('\n');

const baslik = guncelDuzenleme?.baslik ?? baslikTemizle(guncelSatir.baslik);
const aciklama = guncelDuzenleme?.aciklama ?? guncelSatir.aciklama;

// Sayısal temizleme yardımcıları
const sayiAl = (val?: string) => {
  if (!val) return '';
  const m = val.match(/\d+/);
  return m ? m[0] : '';
};
---

<Panel baslik={`İlan Düzenle: ${baslik}`} eposta={giris.kimlik.eposta} ozet={`İlan No: ${id} · Kaynak: ${satir.kaynak}`}>
  <div slot="eylem" class="flex items-center gap-3">
    <a href={`/yonetim/gorsel/${id}`} class="pd pd--birincil text-sm font-semibold flex items-center gap-1.5">
      <span>🖼️ Fotoğraf Sırası & Kapak</span>
    </a>
    <a href="/yonetim/ilanlar" class="pd pd--sade text-sm">← İlanlar</a>
    <button type="button" class="pd pd--kirmizi text-sm font-semibold" onclick="document.getElementById('duzenle-ilan-formu').requestSubmit()">
      Kaydet
    </button>
  </div>

  {bildirim && <div class={`bildirim bildirim--${bildirim.tur}`}>{bildirim.metin}</div>}

  <!-- Yapışkan Hızlı Gezinme Çubuğu -->
  <nav class="form-hizli-gezinti" aria-label="Form bölümleri">
    <a href="#bolum-kategori" class="hizli-sekme aktif">01. Kategori & Mülk</a>
    <a href="#bolum-fiyat" class="hizli-sekme">02. Fiyat & Finans</a>
    <a href="#bolum-konum" class="hizli-sekme">03. Konum & Kadastro</a>
    <a href="#bolum-teknik" class="hizli-sekme">04. Teknik Künye</a>
    <a href="#bolum-donanim" class="hizli-sekme">05. Donanım ({seciliDonanim.size} Seçili)</a>
    <a href="#bolum-medya" class="hizli-sekme">06. Medya & Portallar</a>
    <a href="#bolum-aciklama" class="hizli-sekme">07. Açıklama</a>
  </nav>

  <form method="POST" id="duzenle-ilan-formu" class="ilan-form-alani">
    <!-- 1. KATEGORİ VE MÜLK TÜRÜ (LÜKS GÖRSEL SEÇİCİ) -->
    <section id="bolum-kategori" class="kutu form-kart-premium">
      <div class="kutu-bas">
        <div>
          <span class="bolum-rozet">BÖLÜM 01</span>
          <h2 class="baslik-kutu">Kategori & Temel Bilgiler</h2>
        </div>
        <span class="kutu-alt-not">Mülk grubu ve temel vitrin başlığı</span>
      </div>

      <!-- Büyük Görsel Kategori Seçim Kartları -->
      <div class="kategori-kart-izgara mt-4">
        <label class:list={['kategori-kart', guncelSatir.tip_grup === 'konut' && 'aktif']} data-grup="konut">
          <input type="radio" name="tip_grup" value="konut" checked={guncelSatir.tip_grup === 'konut'} class="sr-only" />
          <div class="kategori-ikon">🏠</div>
          <div class="kategori-bilgi">
            <span class="kategori-ad">Konut</span>
            <span class="kategori-aciklama">Daire, Villa, Müstakil, Yazlık</span>
          </div>
          <span class="kategori-isaret">✓</span>
        </label>

        <label class:list={['kategori-kart', guncelSatir.tip_grup === 'arsa' && 'aktif']} data-grup="arsa">
          <input type="radio" name="tip_grup" value="arsa" checked={guncelSatir.tip_grup === 'arsa'} class="sr-only" />
          <div class="kategori-ikon">🌾</div>
          <div class="kategori-bilgi">
            <span class="kategori-ad">Arsa & Tarla</span>
            <span class="kategori-aciklama">İmarlı Arsa, Tarla, Bahçe, Çiftlik</span>
          </div>
          <span class="kategori-isaret">✓</span>
        </label>

        <label class:list={['kategori-kart', guncelSatir.tip_grup === 'isyeri' && 'aktif']} data-grup="isyeri">
          <input type="radio" name="tip_grup" value="isyeri" checked={guncelSatir.tip_grup === 'isyeri'} class="sr-only" />
          <div class="kategori-ikon">🏢</div>
          <div class="kategori-bilgi">
            <span class="kategori-ad">İş Yeri & Ticari</span>
            <span class="kategori-aciklama">Dükkan, Ofis, Mağaza, Depo, Fabrika</span>
          </div>
          <span class="kategori-isaret">✓</span>
        </label>

        <label class:list={['kategori-kart', guncelSatir.tip_grup === 'diger' && 'aktif']} data-grup="diger">
          <input type="radio" name="tip_grup" value="diger" checked={guncelSatir.tip_grup === 'diger'} class="sr-only" />
          <div class="kategori-ikon">🏗️</div>
          <div class="kategori-bilgi">
            <span class="kategori-ad">Diğer & Proje</span>
            <span class="kategori-aciklama">Turistik Tesis, Bina, Özel Mülk</span>
          </div>
          <span class="kategori-isaret">✓</span>
        </label>
      </div>

      <div class="p-izgara mt-6">
        <label class="p-alan col-span-full">
          <span>İlan Başlığı *</span>
          <input
            type="text"
            name="baslik"
            id="baslik-girdi"
            required
            maxlength="160"
            value={baslik}
            class="vurgulu-girdi"
            placeholder="Örn: Silivri Mimar Sinan'da Deniz Manzaralı Geniş 3+1 Daire"
          />
        </label>

        <!-- İşlem Türü -->
        <div class="p-alan col-span-full">
          <span>İşlem Türü *</span>
          <div class="islem-segment-izgara">
            {ISLEM_TURLERI.map((islem) => (
              <label class:list={['islem-segment-kart', guncelSatir.islem === islem.deger && 'aktif']}>
                <input
                  type="radio"
                  name="islem"
                  value={islem.deger}
                  checked={guncelSatir.islem === islem.deger}
                  class="sr-only"
                />
                <span class="segment-etiket">{islem.etiket}</span>
              </label>
            ))}
          </div>
        </div>

        <label class="p-alan md:col-span-2">
          <span>Mülk Tipi (Alt Kategori) *</span>
          <select name="tip" id="secim-tip" required class="secim-kutusu">
            {(MULK_TIPLERI[guncelSatir.tip_grup] || MULK_TIPLERI.konut).map((t) => (
              <option value={t.deger} selected={t.deger === guncelSatir.tip}>
                {t.etiket}
              </option>
            ))}
          </select>
        </label>

        <label class="p-alan md:col-span-2">
          <span>Kategori Başlığı (Otomatik / Vitrin)</span>
          <input type="text" name="kategori" value={guncelSatir.kategori} placeholder="Örn: Satılık Daire" />
        </label>

        <label class="p-alan md:col-span-2">
          <span>Portföy Sorumlusu Danışman</span>
          <select name="danisman_slug" class="secim-kutusu">
            <option value="">Ofis Ortak Portföyü</option>
            {ekip.map((d) => (
              <option
                value={d.emlakjetSlug || d.slug}
                selected={(d.emlakjetSlug && d.emlakjetSlug === guncelSatir.danisman_slug) || d.slug === guncelSatir.danisman_slug}
              >
                {d.ad} — {d.unvan}
              </option>
            ))}
          </select>
        </label>
      </div>
    </section>

    <!-- 2. FİYAT VE FİNANSAL KOŞULLAR -->
    <section id="bolum-fiyat" class="kutu form-kart-premium mt-8">
      <div class="kutu-bas">
        <div>
          <span class="bolum-rozet">BÖLÜM 02</span>
          <h2 class="baslik-kutu">Fiyat & Finansal Koşullar</h2>
        </div>
        <span class="kutu-alt-not">Fiyat, para birimi ve birim metrekare analizi</span>
      </div>

      <div class="fiyat-hesap-panosu mt-4">
        <div class="fiyat-ana-giris">
          <label class="p-alan">
            <span class="text-sm font-semibold text-murekkep">Satış / Kiralama Fiyatı *</span>
            <div class="fiyat-giris-sarmal">
              <input
                type="number"
                name="fiyat"
                id="fiyat-girdi"
                min="0"
                required
                inputmode="numeric"
                value={guncelSatir.fiyat ?? 0}
                class="fiyat-buyuk-girdi font-veri"
              />
              <select name="para_birimi" id="para-birimi-secim" class="para-birimi-secici font-veri">
                {PARA_BIRIMLERI.map((p) => (
                  <option value={p.deger} selected={p.deger === (guncelSatir.para_birimi || 'TRY')}>
                    {p.etiket}
                  </option>
                ))}
              </select>
            </div>
          </label>
          <p class="fiyat-okunus mt-1.5 font-veri text-xs text-kursun" id="fiyat-okunus-metin">0 TL</p>
        </div>

        <div class="fiyat-metrik-izgara">
          <div class="metrik-kutu">
            <span class="metrik-baslik">m² BİRİM FİYATI</span>
            <span class="metrik-deger font-veri text-kirmizi" id="gosterge-birim-fiyat">—</span>
            <span class="metrik-alt">Toplam m² girildiğinde hesaplanır</span>
          </div>

          <div class="metrik-kutu" id="donum-kutu" style={guncelSatir.tip_grup === 'arsa' ? 'display:flex' : 'display:none'}>
            <span class="metrik-baslik">DÖNÜM (1.000 m²) FİYATI</span>
            <span class="metrik-deger font-veri text-murekkep" id="gosterge-donum-fiyat">—</span>
            <span class="metrik-alt">Arsa & Tarla için referans</span>
          </div>
        </div>
      </div>

      <div class="p-izgara mt-6">
        <label class="p-alan">
          <span>Pazarlık Durumu</span>
          <select name="pazarlik" class="secim-kutusu">
            {PAZARLIK_DURUMLARI.map((p) => (
              <option value={p.deger} selected={p.deger === oz.pazarlik}>{p.etiket}</option>
            ))}
          </select>
        </label>

        <label class="p-alan">
          <span>Takas Durumu</span>
          <select name="takas" class="secim-kutusu">
            {TAKAS_DURUMLARI.map((t) => (
              <option value={t.deger} selected={t.deger === oz.takas}>{t.etiket}</option>
            ))}
          </select>
        </label>

        <label class="p-alan">
          <span>Krediye Uygunluk</span>
          <select name="kredi_uygunluk" class="secim-kutusu">
            {KREDI_UYGUNLUKLARI.map((k) => (
              <option value={k.deger} selected={k.deger === oz.kredi_uygunluk}>{k.etiket}</option>
            ))}
          </select>
        </label>

        <label class="p-alan">
          <span>Tahmini / Mevcut Kira Getirisi (₺ / ay)</span>
          <input type="number" name="kira_getirisi" min="0" value={sayiAl(oz.kira_getirisi)} placeholder="Örn: 25000" />
        </label>

        <label class="p-alan">
          <span>Aidat Tutarı (₺ / ay)</span>
          <input type="number" name="aidat" min="0" value={sayiAl(oz.aidat)} placeholder="Örn: 750" />
        </label>

        <label class="p-alan">
          <span>Depozito (₺ - Kiralık İse)</span>
          <input type="number" name="depozito" min="0" value={sayiAl(oz.depozito)} placeholder="Örn: 30000" />
        </label>
      </div>
    </section>

    <!-- 3. KONUM VE RESMİ KADASTRO -->
    <section id="bolum-konum" class="kutu form-kart-premium mt-8">
      <div class="kutu-bas">
        <div>
          <span class="bolum-rozet">BÖLÜM 03</span>
          <h2 class="baslik-kutu">Konum & Kadastro / Parsel Bilgisi</h2>
        </div>
        <span class="kutu-alt-not">Ada, parsel ve harita koordinatları</span>
      </div>

      <div class="p-izgara mt-4">
        <label class="p-alan">
          <span>İl *</span>
          <input type="text" name="il" required value={guncelSatir.il || 'İstanbul'} class="font-medium" />
        </label>

        <label class="p-alan">
          <span>İlçe *</span>
          <input type="text" name="ilce" required value={guncelSatir.ilce || 'Silivri'} class="font-medium" />
        </label>

        <label class="p-alan">
          <span>Mahalle / Köy *</span>
          <input type="text" name="mahalle" required value={guncelSatir.mahalle || ''} />
        </label>

        <label class="p-alan">
          <span>Cadde / Sokak / Mevkii</span>
          <input type="text" name="mevkii" value={oz.mevkii || ''} />
        </label>
      </div>

      <div class="kadastro-form-kutusu mt-6">
        <div class="kadastro-baslik-serit">
          <div class="flex items-center gap-2">
            <span class="text-lg">📍</span>
            <span class="font-semibold text-sm text-murekkep">Resmi Kadastro Referansı (TKGM)</span>
          </div>
          <a href="https://parselsorgu.tkgm.gov.tr/" target="_blank" rel="noopener noreferrer" class="text-xs text-kirmizi hover:underline font-medium">
            TKGM Parsel Sorgu Ekranını Aç ↗
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-3">
          <label class="p-alan">
            <span class="text-xs font-semibold text-kursun">Ada No</span>
            <input type="text" name="ada" value={oz.ada || ''} placeholder="Örn: 104" class="font-veri text-base" />
          </label>

          <label class="p-alan">
            <span class="text-xs font-semibold text-kursun">Parsel No</span>
            <input type="text" name="parsel" value={oz.parsel || ''} placeholder="Örn: 18" class="font-veri text-base" />
          </label>

          <label class="p-alan">
            <span class="text-xs font-semibold text-kursun">Pafta No</span>
            <input type="text" name="pafta" value={oz.pafta || ''} placeholder="Örn: F21D12" class="font-veri text-base" />
          </label>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4 pt-4 border-t border-murekkep/10">
          <label class="p-alan">
            <span class="text-xs text-kursun">Harita Enlem (Latitude)</span>
            <input type="text" name="enlem" value={oz.enlem || ''} placeholder="41.074" class="font-veri text-xs" />
          </label>
          <label class="p-alan">
            <span class="text-xs text-kursun">Harita Boylam (Longitude)</span>
            <input type="text" name="boylam" value={oz.boylam || ''} placeholder="28.247" class="font-veri text-xs" />
          </label>
        </div>
      </div>
    </section>

    <!-- 4. MÜLK TEKNİK KÜNYESİ -->
    <section id="bolum-teknik" class="kutu form-kart-premium mt-8">
      <div class="kutu-bas">
        <div>
          <span class="bolum-rozet">BÖLÜM 04</span>
          <h2 class="baslik-kutu">Mülk Teknik Künyesi & Alan Ölçüleri</h2>
        </div>
        <span class="kutu-alt-not">M² ölçüleri, bina detayları veya imar kriterleri</span>
      </div>

      <!-- Ana m2 Girdisi -->
      <div class="ana-m2-serit mt-4">
        <label class="p-alan max-w-sm">
          <span class="text-sm font-semibold text-murekkep">Ana Metrekare (m²) *</span>
          <div class="relative">
            <input
              type="number"
              name="m2"
              id="ana-m2"
              min="1"
              required
              value={guncelSatir.m2 ?? ''}
              class="font-veri text-xl font-bold py-2.5 px-3.5 pr-12 w-full border border-murekkep/20 rounded-md"
              placeholder="120"
            />
            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-sm text-kursun font-veri">m²</span>
          </div>
        </label>
      </div>

      <!-- 4.A KONUT ÖZEL KÜNYESİ -->
      <div id="alanlar-konut" class="kategori-bolumu p-izgara mt-6 pt-6 border-t border-murekkep/10" style={guncelSatir.tip_grup === 'konut' ? 'display:grid' : 'display:none'}>
        <label class="p-alan">
          <span>Brüt Metrekare</span>
          <input type="number" name="m2_brut" min="1" value={sayiAl(oz.m2_brut) || guncelSatir.m2 || ''} />
        </label>

        <label class="p-alan">
          <span>Net Metrekare</span>
          <input type="number" name="m2_net" min="1" value={sayiAl(oz.m2_net) || ''} />
        </label>

        <label class="p-alan">
          <span>Açık Alan / Bahçe m²</span>
          <input type="number" name="m2_acik" min="0" value={sayiAl(oz.m2_acik) || ''} />
        </label>

        <label class="p-alan">
          <span>Oda Sayısı</span>
          <select name="oda" class="secim-kutusu">
            <option value="">Seçiniz</option>
            {ODA_SECENEKLERI.map((o) => (
              <option value={o.deger} selected={o.deger === (guncelSatir.oda || oz.oda)}>{o.etiket}</option>
            ))}
          </select>
        </label>

        <label class="p-alan">
          <span>Salon Sayısı</span>
          <select name="salon_sayisi" class="secim-kutusu">
            <option value="1" selected={oz.salon_sayisi === '1'}>1 Salon</option>
            <option value="2" selected={oz.salon_sayisi === '2'}>2 Salon</option>
            <option value="3" selected={oz.salon_sayisi === '3'}>3+ Salon</option>
          </select>
        </label>

        <label class="p-alan">
          <span>Bina Yaşı</span>
          <select name="bina_yasi" class="secim-kutusu">
            <option value="">Seçiniz</option>
            {BINA_YASLARI.map((b) => (
              <option value={b.deger} selected={b.deger === oz.bina_yasi || b.etiket === oz.bina_yasi}>{b.etiket}</option>
            ))}
          </select>
        </label>

        <label class="p-alan">
          <span>Bulunduğu Kat</span>
          <select name="bulundugu_kat" class="secim-kutusu">
            <option value="">Seçiniz</option>
            {KAT_SECENEKLERI.map((k) => (
              <option value={k.deger} selected={k.deger === oz.bulundugu_kat || k.etiket === oz.bulundugu_kat}>{k.etiket}</option>
            ))}
          </select>
        </label>

        <label class="p-alan">
          <span>Binadaki Kat Sayısı</span>
          <input type="number" name="kat_sayisi" min="1" max="60" value={sayiAl(oz.kat_sayisi)} />
        </label>

        <label class="p-alan">
          <span>Isıtma Tipi</span>
          <select name="isitma_tipi" class="secim-kutusu">
