<script is:inline define:vars={{ mulkTipleri: MULK_TIPLERI }}>
  const kategoriKartlari = document.querySelectorAll('.kategori-kart');
  const tipSelect = document.getElementById('secim-tip');
  const alanKonut = document.getElementById('alanlar-konut');
  const alanArsa = document.getElementById('alanlar-arsa');
  const alanIsyeri = document.getElementById('alanlar-isyeri');
  const donumKutu = document.getElementById('donum-kutu');
  const sabitGrupRozet = document.getElementById('sabit-grup-rozet');

  function grupSec(secilenGrup) {
    kategoriKartlari.forEach((k) => {
      const radio = k.querySelector('input[type="radio"]');
      if (radio.value === secilenGrup) {
        radio.checked = true;
        k.classList.add('aktif');
      } else {
        k.classList.remove('aktif');
      }
    });

    if (secilenGrup === 'arsa') {
      alanKonut.style.display = 'none';
      alanArsa.style.display = 'grid';
      alanIsyeri.style.display = 'none';
      donumKutu.style.display = 'flex';
      sabitGrupRozet.textContent = 'Arsa & Tarla';
    } else if (secilenGrup === 'isyeri') {
      alanKonut.style.display = 'none';
      alanArsa.style.display = 'none';
      alanIsyeri.style.display = 'grid';
      donumKutu.style.display = 'none';
      sabitGrupRozet.textContent = 'İş Yeri';
    } else {
      alanKonut.style.display = 'grid';
      alanArsa.style.display = 'none';
      alanIsyeri.style.display = 'none';
      donumKutu.style.display = 'none';
      sabitGrupRozet.textContent = secilenGrup === 'diger' ? 'Proje / Diğer' : 'Konut';
    }

    birimFiyatHesapla();
  }

  kategoriKartlari.forEach((kart) => {
    kart.addEventListener('click', () => {
      const grup = kart.getAttribute('data-grup');
      if (grup) grupSec(grup);
    });
  });

  const islemKartlari = document.querySelectorAll('.islem-segment-kart');
  islemKartlari.forEach((kart) => {
    kart.addEventListener('click', () => {
      islemKartlari.forEach((k) => k.classList.remove('aktif'));
      kart.classList.add('aktif');
    });
  });

  const fiyatGirdi = document.getElementById('fiyat-girdi');
  const paraBirimiSecici = document.getElementById('para-birimi-secim');
  const m2Girdi = document.getElementById('ana-m2');
  const gostergeBirim = document.getElementById('gosterge-birim-fiyat');
  const gostergeDonum = document.getElementById('gosterge-donum-fiyat');
  const fiyatOkunusMetin = document.getElementById('fiyat-okunus-metin');
  const sabitFiyatGosterge = document.getElementById('sabit-fiyat-gosterge');
  const baslikGirdi = document.getElementById('baslik-girdi');
  const sabitBaslikGosterge = document.getElementById('sabit-baslik-gosterge');

  baslikGirdi.addEventListener('input', (e) => {
    sabitBaslikGosterge.textContent = e.target.value.trim() || 'İlan Başlığı';
  });

  function birimFiyatHesapla() {
    const fiyat = Number(fiyatGirdi.value) || 0;
    const m2 = Number(m2Girdi.value) || 0;
    const para = paraBirimiSecici.value || 'TRY';
    const sembol = para === 'USD' ? '$' : para === 'EUR' ? '€' : para === 'GBP' ? '£' : '₺';

    if (fiyat > 0) {
      fiyatOkunusMetin.textContent = `${fiyat.toLocaleString('tr-TR')} ${para}`;
      sabitFiyatGosterge.textContent = `${fiyat.toLocaleString('tr-TR')} ${sembol}`;
    }

    if (fiyat > 0 && m2 > 0) {
      const birim = Math.round(fiyat / m2);
      gostergeBirim.textContent = `${birim.toLocaleString('tr-TR')} ${sembol} / m²`;

      const donumFiyati = Math.round((fiyat / m2) * 1000);
      gostergeDonum.textContent = `${donumFiyati.toLocaleString('tr-TR')} ${sembol} / Dönüm`;
    } else {
      gostergeBirim.textContent = '—';
      gostergeDonum.textContent = '—';
    }
  }

  fiyatGirdi.addEventListener('input', birimFiyatHesapla);
  paraBirimiSecici.addEventListener('change', birimFiyatHesapla);
  m2Girdi.addEventListener('input', birimFiyatHesapla);
  birimFiyatHesapla();

  const cipler = document.querySelectorAll('.luks-cip');
  const donanimSayac = document.getElementById('donanim-sayac');
  const donanimAra = document.getElementById('donanim-ara');
  const grupTablari = document.querySelectorAll('.tab-dugme');
  const grupKutulari = document.querySelectorAll('.donanim-grup-kutu');
  const donanimSifirla = document.getElementById('donanim-sifirla');

  function sayaciGuncelle() {
    const seciliSayisi = document.querySelectorAll('.cip-checkbox:checked').length;
    donanimSayac.textContent = `${seciliSayisi} özellik seçildi`;
  }

  cipler.forEach((cip) => {
    const cb = cip.querySelector('.cip-checkbox');
    cip.addEventListener('click', () => {
      setTimeout(() => {
        if (cb.checked) {
          cip.classList.add('secili');
        } else {
          cip.classList.remove('secili');
        }
        sayaciGuncelle();
      }, 10);
    });
  });

  donanimSifirla.addEventListener('click', () => {
    document.querySelectorAll('.cip-checkbox').forEach((cb) => {
      cb.checked = false;
    });
    cipler.forEach((c) => c.classList.remove('secili'));
    sayaciGuncelle();
  });

  donanimAra.addEventListener('input', (e) => {
    const aranan = e.target.value.toLocaleLowerCase('tr').trim();
    cipler.forEach((cip) => {
      const metin = cip.getAttribute('data-metin') || '';
      if (!aranan || metin.includes(aranan)) {
        cip.style.display = 'inline-flex';
      } else {
        cip.style.display = 'none';
      }
    });
  });

  grupTablari.forEach((tab) => {
    tab.addEventListener('click', () => {
      grupTablari.forEach((t) => t.classList.remove('aktif'));
      tab.classList.add('aktif');
      const filtre = tab.getAttribute('data-filtre');

      grupKutulari.forEach((kutu) => {
        if (filtre === 'hepsi' || kutu.getAttribute('data-grup') === filtre) {
          kutu.style.display = 'block';
        } else {
          kutu.style.display = 'none';
        }
      });
    });
  });

  const aciklamaAlani = document.getElementById('aciklama-alani');
  const kelimeSayac = document.getElementById('kelime-sayac');
  function sayacGuncelle() {
    const val = aciklamaAlani.value.trim();
    const kelimeler = val ? val.split(/\s+/).length : 0;
    kelimeSayac.textContent = `${kelimeler} kelime · ${val.length} karakter`;
  }
  aciklamaAlani.addEventListener('input', sayacGuncelle);
  sayacGuncelle();
</script>

