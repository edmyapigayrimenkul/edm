                <span class="text-[0.6875rem] text-kursun/80">({grup.ogeListesi.length} özellik)</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 mt-3">
                {grup.ogeListesi.map((oge) => {
                  const seciliMi = seciliDonanim.has(oge);
                  return (
                    <label class:list={['donanim-satir', seciliMi && 'secili']} data-metin={oge.toLocaleLowerCase('tr')}>
                      <input type="checkbox" name="donanim" value={oge} checked={seciliMi} class="sr-only cip-checkbox" />
                      <span class="donanim-kare">
