---
/**
 * Bir ilanın fotoğraflarını düzenleme ekranı.
 *
 * Sıralama ve gizleme ayrı bir tabloda tutuluyor; portaldan gelen fotoğraf
 * listesine dokunulmuyor. Yeni fotoğraf eklendiğinde düzen bozulmadan
 * listenin sonuna ekleniyor, silinmiş fotoğraf da kendiliğinden düşüyor.
 */
import Panel from '../../../layouts/Panel.astro';
import { paneleGiris } from '../../../lib/panel/yetki';
import { env } from 'cloudflare:workers';
import { onbellegiTemizle, baslikTemizle, slugla } from '../../../lib/ilanlar';

const giris = await paneleGiris(Astro.request);
if ('yanit' in giris) return giris.yanit;

const vt = env.VT as D1Database;
const id = Astro.params.id!;
let bildirim: { tur: 'basari' | 'hata'; metin: string } | null = null;

const guvenliJson = <T,>(m: string | null, v: T): T => {
  try {
    return m ? (JSON.parse(m) as T) : v;
  } catch {
    return v;
  }
};

async function duzeniOku() {
  return await vt
    .prepare(`SELECT sira, gizli FROM ilan_gorsel_duzen WHERE ilan_id = ?`)
    .bind(id)
    .first<{ sira: string; gizli: string }>();
}

async function duzeniYaz(sira: string[], gizli: string[]) {
  await vt
    .prepare(
      `INSERT INTO ilan_gorsel_duzen (ilan_id, sira, gizli, guncelleme) VALUES (?,?,?,?)
       ON CONFLICT(ilan_id) DO UPDATE SET
         sira = excluded.sira, gizli = excluded.gizli, guncelleme = excluded.guncelleme`
    )
    .bind(id, JSON.stringify(sira), JSON.stringify(gizli), new Date().toISOString())
    .run();
  onbellegiTemizle();
}

const ilan = await vt
  .prepare(
    `SELECT id, baslik, gorseller, hepsiemlak_gorseller, kaynak FROM ilanlar WHERE id = ?`
  )
  .bind(id)
  .first<{
    id: string;
    baslik: string;
    gorseller: string;
    hepsiemlak_gorseller: string | null;
    kaynak: string;
  }>();

if (!ilan) return Astro.rewrite('/404');

const yuklenenler = await vt
  .prepare(
    `SELECT anahtar, sira, boyut, genislik, yukseklik, yuklenme
     FROM ilan_foto WHERE ilan_id = ? ORDER BY sira ASC`
  )
  .bind(id)
  .all<{
    anahtar: string;
    sira: number;
    boyut: number | null;
    genislik: number | null;
    yukseklik: number | null;
    yuklenme: string;
  }>()
  .catch(() => ({ results: [] as never[] }));

const yuklenenAdresler = (yuklenenler.results ?? []).map((y) => `/g/${y.anahtar}`);

const hepsiemlak = guvenliJson<string[]>(ilan.hepsiemlak_gorseller, []);
const emlakjet = guvenliJson<string[]>(ilan.gorseller, []);
const portalGorselleri = hepsiemlak.length ? hepsiemlak : emlakjet;
const tumGorseller = [...yuklenenAdresler, ...portalGorselleri];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const eylem = String(form.get('eylem') ?? '');
  const hedef = String(form.get('gorsel') ?? '');

  const mevcut = await duzeniOku();
  let sira = guvenliJson<string[]>(mevcut?.sira ?? null, []);
  let gizli = guvenliJson<string[]>(mevcut?.gizli ?? null, []);

  // Sıra listesi boşsa mevcut düzenle başlat ki taşıma işlemleri anlamlı olsun.
  if (!sira.length) sira = tumGorseller.filter((g) => !gizli.includes(g));

  const yer = sira.indexOf(hedef);

  if (eylem === 'kapak' && yer > -1) {
    sira.splice(yer, 1);
    sira.unshift(hedef);
    bildirim = { tur: 'basari', metin: 'Kapak fotoğrafı değişti.' };
  } else if (eylem === 'sola' && yer > 0) {
    [sira[yer - 1], sira[yer]] = [sira[yer], sira[yer - 1]];
    bildirim = { tur: 'basari', metin: 'Sıra güncellendi.' };
  } else if (eylem === 'saga' && yer > -1 && yer < sira.length - 1) {
    [sira[yer + 1], sira[yer]] = [sira[yer], sira[yer + 1]];
    bildirim = { tur: 'basari', metin: 'Sıra güncellendi.' };
  } else if (eylem === 'gizle') {
    if (!gizli.includes(hedef)) gizli.push(hedef);
    sira = sira.filter((g) => g !== hedef);
    bildirim = { tur: 'basari', metin: 'Fotoğraf gizlendi.' };
  } else if (eylem === 'goster') {
    gizli = gizli.filter((g) => g !== hedef);
    if (!sira.includes(hedef)) sira.push(hedef);
    bildirim = { tur: 'basari', metin: 'Fotoğraf tekrar gösteriliyor.' };
  } else if (eylem === 'sifirla') {
    await vt.prepare(`DELETE FROM ilan_gorsel_duzen WHERE ilan_id = ?`).bind(id).run();
    onbellegiTemizle();
    bildirim = { tur: 'basari', metin: 'Düzen sıfırlandı, portaldaki sıraya döndü.' };
    sira = [];
    gizli = [];
  }

  if (eylem !== 'sifirla') await duzeniYaz(sira, gizli);
}

const duzen = await duzeniOku();
const sira = guvenliJson<string[]>(duzen?.sira ?? null, []);
const gizli = new Set(guvenliJson<string[]>(duzen?.gizli ?? null, []));

const siraNo = new Map(sira.map((g, i) => [g, i]));
const gorunur = tumGorseller
  .filter((g) => !gizli.has(g))
  .sort((a, b) => (siraNo.get(a) ?? 999) - (siraNo.get(b) ?? 999));
const gizlenenler = tumGorseller.filter((g) => gizli.has(g));

const baslik = baslikTemizle(ilan.baslik);
const yol = `/ilan/${slugla(baslik)}-${ilan.id}`;
---

<div data-ilan-id={id} hidden></div>

<Panel
  baslik="Fotoğraflar"
  eposta={giris.kimlik.eposta}
  ozet={baslik}
>
  <div slot="eylem" style="display:flex;gap:0.4rem">
    <a href={yol} target="_blank" rel="noopener" class="pd pd--sade">İlanı gör ↗</a>
    <a href="/yonetim/ilanlar" class="pd pd--sade">İlanlara dön</a>
  </div>

  {bildirim && <div class={`bildirim bildirim--${bildirim.tur}`}>{bildirim.metin}</div>}

  <p class="aciklama-kutu">
    İlk sıradaki fotoğraf <strong>kapak</strong> olur; kartlarda ve paylaşımlarda o görünür.
    Buradaki düzen portaldan gelen listeyi bozmaz — yeni fotoğraf eklendiğinde sona
    eklenir, silinen kendiliğinden düşer.
    {hepsiemlak.length > 0 && <> Bu ilanın fotoğrafları <strong>Hepsiemlak</strong>’tan geliyor.</>}
  </p>

  <div class="kutu">
    <div class="kutu-bas">
      <h2>Yayındaki fotoğraflar</h2>
      <div style="display:flex;gap:0.5rem;align-items:center">
        <span style="font-size:0.75rem;color:var(--color-kursun)">{gorunur.length} fotoğraf</span>
        <form method="POST" onsubmit="return confirm('Tüm düzenlemeler kaldırılıp portaldaki sıraya dönülecek. Emin misiniz?')">
          <input type="hidden" name="eylem" value="sifirla" />
          <button type="submit" class="pd pd--sade">Düzeni sıfırla</button>
        </form>
      </div>
    </div>

    {
      gorunur.length === 0 ? (
        <p class="bos">Bu ilanın gösterilecek fotoğrafı yok.</p>
      ) : (
        <div class="foto-izgara">
          {gorunur.map((g, i) => (
            <figure class:list={['foto', i === 0 && 'foto--kapak']}>
              <div class="foto-gorsel">
                <img src={g} alt={`Fotoğraf ${i + 1}`} loading="lazy" decoding="async" />
                {i === 0 && <span class="foto-rozet">Kapak</span>}
                <span class="foto-no veri-sayi">{i + 1}</span>
              </div>
              <figcaption class="foto-eylem">
                <form method="POST">
                  <input type="hidden" name="gorsel" value={g} />
                  <button type="submit" name="eylem" value="sola" class="pd pd--sade" disabled={i === 0} title="Öne al">
                    ←
                  </button>
                  <button type="submit" name="eylem" value="saga" class="pd pd--sade" disabled={i === gorunur.length - 1} title="Geri al">
                    →
                  </button>
                  {i !== 0 && (
                    <button type="submit" name="eylem" value="kapak" class="pd pd--birincil">
                      Kapak yap
                    </button>
                  )}
                  <button type="submit" name="eylem" value="gizle" class="pd pd--tehlike">
                    Gizle
                  </button>
                </form>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </div>

  <!-- Kendi fotoğraflarını yükle -->
  <section class="kutu" style="margin-top:1.5rem" id="yukle">
    <div class="kutu-bas">
      <h2>Kendi fotoğraflarını yükle</h2>
      <span style="font-size:0.75rem;color:var(--color-kursun)">
        {(yuklenenler.results ?? []).length} yüklenmiş
      </span>
    </div>

    <div class="yukle-govde">
      <p class="yukle-not">
        Yüklediğin fotoğraflar <strong>portaldan gelenlerin önüne geçer</strong> —
        tek bir iyi kapak yüklemek yeterli, kalan kareler portaldan gelmeye devam eder.
        Sildiğinde portal fotoğrafları kendiliğinden öne çıkar.
        <br />
        Fotoğraflar yüklenmeden önce tarayıcında küçültülüp WebP'ye çevriliyor;
        telefonundan çektiğin 5 MB'lık kare siteye 200 KB olarak iniyor.
      </p>

      <label class="birakma-alani" data-birakma>
        <input type="file" accept="image/*" multiple data-dosya-secici hidden />
        <span class="birakma-ikon" aria-hidden="true">↑</span>
        <span class="birakma-baslik">Fotoğrafları buraya sürükleyin</span>
        <span class="birakma-alt">ya da tıklayıp seçin · JPG, PNG, HEIC</span>
      </label>

      <div class="yukleme-durum" data-durum hidden></div>

      {(yuklenenler.results ?? []).length > 0 && (
        <div class="yuklenen-izgara">
          {(yuklenenler.results ?? []).map((y) => (
            <figure class="yuklenen">
              <img src={`/g/${y.anahtar}`} alt="Yüklenen fotoğraf" loading="lazy" />
              <figcaption>
                <span class="veri-sayi yuklenen-bilgi">
                  {y.genislik && y.yukseklik ? `${y.genislik}×${y.yukseklik}` : '—'}
                  {y.boyut ? ` · ${Math.round(y.boyut / 1024)} KB` : ''}
                </span>
                <button type="button" class="pd pd--tehlike" data-sil={y.anahtar}>
                  Sil
                </button>
              </figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  {
    gizlenenler.length > 0 && (
      <section class="kutu" style="margin-top:1.5rem">
        <div class="kutu-bas">
          <h2>Gizlenen fotoğraflar</h2>
          <span style="font-size:0.75rem;color:var(--color-kursun)">
            {gizlenenler.length} fotoğraf sitede görünmüyor
          </span>
        </div>
        <div class="foto-izgara">
          {gizlenenler.map((g) => (
            <figure class="foto foto--gizli">
              <div class="foto-gorsel">
                <img src={g} alt="Gizlenmiş fotoğraf" loading="lazy" decoding="async" />
              </div>
              <figcaption class="foto-eylem">
                <form method="POST">
                  <input type="hidden" name="gorsel" value={g} />
                  <button type="submit" name="eylem" value="goster" class="pd pd--sade">
                    Tekrar göster
                  </button>
                </form>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }
</Panel>

<style>
  .aciklama-kutu {
    background: #fff;
    border: 1px solid color-mix(in oklab, var(--color-murekkep) 10%, transparent);
    border-left: 3px solid var(--color-kirmizi);
    border-radius: 6px;
    padding: 0.85rem 1.1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-metin-2);
    margin-bottom: 1.25rem;
    max-width: 74ch;
  }

  .foto-izgara {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: 1rem;
    padding: 1.25rem;
  }
  .foto {
    margin: 0;
    border: 1px solid color-mix(in oklab, var(--color-murekkep) 12%, transparent);
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-kagit);
  }
  /* Kapak, kırmızı çerçeveyle ayrılıyor — sayıya bakmadan anlaşılsın */
  .foto--kapak {
    border-color: var(--color-kirmizi);
    box-shadow: 0 0 0 1px var(--color-kirmizi);
  }
  .foto--gizli {
    opacity: 0.55;
  }
  .foto--gizli img {
    filter: grayscale(1);
  }

  .foto-gorsel {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--color-kirec);
  }
  .foto-gorsel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .foto-rozet {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    background: var(--color-kirmizi);
    color: #fff;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.45rem;
    border-radius: 3px;
  }
  .foto-no {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    background: color-mix(in oklab, var(--color-murekkep) 72%, transparent);
    color: var(--color-kagit);
    font-size: 0.625rem;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
  }

  .foto-eylem form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    padding: 0.6rem;
  }
  .foto-eylem .pd {
    height: 1.85rem;
    padding-inline: 0.6rem;
    font-size: 0.75rem;
  }

  /* --- Yükleme --- */
  .yukle-govde {
    padding: 1.25rem;
  }
  .yukle-not {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-metin-2);
    max-width: 70ch;
    margin-bottom: 1.1rem;
  }
  .yukle-not strong {
    color: var(--color-murekkep);
  }

  .birakma-alani {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: clamp(1.75rem, 5vw, 3rem);
    border: 2px dashed color-mix(in oklab, var(--color-murekkep) 18%, transparent);
    border-radius: 8px;
    background: var(--color-kagit);
    cursor: pointer;
    text-align: center;
    transition: border-color 0.3s, background-color 0.3s;
  }
  .birakma-alani:hover,
  .birakma-alani[data-uzerinde] {
    border-color: var(--color-kirmizi);
    background: color-mix(in oklab, var(--color-kirmizi) 4%, var(--color-kagit));
  }
  .birakma-ikon {
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-kirmizi);
  }
  .birakma-baslik {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .birakma-alt {
    font-size: 0.8125rem;
    color: var(--color-kursun);
  }

  .yukleme-durum {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    background: var(--color-kagit);
    font-size: 0.875rem;
    display: grid;
    gap: 0.35rem;
  }
  .yukleme-satir {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-veri);
    font-size: 0.75rem;
    color: var(--color-metin-2);
  }

  .yuklenen-izgara {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(11rem, 100%), 1fr));
    gap: 0.85rem;
    margin-top: 1.25rem;
  }
  .yuklenen {
    margin: 0;
    border: 1px solid color-mix(in oklab, var(--color-kirmizi) 30%, transparent);
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-kagit);
  }
  .yuklenen img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .yuklenen figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.45rem 0.55rem;
  }
  .yuklenen-bilgi {
    font-size: 0.6875rem;
    color: var(--color-kursun);
  }
  .yuklenen .pd {
    height: 1.7rem;
    padding-inline: 0.55rem;
    font-size: 0.7rem;
  }
</style>

<script>
  const ILAN = document.querySelector<HTMLElement>('[data-ilan-id]')?.dataset.ilanId ?? '';
  const alan = document.querySelector<HTMLLabelElement>('[data-birakma]');
  const secici = document.querySelector<HTMLInputElement>('[data-dosya-secici]');
  const durum = document.querySelector<HTMLElement>('[data-durum]');

  /** Uzun kenarı bu değere indiriyoruz; ilan fotoğrafı için fazlasıyla yeterli. */
  const EN_UZUN = 1800;

  function bildir(metin: string, satirlar: string[] = []) {
    if (!durum) return;
    durum.hidden = false;
    durum.innerHTML = '';
    const bas = document.createElement('div');
    bas.textContent = metin;
    durum.appendChild(bas);
    for (const s of satirlar) {
      const d = document.createElement('div');
      d.className = 'yukleme-satir';
      d.textContent = s;
      durum.appendChild(d);
    }
  }

  /**
   * Fotoğrafı tarayıcıda küçültüp WebP'ye çevirir.
   * EXIF dönüşü createImageBitmap tarafından uygulanıyor, yan yatmış
   * telefon fotoğrafları düz iniyor.
   */
  async function kucult(dosya: File): Promise<{ blob: Blob; g: number; y: number } | null> {
    try {
      const kaynak = await createImageBitmap(dosya, { imageOrientation: 'from-image' });
      const oran = Math.min(1, EN_UZUN / Math.max(kaynak.width, kaynak.height));
      const g = Math.round(kaynak.width * oran);
      const y = Math.round(kaynak.height * oran);

      const tuval = document.createElement('canvas');
      tuval.width = g;
      tuval.height = y;
      const ctx = tuval.getContext('2d');
      if (!ctx) return null;
      ctx.drawImage(kaynak, 0, 0, g, y);
      kaynak.close();

      const blob = await new Promise<Blob | null>((coz) =>
        tuval.toBlob((b) => coz(b), 'image/webp', 0.82)
      );
      return blob ? { blob, g, y } : null;
    } catch {
      return null;
    }
  }

  async function yukle(dosyalar: File[]) {
    const gorseller = dosyalar.filter((d) => d.type.startsWith('image/'));
    if (!gorseller.length) return;

    bildir(`${gorseller.length} fotoğraf hazırlanıyor…`);

    const form = new FormData();
    form.append('ilan', ILAN);
    const satirlar: string[] = [];

    for (const dosya of gorseller) {
      const kucuk = await kucult(dosya);
      if (!kucuk) {
        satirlar.push(`${dosya.name} — okunamadı, atlandı`);
        continue;
      }
      const ad = `${dosya.name.replace(/\.[^.]+$/, '')}.webp`;
      form.append('dosya', new File([kucuk.blob], ad, { type: 'image/webp' }));
      form.append(`genislik-${ad}`, String(kucuk.g));
      form.append(`yukseklik-${ad}`, String(kucuk.y));
      satirlar.push(
        `${dosya.name} → ${kucuk.g}×${kucuk.y} · ` +
          `${Math.round(dosya.size / 1024)} KB → ${Math.round(kucuk.blob.size / 1024)} KB`
      );
      bildir(`${satirlar.length}/${gorseller.length} hazırlandı…`, satirlar);
    }

    bildir('Yükleniyor…', satirlar);

    try {
      const cevap = await fetch('/yonetim/api/foto', { method: 'POST', body: form });
      // Access oturumu 24 saatte bir düşüyor; o durumda JSON değil giriş
      // sayfası geliyor. Ham hatayı göstermek yerine ne yapılacağını söyle.
      const sonuc = await cevap.json().catch(() => ({
        hata: 'Oturum süresi dolmuş olabilir. Sayfayı yenileyip tekrar deneyin.',
      }));
      if (sonuc.tamam) {
        bildir(`${sonuc.eklenen} fotoğraf yüklendi. Sayfa yenileniyor…`, sonuc.atlanan ?? []);
        setTimeout(() => location.reload(), 900);
      } else {
        bildir(`Yükleme başarısız: ${sonuc.hata ?? 'bilinmiyor'}`);
      }
    } catch (hata) {
      bildir(`Yükleme başarısız: ${(hata as Error).message}`);
    }
  }

  alan?.addEventListener('click', () => secici?.click());
  secici?.addEventListener('change', () => {
    if (secici.files) yukle([...secici.files]);
  });

  for (const olay of ['dragenter', 'dragover']) {
    alan?.addEventListener(olay, (e) => {
      e.preventDefault();
      alan.dataset.uzerinde = 'evet';
    });
  }
  for (const olay of ['dragleave', 'drop']) {
    alan?.addEventListener(olay, (e) => {
      e.preventDefault();
      delete alan.dataset.uzerinde;
    });
  }
  alan?.addEventListener('drop', (e) => {
    const dosyalar = (e as DragEvent).dataTransfer?.files;
    if (dosyalar?.length) yukle([...dosyalar]);
  });

  // Silme
  document.querySelectorAll<HTMLButtonElement>('[data-sil]').forEach((d) =>
    d.addEventListener('click', async () => {
      if (!confirm('Bu fotoğraf kalıcı olarak silinecek. Emin misiniz?')) return;
      d.disabled = true;
      await fetch('/yonetim/api/foto', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ anahtar: d.dataset.sil }),
      });
      location.reload();
    })
  );
</script>
