<script>
  // Başarılı yeni ilan yönlendirmesi taslağın sahibidir; kayıttan sonra
  // yerel kopyayı bırakmak düzenleme ekranında sahte bir taslak uyarısı çıkarır.
  const kaydedilenElleIlanId = document.querySelector<HTMLElement>('[data-kaydedilen-elle-ilan]')?.dataset.kaydedilenElleIlan;
  if (kaydedilenElleIlanId) {
    try { localStorage.removeItem(`edm-ilan-formu:${kaydedilenElleIlanId}`); } catch { /* depolama kapalı olabilir */ }
  }

  // Seçim kutuları: toplu işlem çubuğunu yönetir
  const cubuk = document.querySelector<HTMLElement>('[data-toplu]');
  const sayac = document.querySelector<HTMLElement>('[data-toplu-sayi]');
  const hepsi = document.querySelector<HTMLInputElement>('[data-hepsi]');
  const kutular = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="secili"]')
  );

  function guncelle() {
    const secili = kutular.filter((k) => k.checked).length;
    if (cubuk) cubuk.hidden = secili === 0;
    if (sayac) sayac.textContent = String(secili);
    if (hepsi) {
      hepsi.checked = secili > 0 && secili === kutular.length;
      hepsi.indeterminate = secili > 0 && secili < kutular.length;
    }
  }

  kutular.forEach((k) => k.addEventListener('change', guncelle));
  hepsi?.addEventListener('change', () => {
    kutular.forEach((k) => (k.checked = hepsi.checked));
    guncelle();
  });
  guncelle();
</script>
