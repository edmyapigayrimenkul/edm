  }

  /* --- Toplu işlem --- */
  .toplu-cubuk {
    position: sticky;
    top: 0.75rem;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    justify-content: space-between;
    background: var(--color-murekkep);
