  .duzenle-yan {
    border-left: 1px solid color-mix(in oklab, var(--color-murekkep) 10%, transparent);
    padding-left: 1.25rem;
  }
  @media (max-width: 899px) {
    .duzenle-yan {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid color-mix(in oklab, var(--color-murekkep) 10%, transparent);
      padding-top: 1rem;
    }
  }
  .orijinal-baslik {
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0.35rem 0 0.85rem;
    color: var(--color-metin-2);
  }

  .ekle-form {
