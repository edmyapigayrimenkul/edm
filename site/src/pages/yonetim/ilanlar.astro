---
import Panel from '../../layouts/Panel.astro';
import { adminProfiliniBul, paneleGiris } from '../../lib/panel/yetki';
import { env } from 'cloudflare:workers';
import { semayiKur, tumIlanSatirlari } from '../../lib/senkron/depo';
import { onbellegiTemizle, baslikTemizle, slugla, fiyatKisa, portfoy } from '../../lib/ilanlar';
import { mukerrerKanonikId } from '../../lib/ilan-butunlugu';
import { icerik } from '../../lib/icerik';
import { ilanKalitesiniDenetle, kaliteOzeti } from '../../lib/ilan-kalite';
import { teyitKayitlariniGetir, teyitOzeti } from '../../lib/ilan-teyit';
import {
  hatirlatmalariGetir,
  elleIlaniKaliciSil,
  ilanYayinDurumuDegistir,
  paylasimKuyrugunaEkle,
  paylasimlariGetir,
  platformlariOku,
} from '../../lib/ilan-isletim';
import { islemKaydet } from '../../lib/panel/islem-gecmisi';
import { rolYetkisiGerekli } from '../../lib/panel/roller';

const giris = await paneleGiris(Astro.request);
if ('yanit' in giris) return giris.yanit;

const vt = env.VT as D1Database;
await semayiKur(vt);
const admin = adminProfiliniBul(giris.kimlik.eposta);
const kaydedilenElleIlanId = Astro.url.searchParams.get('eklendi')?.match(/^elle-[a-z0-9-]{6,34}$/i)?.[0] ?? '';
let bildirim: { tur: 'basari' | 'hata'; metin: string } | null = null;
if (Astro.url.searchParams.get('eklendi')) bildirim = { tur: 'basari', metin: 'Yeni ilan kaydedildi ve yayına alındı.' };
if (Astro.url.searchParams.get('paylasim')) bildirim = { tur: 'basari', metin: 'Yeni ilan kaydedildi; sosyal medya paylaşımı kuyruğa eklendi.' };
if (Astro.url.searchParams.get('silindi')) bildirim = { tur: 'basari', metin: 'Elle eklenen ilan kalıcı olarak silindi.' };

const suAn = () => new Date().toISOString();

/** ilan_duzenleme satırını oluşturur ya da tek alanını günceller. */
async function duzenlemeYaz(id: string, alan: string, deger: unknown) {
  await vt
    .prepare(
      `INSERT INTO ilan_duzenleme (ilan_id, ${alan}, guncelleme) VALUES (?,?,?)
       ON CONFLICT(ilan_id) DO UPDATE SET ${alan} = excluded.${alan}, guncelleme = excluded.guncelleme`
    )
    .bind(id, deger, suAn())
    .run();
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const eylem = String(form.get('eylem') ?? '');
  const id = String(form.get('id') ?? '');

  try {
    rolYetkisiGerekli(admin?.rol ?? null, eylem === 'elle-sil' ? 'kalici-sil' : 'ilan-yonet');
    if (eylem === 'one-cikar' && id) {
      const onceki = await vt.prepare(`SELECT one_cikan FROM ilan_duzenleme WHERE ilan_id = ?`).bind(id).first<{ one_cikan: number | null }>();
      const sonraki = Number(form.get('deger')) ? 1 : 0;
      await duzenlemeYaz(id, 'one_cikan', sonraki);
      await islemKaydet(vt, giris.kimlik, { eylem: 'ilan-one-cikarma', varlikTuru: 'ilan', varlikId: id, ozet: sonraki ? 'İlan öne çıkarıldı.' : 'İlanın öne çıkarması kaldırıldı.', onceki: { one_cikan: onceki?.one_cikan ?? 0 }, sonraki: { one_cikan: sonraki } });
      bildirim = { tur: 'basari', metin: 'Öne çıkarma güncellendi.' };
    } else if (eylem === 'durum' && id) {
      const yayinlansin = String(form.get('deger')) === 'aktif';
      const onceki = await vt.prepare(`SELECT i.durum, COALESCE(d.gizli, 0) AS gizli FROM ilanlar i LEFT JOIN ilan_duzenleme d ON d.ilan_id = i.id WHERE i.id = ?`).bind(id).first<{ durum: string; gizli: number }>();
      await ilanYayinDurumuDegistir(vt, id, yayinlansin);
      await islemKaydet(vt, giris.kimlik, { eylem: 'ilan-yayin-durumu', varlikTuru: 'ilan', varlikId: id, ozet: yayinlansin ? 'İlan yayına alındı.' : 'İlan pasife alındı.', onceki, sonraki: { yayin_durumu: yayinlansin ? 'aktif' : 'pasif' } });
      bildirim = { tur: 'basari', metin: yayinlansin ? 'İlan yayına alındı.' : 'İlan pasife alındı.' };
    } else if (eylem === 'paylas' && id) {
      const sonuc = await paylasimKuyrugunaEkle(vt, id, platformlariOku(form.getAll('sosyal_platform')), 'panel-listesi');
      await islemKaydet(vt, giris.kimlik, { eylem: 'ilan-paylasim-kuyrugu', varlikTuru: 'ilan', varlikId: id, ozet: `Sosyal medya paylaşımı #${sonuc.id} kuyruğa alındı.`, sonraki: { paylasim_id: sonuc.id, yeni: sonuc.yeni, platformlar: platformlariOku(form.getAll('sosyal_platform')) } });
      bildirim = { tur: 'basari', metin: sonuc.yeni ? `Paylaşım #${sonuc.id} kuyruğa eklendi.` : `Bu ilan için bekleyen paylaşım #${sonuc.id} zaten var.` };
    } else if (eylem === 'toplu') {
      const secilenler = form.getAll('secili').map(String).filter(Boolean);
      const islem = String(form.get('toplu-islem') ?? '');
      if (!secilenler.length) throw new Error('Hiç ilan seçilmedi.');

      if (islem.startsWith('durum-')) {
        const yayinlansin = islem === 'durum-aktif';
        if (yayinlansin) {
          const yerler = secilenler.map(() => '?').join(',');
          const kapaliPortal = await vt
            .prepare(`SELECT COUNT(*) AS adet FROM ilanlar WHERE id IN (${yerler}) AND kaynak <> 'elle' AND durum <> 'aktif'`)
            .bind(...secilenler)
            .first<{ adet: number }>();
          if ((kapaliPortal?.adet ?? 0) > 0) throw new Error('Seçimde kaynakta pasif portal ilanı var; bu ilan portal geri gelmeden açılamaz.');
        }
        for (const sid of secilenler) await ilanYayinDurumuDegistir(vt, sid, yayinlansin);
      } else {
        const deger = islem.endsWith('-ac') ? 1 : 0;
        await vt.batch(secilenler.map((sid) => vt
          .prepare(
            `INSERT INTO ilan_duzenleme (ilan_id, one_cikan, guncelleme) VALUES (?,?,?)
             ON CONFLICT(ilan_id) DO UPDATE SET one_cikan = excluded.one_cikan, guncelleme = excluded.guncelleme`
          )
          .bind(sid, deger, suAn())));
      }

      const adlar: Record<string, string> = {
        'one-ac': 'öne çıkarıldı',
        'one-kapat': 'öne çıkarma kaldırıldı',
        'durum-pasif': 'pasife alındı',
        'durum-aktif': 'yayına alındı',
      };
      bildirim = {
        tur: 'basari',
        metin: `${secilenler.length} ilan ${adlar[islem] ?? 'güncellendi'}.`,
      };
      await islemKaydet(vt, giris.kimlik, { eylem: 'ilan-toplu-islem', varlikTuru: 'ilan', varlikId: secilenler.join(','), ozet: bildirim.metin, sonraki: { islem, ilanlar: secilenler } });
    } else if (eylem === 'elle-sil' && id.startsWith('elle-')) {
      const onceki = await vt.prepare(`SELECT id, baslik, durum, kaynak FROM ilanlar WHERE id = ?`).bind(id).first<Record<string, unknown>>();
      const kova = (env as Record<string, unknown>).GORSELLER as R2Bucket | undefined;
      await elleIlaniKaliciSil(vt, kova, id);
      await islemKaydet(vt, giris.kimlik, { eylem: 'ilan-kalici-silindi', varlikTuru: 'ilan', varlikId: id, ozet: `${String(onceki?.baslik ?? id)} kalıcı olarak silindi.`, onceki });
      bildirim = { tur: 'basari', metin: 'Elle eklenen ilan silindi.' };
    }
    onbellegiTemizle();
  } catch (hata) {
    bildirim = { tur: 'hata', metin: (hata as Error).message };
  }
}

const ilanlar = await tumIlanSatirlari(vt);
const [{ ilanlar: yayinIlanlari }, { ekip }] = await Promise.all([portfoy(), icerik()]);
const bilinenDanismanlar = new Set(ekip.flatMap((danisman) => [danisman.slug, danisman.emlakjetSlug]).filter(Boolean));
const kaliteKayitlari = yayinIlanlari.map((ilan) => ilanKalitesiniDenetle(ilan, bilinenDanismanlar));
const kaliteHarita = new Map(kaliteKayitlari.map((kayit) => [kayit.ilanId, kayit]));
const kaliteSayilari = kaliteOzeti(kaliteKayitlari);
const kaliteSorunlu = kaliteKayitlari.filter((kayit) => kayit.durum !== 'uygun');
const teyitSayilari = teyitOzeti(await teyitKayitlariniGetir(vt));
const yayinIlanHarita = new Map(yayinIlanlari.map((ilan) => [ilan.id, ilan]));
const hatirlatmalar = await hatirlatmalariGetir(vt);
const sonPaylasimlar = new Map<string, Awaited<ReturnType<typeof paylasimlariGetir>>[number]>();
const paylasimlar = await paylasimlariGetir(vt);
for (const kayit of paylasimlar) if (!sonPaylasimlar.has(kayit.ilan_id)) sonPaylasimlar.set(kayit.ilan_id, kayit);
const bekleyenBildirim = await vt.prepare(`SELECT COUNT(*) AS adet FROM ilan_bildirim WHERE durum = 'bekliyor'`).first<{ adet: number }>().catch(() => ({ adet: 0 }));
const paylasimDurumu: Record<string, string> = {
  bekliyor: 'Sırada',
  isleniyor: 'Yayınlanıyor',
  yayinlandi: 'Yayınlandı',
  hata: 'Hata',
  iptal: 'İptal edildi',
  kuru: 'Kuru çalışma',
};
const platformEtiketi: Record<string, string> = {
  ig: 'Instagram', facebook: 'Facebook', threads: 'Threads', reels: 'Reels',
  youtube: 'YouTube Shorts', tiktok: 'TikTok',
};
const platformMetni = (ham: string) => {
  try { return (JSON.parse(ham) as string[]).map((x) => platformEtiketi[x] ?? x).join(', '); }
  catch { return 'Platform bilgisi okunamadı'; }
};
const tarihSaat = (ham: string) => new Date(ham).toLocaleString('tr-TR', { dateStyle: 'short', timeStyle: 'short' });
const ortam = env as unknown as Record<string, unknown>;
const whatsAppHazir = ['WHATSAPP_TELEFON_NO_KIMLIGI', 'WHATSAPP_ERISIM_JETONU', 'WHATSAPP_BILDIRIM_ALICI', 'WHATSAPP_PASIF_SABLONU']
  .every((anahtar) => Boolean(ortam[anahtar]));
const postedmHazir = Boolean(ortam.POSTEDM_API_ANAHTARI);

// Son 30 günün görüntülenmeleri — hangi ilan ilgi görüyor, hangisi durgun.
const goruntulenmeler = await vt
  .prepare(
    `SELECT ilan_id, SUM(adet) AS toplam FROM goruntulenme
     WHERE gun >= date('now', '-30 days') GROUP BY ilan_id`
  )
  .all<{ ilan_id: string; toplam: number }>()
  .catch(() => ({ results: [] as Array<{ ilan_id: string; toplam: number }> }));
const bakisHarita = new Map(
  (goruntulenmeler.results ?? []).map((g) => [g.ilan_id, g.toplam])
);
const enCokBakis = Math.max(1, ...bakisHarita.values());
const duzenlemeler = await vt
  .prepare(`SELECT ilan_id, baslik, aciklama, temel FROM ilan_duzenleme`)
  .all<{ ilan_id: string; baslik: string | null; aciklama: string | null; temel: string | null }>();
const duzHarita = new Map((duzenlemeler.results ?? []).map((d) => [d.ilan_id, d]));
const guvenliTemel = (ham: string | null | undefined) => {
  try { return ham ? JSON.parse(ham) as Partial<(typeof ilanlar)[number]> : {}; }
  catch { return {}; }
};

const PORTAL_OFIS = 'https://www.hepsiemlak.com/emlak-ofisi/edm-yapi-gayrimenkul-122060';

/**
 * Yer imi kodu: Hepsiemlak sekmesinde çalışıp ofisin bütün ilanlarını gezer,
 * fotoğraf adreslerini toplar ve siteye gönderir. Anahtar burada gömülü
 * olduğu için sayfa yalnızca panelden (Access arkasından) görünüyor.
 */
const senkronAnahtari = ((env as Record<string, unknown>).SENKRON_ANAHTARI as string) ?? '';
const yerImiKodu =
  'javascript:' +
  encodeURIComponent(
    `(async()=>{try{if(!location.hostname.includes('hepsiemlak.com')){alert('Önce Hepsiemlak ofis sayfanızı açın.');return}
const y=[];for(let s=1;s<=4;s++){const r=await fetch('https://www.hepsiemlak.com/emlak-ofisi/edm-yapi-gayrimenkul-122060'+(s>1?'?page='+s:''),{credentials:'include'});if(!r.ok)break;const h=await r.text();const b=[...h.matchAll(/href="(\/[a-z0-9-]+\/[a-z-]+\/122060-\d+)"/g)].map(m=>m[1]);const o=y.length;b.forEach(x=>{if(!y.includes(x))y.push(x)});if(y.length===o)break}
const i=[];for(const p of y){const ref=p.split('/').pop();try{const h=await (await fetch('https://www.hepsiemlak.com'+p,{credentials:'include'})).text();const t=h.match(/<title>([^<]*)<\/title>/);let b=(t?t[1]:'').replace(/&#x27;/g,"'").replace(/&amp;/g,'&').replace(/\s*\|\s*hepsiemlak\s*$/i,'').replace(new RegExp('\\s*'+ref+'\\s*$'),'').trim();const g=[...new Set([...h.matchAll(/(ds\d+\/(?:\d\/){6,10}[0-9a-f-]{36}\.jpg)/g)].map(m=>m[1]))].slice(0,15);if(b&&g.length)i.push({ref:ref,baslik:b,gorseller:g})}catch(e){}}
const c=await fetch('https://edmyapigayrimenkul.com/api/gorsel-aktar',{method:'POST',headers:{'Content-Type':'application/json','X-Senkron-Anahtari':'${senkronAnahtari}'},body:JSON.stringify({ilanlar:i})});const j=await c.json();alert(j.tamam?(j.eslesen+' ilanın fotoğrafları güncellendi.'+(j.eslesmeyen&&j.eslesmeyen.length?'\n\nEşleşmeyen '+j.eslesmeyen.length+' ilan var (başlıklar farklı).':'')):('Hata: '+(j.hata||'bilinmiyor')))}catch(e){alert('Aktarım başarısız: '+e.message)}})()`
  );
---

<Panel
  baslik="İlanlar"
  eposta={giris.kimlik.eposta}
  ozet={`${ilanlar.filter((i) => i.durum === 'aktif' && i.gizli !== 1 && !mukerrerKanonikId(i.id)).length} yayında · ${ilanlar.filter((i) => i.durum !== 'aktif' || i.gizli === 1).length} pasif · ${ilanlar.filter((i) => Boolean(mukerrerKanonikId(i.id))).length} mükerrer · ${bekleyenBildirim?.adet ?? 0} WhatsApp bildirimi bekliyor`}
>
  <a href="/yonetim/ilan-ekle" class="pd pd--kirmizi font-semibold" slot="eylem">+ Yeni İlan Ekle</a>

  {bildirim && <div class={`bildirim bildirim--${bildirim.tur}`}>{bildirim.metin}</div>}
  {kaydedilenElleIlanId && <span hidden data-kaydedilen-elle-ilan={kaydedilenElleIlanId} />}

  <p class="aciklama-kutu">
    <strong>Portal ilanları silinmez:</strong> kaynakta kaybolursa otomatik pasife düşer, geri
    gelirse yeniden aktifleşir. “Yayından al” kararı ve içerik düzenlemeleri senkronun üstünde
    korunur. <strong>Elle eklenen ilanlara senkron dokunmaz;</strong> aktif/pasif ve silme kararı
    tamamen yönetim panelindedir.
  </p>

  <div class="isletim-durumlari" aria-label="Otomasyon durumu">
    <div><span class:list={['durum-noktasi', whatsAppHazir && 'durum-noktasi--hazir']} aria-hidden="true"></span><p><strong>Pasif ilan WhatsApp’ı</strong><small>{whatsAppHazir ? 'Yapılandırıldı; portal senkronundan sonra otomatik gönderilir.' : 'Ayar bekliyor; olaylar kaybolmadan bildirim kuyruğunda tutulur.'}</small></p></div>
    <div><span class="durum-noktasi durum-noktasi--hazir" aria-hidden="true"></span><p><strong>İlan hatırlatmaları</strong><small>Seçilen tarihte sabah günlük özet e-postasına eklenir.</small></p></div>
    <div><span class:list={['durum-noktasi', postedmHazir && 'durum-noktasi--hazir']} aria-hidden="true"></span><p><strong>Sosyal yayın bağlantısı</strong><small>{postedmHazir ? 'Site API anahtarı hazır; GitHub secret’ı aynı değerde olmalıdır.' : 'Site API anahtarı tanımlanınca kuyruk otomasyona açılır.'}</small></p></div>
  </div>

  <details class="kalite-kutusu" open={kaliteSayilari.kritik > 0}>
    <summary>
      <span><strong>İçerik kalite kontrolü</strong><small>{kaliteSayilari.toplam} yayındaki ilan için otomatik kural taraması</small></span>
      <span class="kalite-sayilar">
        <b class="kalite-sayi kalite-sayi--uygun">{kaliteSayilari.uygun} uyarı yok</b>
        <b class="kalite-sayi kalite-sayi--incele">{kaliteSayilari.incele} incelenecek</b>
        <b class="kalite-sayi kalite-sayi--kritik">{kaliteSayilari.kritik} kritik</b>
      </span>
    </summary>
    <p class="kalite-aciklama">Bu tarama eksik ve çelişkili bilgileri işaretler. Fiyat, tapu ve müsaitliğin güncelliği danışman teyidi gerektirir. <a href="/yonetim/teyitler"><strong>{teyitSayilari.bekliyor + teyitSayilari.yanitlandi} açık teyidi yönet →</strong></a></p>
    {kaliteSorunlu.length ? <div class="tablo-sar"><table class="veri kalite-tablosu">
      <thead><tr><th>İlan</th><th>Durum</th><th>Kontrol notları</th><th></th></tr></thead>
      <tbody>{kaliteSorunlu.map((kayit) => {
        const ilan = yayinIlanHarita.get(kayit.ilanId)!;
        return <tr>
          <td><strong>{ilan.baslikTemiz}</strong><small class="kalite-id">No: {ilan.id}</small></td>
          <td><span class:list={['cip', kayit.durum === 'kritik' ? 'cip--pasif' : 'cip--islemde']}>{kayit.durum === 'kritik' ? 'Bilgi çelişkisi' : 'Teyit gerekli'}</span></td>
          <td><ul>{kayit.sorunlar.map((sorun) => <li><b>{sorun.seviye === 'hata' ? 'Hata' : 'Uyarı'}:</b> {sorun.mesaj}</li>)}</ul></td>
          <td><a href={`/yonetim/ilan-duzenle/${ilan.id}`} class="pd pd--sade">Düzelt</a></td>
        </tr>;
      })}</tbody>
    </table></div> : <p class="kalite-temiz">Yayındaki bütün ilanlar tanımlı kalite kontrollerinden geçti.</p>}
  </details>

  <form method="POST" id="toplu-form" class="toplu-cubuk" data-toplu hidden>
    <input type="hidden" name="eylem" value="toplu" />
    <span class="toplu-sayi"><strong data-toplu-sayi>0</strong> ilan seçildi</span>
    <div class="toplu-dugmeler">
      <button type="submit" name="toplu-islem" value="one-ac" class="pd pd--birincil">Öne çıkar</button>
      <button type="submit" name="toplu-islem" value="one-kapat" class="pd pd--sade">Öne çıkarmayı kaldır</button>
      <button type="submit" name="toplu-islem" value="durum-pasif" class="pd pd--tehlike">Pasife al</button>
      <button type="submit" name="toplu-islem" value="durum-aktif" class="pd pd--sade">Yayına al</button>
    </div>
  </form>

  <div class="kutu">
    <div class="tablo-sar">
      <table class="veri" style="min-width:56rem">
        <thead>
          <tr>
            <th style="width:2.5rem"><input type="checkbox" data-hepsi aria-label="Tümünü seç" /></th>
            <th>İlan</th>
            <th>Konum</th>
            <th>Fiyat</th>
            <th>30 gün</th>
            <th>Durum</th>
            <th style="text-align:right">İşlem</th>
          </tr>
        </thead>
        <tbody>
          {
            ilanlar.map((i) => {
              const duz = duzHarita.get(i.id);
              const etkin = { ...i, ...guvenliTemel(duz?.temel), id: i.id, kaynak: i.kaynak, kaynak_url: i.kaynak_url };
              const gosterilenBaslik = yayinIlanHarita.get(i.id)?.baslikTemiz ?? baslikTemizle(duz?.baslik ?? etkin.baslik);
              const kanonikAdayi = mukerrerKanonikId(i.id);
              const kanonikId = kanonikAdayi && yayinIlanHarita.has(kanonikAdayi) ? kanonikAdayi : null;
              const yol = kanonikId ? `/ilan/ilan-${kanonikId}` : `/ilan/${slugla(gosterilenBaslik)}-${i.id}`;
              const yayinda = i.durum === 'aktif' && i.gizli !== 1 && !kanonikId;
              const hatirlatma = hatirlatmalar.get(i.id);
              const paylasim = sonPaylasimlar.get(i.id);
              const kalite = kaliteHarita.get(i.id);
              return (
                <>
                  <tr>
                    <td>
                      <input type="checkbox" name="secili" value={i.id} form="toplu-form" aria-label={`${gosterilenBaslik} seç`} />
                    </td>
                    <td>
                      <a href={yol} target="_blank" rel="noopener" style="font-weight:600">
                        {gosterilenBaslik}
                      </a>
                      <div class="satir-etiket">
                        <span class="veri-sayi">{i.id}</span>
                        <span class:list={['cip', i.kaynak === 'elle' ? 'cip--pasif' : 'cip--islemde']}>{i.kaynak === 'elle' ? 'Elle girildi' : 'Otomatik aktarıldı'}</span>
                        {i.duzenlendi === 1 && <span class="cip cip--islemde">Düzenlendi</span>}
                        {kanonikId && <span class="cip cip--pasif">Mükerrer · ana kayıt {kanonikId}</span>}
                        {hatirlatma && <span class="cip cip--islemde">Takip: {new Date(`${hatirlatma.planlanan}T12:00:00`).toLocaleDateString('tr-TR')}</span>}
                        {paylasim && <span class="cip cip--one">Sosyal: {paylasimDurumu[paylasim.durum] ?? paylasim.durum}</span>}
                        {kalite && <span class:list={['cip', kalite.durum === 'uygun' ? 'cip--kapandi' : kalite.durum === 'kritik' ? 'cip--pasif' : 'cip--islemde']} title={kalite.sorunlar.map((sorun) => sorun.mesaj).join('\n')}>{kalite.durum === 'uygun' ? 'Kural uyarısı yok' : kalite.durum === 'kritik' ? 'Bilgi çelişkisi' : 'Teyit gerekli'}</span>}
                      </div>
                    </td>
                    <td>{[etkin.ilce, etkin.il].filter(Boolean).join(' / ') || '—'}</td>
                    <td class="sayi">{fiyatKisa(etkin.fiyat, etkin.para_birimi)}</td>
                    <td class="sayi">
                      {(() => {
                        const bakis = bakisHarita.get(i.id) ?? 0;
                        return (
                          <span class="bakis">
                            <span class="bakis-sayi">{bakis.toLocaleString('tr-TR')}</span>
                            <span
                              class="bakis-cubuk"
                              style={`--oran:${Math.round((bakis / enCokBakis) * 100)}%`}
                              aria-hidden="true"
                            />
                          </span>
                        );
                      })()}
                    </td>
                    <td>
                      <div class="durum-yigin">
                        {kanonikId ? (
                          <span class="cip cip--gizli">Ana kayda yönleniyor</span>
                        ) : i.durum === 'pasif' ? (
                          <span class="cip cip--pasif">Kaynakta pasif</span>
                        ) : i.gizli === 1 ? (
                          <span class="cip cip--gizli">Yönetici pasif yaptı</span>
                        ) : (
                          <span class="cip cip--kapandi">Yayında</span>
                        )}
                        {i.one_cikan === 1 && <span class="cip cip--one">Öne çıkan</span>}
                      </div>
                    </td>
                    <td style="text-align:right">
                      <div class="islem-yigin">
                        <form method="POST">
                          <input type="hidden" name="id" value={i.id} />
                          <input type="hidden" name="eylem" value="one-cikar" />
                          <input type="hidden" name="deger" value={i.one_cikan === 1 ? '0' : '1'} />
                          <button type="submit" class="pd pd--sade" title="Ana sayfada başa al">
                            {i.one_cikan === 1 ? 'Öne çıkarmayı kaldır' : 'Öne çıkar'}
                          </button>
                        </form>
                        <form method="POST">
                          <input type="hidden" name="id" value={i.id} />
                          <input type="hidden" name="eylem" value="durum" />
                          <input type="hidden" name="deger" value={yayinda ? 'pasif' : 'aktif'} />
                          <button type="submit" class:list={['pd', yayinda ? 'pd--tehlike' : 'pd--sade']} disabled={!yayinda && i.kaynak !== 'elle' && i.durum !== 'aktif'} title={!yayinda && i.kaynak !== 'elle' && i.durum !== 'aktif' ? 'Portal tekrar aktif göstermeden yayına alınamaz' : undefined}>
                            {yayinda ? 'Yayından al' : 'Yayına al'}
                          </button>
                        </form>
                        <details class="paylas-menu">
                          <summary class="pd pd--sade">Sosyal paylaş</summary>
                          <form method="POST">
                            <input type="hidden" name="id" value={i.id} />
                            <input type="hidden" name="eylem" value="paylas" />
                            <strong>Hesapları seçin</strong>
                            <div>{[['ig','Instagram'],['facebook','Facebook'],['threads','Threads'],['reels','Reels'],['youtube','Shorts'],['tiktok','TikTok']].map(([deger, etiket]) => <label><input type="checkbox" name="sosyal_platform" value={deger} checked /><span>{etiket}</span></label>)}</div>
                            <button type="submit" class="pd pd--birincil" disabled={!yayinda}>Kuyruğa ekle</button>
                            {!yayinda && <small>{kanonikId ? `Mükerrer kayıt paylaşılamaz; ${kanonikId} numaralı ana kaydı kullanın.` : 'Önce ilanı yayına alın.'}</small>}
                          </form>
                        </details>
                        <a href={`/yonetim/ilan-duzenle/${i.id}`} class="pd pd--birincil">Detaylı Düzenle</a>
                        <a href={`/yonetim/gorsel/${i.id}`} class="pd pd--sade">Fotoğraflar</a>
                      </div>
                    </td>
                  </tr>
                </>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>

  <section class="kutu kuyruk-kutusu">
    <div class="kutu-bas">
      <div>
        <h2>Sosyal yayın kuyruğu</h2>
        <p>Son işler, seçilen hesaplar ve otomasyonun geri bildirdiği sonuç.</p>
      </div>
      <span class="cip cip--islemde">{paylasimlar.filter((x) => ['bekliyor', 'isleniyor'].includes(x.durum)).length} işlem açık</span>
    </div>
    {paylasimlar.length ? (
      <div class="tablo-sar">
        <table class="veri kuyruk-tablosu">
          <thead><tr><th>İş</th><th>İlan</th><th>Hesaplar</th><th>Durum</th><th>Son işlem</th><th>Sonuç</th></tr></thead>
          <tbody>{paylasimlar.slice(0, 20).map((is) => {
            const ilgili = ilanlar.find((ilan) => ilan.id === is.ilan_id);
            const ayrinti = is.hata || is.sonuc;
            return <tr>
              <td class="sayi">#{is.id}</td>
              <td>{ilgili ? <a href={`/yonetim/ilan-duzenle/${is.ilan_id}`}>{baslikTemizle(ilgili.baslik)}</a> : <span>{is.ilan_id}</span>}</td>
              <td>{platformMetni(is.platformlar)}</td>
              <td><span class:list={['cip', is.durum === 'hata' ? 'cip--pasif' : ['yayinlandi', 'kuru'].includes(is.durum) ? 'cip--kapandi' : 'cip--islemde']}>{paylasimDurumu[is.durum] ?? is.durum}</span></td>
              <td class="sayi">{tarihSaat(is.guncelleme)}</td>
              <td>{ayrinti ? <details class="sonuc-ayrinti"><summary>Ayrıntıyı gör</summary><pre>{ayrinti}</pre></details> : '—'}</td>
            </tr>;
          })}</tbody>
        </table>
      </div>
    ) : <p class="bos-kuyruk">Henüz sosyal paylaşım işi oluşturulmadı.</p>}
  </section>

  <!-- Hepsiemlak görsel tazeleme -->
  <section class="kutu" style="margin-top:1.5rem">
    <div class="kutu-bas">
      <h2>Hepsiemlak fotoğraflarını tazele</h2>
      <span style="font-size:0.75rem;color:var(--color-kursun)">yeni ilan eklediğinizde</span>
    </div>
    <div class="yerimi-kutu">
      <p>
        Sitedeki fotoğraflar Hepsiemlak’tan geliyor — orada yatay çekim, yüksek çözünürlüklü
        ve üzerinde <strong>sizin logonuz</strong> olan hâlleri var. Ama Hepsiemlak sunucumuzu
        bot sanıp engelliyor, o yüzden aktarımı sizin tarayıcınızın yapması gerekiyor.
      </p>
      <p>Bir kez kurun, sonra tek tıkla çalışır:</p>
      <ol>
        <li>
          Aşağıdaki turuncu düğmeyi <strong>yer imi çubuğunuza sürükleyin</strong>
          (görünmüyorsa <span class="tus">⌘</span><span class="tus">⇧</span><span class="tus">B</span> ile açın).
        </li>
        <li>
          <a href={PORTAL_OFIS} target="_blank" rel="noopener">Hepsiemlak ofis sayfanızı</a> açın.
        </li>
        <li>Yer imine tıklayın. Fotoğraflar birkaç saniyede siteye aktarılır.</li>
      </ol>

      <a class="yerimi" href={yerImiKodu} onclick="alert('Bu düğmeye tıklamak yerine yer imi çubuğunuza sürükleyin.'); return false;">
        ⬇ EDM fotoğraf aktar
      </a>

      <p class="yerimi-not">
        Yer imi yalnızca sizin oturumunuzda çalışır ve gizli anahtarınızı taşır —
        başkasıyla paylaşmayın.
      </p>
    </div>
  </section>

  <section class="kutu yeni-ilan-kutusu" style="margin-top:1.5rem">
    <div class="kutu-bas">
      <h2>Portalda olmayan ilan ekle</h2>
      <span style="font-size:0.75rem;color:var(--color-kursun)">Senkron bunlara dokunmaz</span>
    </div>
    <div class="yeni-ilan-icerik">
      <div>
        <strong>Eksiksiz ilan sihirbazını kullanın</strong>
        <p>Kategoriye göre zorunlu alanlar, yetki durumu, medya ve yayın kontrolü tek akışta doğrulanır.</p>
      </div>
      <a href="/yonetim/ilan-ekle" class="pd pd--kirmizi font-semibold">Yeni ilan oluştur</a>
    </div>
  </section>
</Panel>

