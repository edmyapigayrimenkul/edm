---
/**
 * Site metinleri: hizmet açıklamaları ve bölge tanıtımları.
 *
 * Bunlar önceden kodda duruyordu. Panele taşındılar ama koddaki hâlleri
 * varsayılan olarak kaldı — bir metni boşaltırsanız koddaki yazı geri gelir,
 * yani yanlışlıkla silmek siteyi boş bırakmıyor.
 */
import Panel from '../../layouts/Panel.astro';
import { adminProfiliniBul, paneleGiris } from '../../lib/panel/yetki';
import { env } from 'cloudflare:workers';
import { icerik, icerikOnbellegiTemizle } from '../../lib/icerik';
import { bolgeler, bolgeOnbellegiTemizle } from '../../lib/bolgeler';
import { semayiKur } from '../../lib/senkron/depo';
import { islemKaydet, type IslemKaydiGirdisi } from '../../lib/panel/islem-gecmisi';
import { rolYetkisiGerekli, rolYetkisiVar } from '../../lib/panel/roller';

const giris = await paneleGiris(Astro.request);
if ('yanit' in giris) return giris.yanit;

const vt = env.VT as D1Database;
await semayiKur(vt);
const admin = adminProfiliniBul(giris.kimlik.eposta);
const metinSilebilir = rolYetkisiVar(admin?.rol ?? null, 'kalici-sil');
let bildirim: { tur: 'basari' | 'hata'; metin: string } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const tur = String(form.get('tur') ?? '');
  const anahtar = String(form.get('anahtar') ?? '');
  const suAn = new Date().toISOString();

  try {
    rolYetkisiGerekli(admin?.rol ?? null, tur === 'hizmet-sil' ? 'kalici-sil' : 'icerik-yonet');
    let islemKaydi: IslemKaydiGirdisi | null = null;
    if (tur === 'hizmet' && anahtar) {
      const onceki = await vt.prepare(`SELECT baslik, govde, sira, yayinda FROM metinler WHERE tur = 'hizmet' AND anahtar = ?`).bind(anahtar).first<Record<string, unknown>>();
      const sonraki = {
        baslik: String(form.get('baslik') ?? '').trim().slice(0, 120),
        govde: String(form.get('govde') ?? '').trim().slice(0, 800),
        sira: Number(form.get('sira')) || 0,
        yayinda: form.get('yayinda') ? 1 : 0,
      };
      await vt
        .prepare(
          `INSERT INTO metinler (tur, anahtar, baslik, govde, sira, yayinda, guncelleme)
           VALUES ('hizmet',?,?,?,?,?,?)
           ON CONFLICT(tur, anahtar) DO UPDATE SET
             baslik = excluded.baslik, govde = excluded.govde,
             sira = excluded.sira, yayinda = excluded.yayinda,
             guncelleme = excluded.guncelleme`
        )
        .bind(
          anahtar,
          String(form.get('baslik') ?? '').trim().slice(0, 120),
          String(form.get('govde') ?? '').trim().slice(0, 800),
          Number(form.get('sira')) || 0,
          form.get('yayinda') ? 1 : 0,
          suAn
        )
        .run();
      islemKaydi = { eylem: 'metin-guncellendi', varlikTuru: 'metin', varlikId: `hizmet:${anahtar}`, ozet: `${sonraki.baslik || anahtar} hizmet metni güncellendi.`, onceki, sonraki };
      bildirim = { tur: 'basari', metin: 'Hizmet metni kaydedildi.' };
    } else if (tur === 'bolge' && anahtar) {
      const onceki = await vt.prepare(`SELECT govde, ek, yayinda FROM metinler WHERE tur = 'bolge' AND anahtar = ?`).bind(anahtar).first<Record<string, unknown>>();
      const notlar = String(form.get('notlar') ?? '')
        .split('\n')
        .map((n) => n.trim())
        .filter(Boolean);
      await vt
        .prepare(
          `INSERT INTO metinler (tur, anahtar, govde, ek, yayinda, guncelleme)
           VALUES ('bolge',?,?,?,1,?)
           ON CONFLICT(tur, anahtar) DO UPDATE SET
             govde = excluded.govde, ek = excluded.ek, guncelleme = excluded.guncelleme`
        )
        .bind(
          anahtar,
          String(form.get('giris') ?? '').trim().slice(0, 2000),
          JSON.stringify(notlar),
          suAn
        )
        .run();
      islemKaydi = { eylem: 'metin-guncellendi', varlikTuru: 'metin', varlikId: `bolge:${anahtar}`, ozet: `${anahtar} bölge tanıtımı güncellendi.`, onceki, sonraki: { giris: String(form.get('giris') ?? '').trim().slice(0, 2000), notlar } };
      bildirim = { tur: 'basari', metin: `${anahtar} tanıtımı kaydedildi.` };
    } else if (tur === 'hizmet-ekle') {
      const yeniAnahtar = `h${Date.now().toString(36)}`;
      await vt
        .prepare(
          `INSERT INTO metinler (tur, anahtar, baslik, govde, sira, yayinda, guncelleme)
           VALUES ('hizmet',?,?,?,99,1,?)`
        )
        .bind(yeniAnahtar, 'Yeni hizmet', '', suAn)
        .run();
      islemKaydi = { eylem: 'metin-eklendi', varlikTuru: 'metin', varlikId: `hizmet:${yeniAnahtar}`, ozet: 'Yeni hizmet metni eklendi.', sonraki: { baslik: 'Yeni hizmet', yayinda: 1 } };
      bildirim = { tur: 'basari', metin: 'Yeni hizmet eklendi, aşağıdan düzenleyin.' };
    } else if (tur === 'hizmet-sil' && anahtar) {
      const onceki = await vt.prepare(`SELECT baslik, govde, sira, yayinda FROM metinler WHERE tur = 'hizmet' AND anahtar = ?`).bind(anahtar).first<Record<string, unknown>>();
      await vt
        .prepare(`DELETE FROM metinler WHERE tur = 'hizmet' AND anahtar = ?`)
        .bind(anahtar)
        .run();
      islemKaydi = { eylem: 'metin-silindi', varlikTuru: 'metin', varlikId: `hizmet:${anahtar}`, ozet: `${String(onceki?.baslik ?? anahtar)} hizmet metni silindi.`, onceki };
      bildirim = { tur: 'basari', metin: 'Hizmet silindi.' };
    }
    if (islemKaydi) await islemKaydet(vt, giris.kimlik, islemKaydi);
    icerikOnbellegiTemizle();
    if (tur === 'bolge') bolgeOnbellegiTemizle();
  } catch (hata) {
    bildirim = { tur: 'hata', metin: (hata as Error).message };
  }
}

const { hizmetler } = await icerik();
const bolgeListesi = await bolgeler();

/** İlçe adı birden fazla ilde bulunabilir; yeni kayıtlar bölge slug'ıyla ayrılır. */
const bolgeAnahtari = (b: (typeof bolgeListesi)[number]) => b.slug;
---

<Panel
  baslik="Metinler"
  eposta={giris.kimlik.eposta}
  ozet="Hizmet açıklamaları ve bölge tanıtımları"
>
  {bildirim && <div class={`bildirim bildirim--${bildirim.tur}`}>{bildirim.metin}</div>}

  <p class="aciklama-kutu">
    Bir metni <strong>boş bırakırsanız</strong> koddaki varsayılan yazı geri gelir —
    yani yanlışlıkla silmek siteyi boş bırakmaz.
  </p>

  <!-- Hizmetler -->
  <section class="kutu">
    <div class="kutu-bas">
      <h2>Hizmetler</h2>
      <form method="POST">
        <input type="hidden" name="tur" value="hizmet-ekle" />
        <button type="submit" class="pd pd--sade">Hizmet ekle</button>
      </form>
    </div>

    <div class="metin-liste">
      {
        hizmetler.map((h, i) => (
          <form method="POST" class="metin-satir">
            <input type="hidden" name="tur" value="hizmet" />
            <input type="hidden" name="anahtar" value={h.anahtar} />

            <div class="metin-alanlar">
              <label class="p-alan" style="max-width:20rem">
                <span>Başlık</span>
                <input type="text" name="baslik" value={h.baslik} maxlength="120" />
              </label>
              <label class="p-alan" style="max-width:6rem">
                <span>Sıra</span>
                <input type="number" name="sira" value={String(i)} />
              </label>
            </div>

            <label class="p-alan">
              <span>Açıklama</span>
              <textarea name="govde" rows="3" set:text={h.ozet} />
            </label>

            <div class="metin-eylem">
              <label class="onay-satir">
                <input type="checkbox" name="yayinda" checked />
                <span>Yayında</span>
              </label>
              <button type="submit" class="pd pd--birincil">Kaydet</button>
              {metinSilebilir && <button
                type="submit"
                name="tur"
                value="hizmet-sil"
                class="pd pd--tehlike"
                formnovalidate
                onclick="return confirm('Bu hizmet kalıcı olarak silinecek. Emin misiniz?')"
              >
                Sil
              </button>}
            </div>
          </form>
        ))
      }
    </div>
  </section>

  <!-- Bölge tanıtımları -->
  <section class="kutu" style="margin-top:1.5rem">
    <div class="kutu-bas">
      <h2>Bölge tanıtımları</h2>
      <span style="font-size:0.75rem;color:var(--color-kursun)">
        {bolgeListesi.length} bölge · rakamlar otomatik, sadece metin elle
      </span>
    </div>

    <div class="metin-liste">
      {
        bolgeListesi.map((b) => {
          const anahtar = bolgeAnahtari(b);
          const giris = b.giris ?? '';
          const notlar = b.notlar;

          return (
            <form method="POST" class="metin-satir">
              <input type="hidden" name="tur" value="bolge" />
              <input type="hidden" name="anahtar" value={anahtar} />

              <div class="bolge-bas">
                <strong>{b.ad}</strong>
                <span class="veri-sayi bolge-adet">{b.adet} ilan</span>
                <a href={b.yol} target="_blank" rel="noopener" class="pd pd--sade">Sayfayı gör ↗</a>
              </div>

              <label class="p-alan">
                <span>Tanıtım metni</span>
                <textarea name="giris" rows="4" set:text={giris} />
              </label>

              <label class="p-alan">
                <span>Bölge notları — her satıra bir madde</span>
                <textarea name="notlar" rows="3" set:text={notlar.join('\n')} />
              </label>

              <div class="metin-eylem">
                <button type="submit" class="pd pd--birincil">Kaydet</button>
              </div>
            </form>
          );
        })
      }
    </div>
  </section>
</Panel>

<style>
  .aciklama-kutu {
    background: #fff;
    border: 1px solid color-mix(in oklab, var(--color-murekkep) 10%, transparent);
    border-left: 3px solid var(--color-kirmizi);
    border-radius: 6px;
    padding: 0.85rem 1.1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-metin-2);
    margin-bottom: 1.25rem;
    max-width: 72ch;
  }

  .metin-liste {
    display: flex;
    flex-direction: column;
  }
  .metin-satir {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.25rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-murekkep) 8%, transparent);
  }
  .metin-satir:last-child {
    border-bottom: 0;
  }
  .metin-alanlar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .metin-eylem {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .onay-satir {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    margin-right: auto;
  }
  .onay-satir input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--color-kirmizi);
  }

  .bolge-bas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 1rem;
  }
  .bolge-adet {
    font-size: 0.75rem;
    color: var(--color-kursun);
    margin-right: auto;
  }
</style>
