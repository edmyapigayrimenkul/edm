---
/**
 * Kaydedilen ilanları yöneten tek betik.
 *
 * Her sayfada bir kez, gövdenin sonunda çalışıyor: düğmelerin durumunu
 * kuruyor, başlıktaki sayacı güncelliyor ve /favorilerim sayfasında hangi
 * kartların görüneceğine karar veriyor. Liste localStorage'da; sunucuya
 * hiçbir şey gönderilmiyor, gizli pencerede veya çerezler silinince
 * kendiliğinden boşalıyor.
 */
---

<script is:inline>
  (() => {
    // Görünüm geçişinde bu satır içi betik yeniden çalışabiliyor. İkinci
    // kez geldiğinde her şeyi baştan kurmak yerine durumu tazeleyip çıkıyor,
    // yoksa belge üstündeki dinleyiciler birikirdi.
    if (window.__edmFavoriTazele) {
      window.__edmFavoriTazele();
      return;
    }

    const ANAHTAR = 'edm-favori';

    const oku = () => {
      try {
        const l = JSON.parse(localStorage.getItem(ANAHTAR) || '[]');
        return Array.isArray(l) ? l.filter((x) => typeof x === 'string') : [];
      } catch {
        // Gizli pencerede ya da depolama kapalıyken sessizce boş liste.
        return [];
      }
    };
    const yaz = (l) => {
      try {
        localStorage.setItem(ANAHTAR, JSON.stringify(l));
      } catch {}
    };

    const paylasimMetni = (liste, sayfa) => {
      const kartlar = new Map(
        [...sayfa.querySelectorAll('[data-id]')].map((kart) => [kart.dataset.id, kart])
      );
      const satirlar = liste.flatMap((id, sira) => {
        const kart = kartlar.get(id);
        if (!kart) return [];
        const baslik = kart.dataset.baslik || `İlan ${id}`;
        const fiyat = kart.dataset.fiyatMetin || '';
        const yol = kart.dataset.yol || `/ilan/${id}`;
        return [`${sira + 1}. ${baslik}`, fiyat, `${location.origin}${yol}`];
      });
      return [
        `EDM Yapı & Gayrimenkul — ${liste.length} kayıtlı ilan`,
        '',
        ...satirlar,
        '',
        'Bu ilanlar hakkında bilgi ve uygun görüşme saatlerini öğrenmek istiyorum.',
      ].join('\n');
    };

    function tazele() {
      let liste = oku();
      const sayfa = document.querySelector('[data-favori-sayfa]');
      if (sayfa) {
        const mevcutKimlikler = new Set(
          [...sayfa.querySelectorAll('[data-id]')].map((kart) => kart.dataset.id)
        );
        const gecerliListe = liste.filter((id) => mevcutKimlikler.has(id));
        if (gecerliListe.length !== liste.length) {
          liste = gecerliListe;
          yaz(liste);
        }
      }
      const kume = new Set(liste);

      document.querySelectorAll('[data-favori]').forEach((d) => {
        const secili = kume.has(d.dataset.favori);
        d.setAttribute('aria-pressed', secili ? 'true' : 'false');
        const metin = d.querySelector('[data-favori-metin]');
        if (metin) metin.textContent = secili ? 'Kaydedildi' : 'Kaydet';
      });

      document.querySelectorAll('[data-favori-bag]').forEach((b) => {
        b.hidden = liste.length === 0;
        const sayi = b.querySelector('[data-favori-sayi]');
        if (sayi) sayi.textContent = String(liste.length);
      });

      if (!sayfa) return;

      let gorunen = 0;
      sayfa.querySelectorAll('[data-id]').forEach((kart) => {
        const secili = kume.has(kart.dataset.id);
        kart.hidden = !secili;
        if (!secili) return;
        gorunen++;
        // Kapalı kartların adresi data-src'de bekliyor: tarayıcı gizli de
        // olsa lazy görselleri indirmeye kalkıyor, bu yüzden adresi ancak
        // kart açılırken veriyoruz.
        kart.querySelectorAll('source[data-srcset]').forEach((g) => {
          g.srcset = g.dataset.srcset;
          delete g.dataset.srcset;
        });
        kart.querySelectorAll('img[data-src]').forEach((g) => {
          if (g.dataset.srcset) g.srcset = g.dataset.srcset;
          g.src = g.dataset.src;
          delete g.dataset.src;
          delete g.dataset.srcset;
        });
      });
      const bos = sayfa.querySelector('[data-favori-bos]');
      const izgara = sayfa.querySelector('[data-favori-izgara]');
      const arac = sayfa.querySelector('[data-favori-arac]');
      const wa = sayfa.querySelector('[data-favori-whatsapp]');
      if (bos) bos.hidden = gorunen > 0;
      if (izgara) izgara.hidden = gorunen === 0;
      if (arac) arac.hidden = gorunen === 0;
      if (wa && arac) {
        const numara = arac.dataset.wa || '';
        wa.href = `https://wa.me/${numara}?text=${encodeURIComponent(paylasimMetni(liste, sayfa))}`;
      }
    }

    document.addEventListener('click', async (olay) => {
      const temizle = olay.target.closest?.('[data-favori-temizle]');
      if (temizle) {
        yaz([]);
        tazele();
        return;
      }

      const paylas = olay.target.closest?.('[data-favori-paylas]');
      if (paylas) {
        const sayfa = paylas.closest('[data-favori-sayfa]');
        const liste = oku();
        const metin = paylasimMetni(liste, sayfa);
        const durum = sayfa.querySelector('[data-favori-paylas-durum]');
        const etiket = paylas.querySelector('[data-favori-paylas-metin]');
        try {
          if (navigator.share) {
            await navigator.share({ title: 'EDM kayıtlı ilanlarım', text: metin });
            if (durum) durum.textContent = 'Paylaşım penceresi açıldı.';
            return;
          }
          await navigator.clipboard.writeText(metin);
          if (etiket) etiket.textContent = 'Liste kopyalandı';
          if (durum) durum.textContent = 'İlan başlıkları, fiyatları ve bağlantıları panoya kopyalandı.';
          setTimeout(() => {
            if (etiket) etiket.textContent = 'Listeyi paylaş';
          }, 2200);
        } catch (hata) {
          if (hata?.name !== 'AbortError' && durum) {
            durum.textContent = 'Paylaşım açılamadı. WhatsApp düğmesini kullanabilirsiniz.';
          }
        }
        return;
      }

      const dugme = olay.target.closest?.('[data-favori]');
      if (!dugme) return;
      // Kart baştan sona bağlantı; tıklama ilana gitmesin.
      olay.preventDefault();
      olay.stopPropagation();

      const id = dugme.dataset.favori;
      const liste = oku();
      yaz(liste.includes(id) ? liste.filter((x) => x !== id) : [id, ...liste]);
      tazele();

      dugme.dataset.vur = 'evet';
      setTimeout(() => delete dugme.dataset.vur, 400);
    });

    // Geçişle gelen yeni gövdedeki düğmeler de doğru dursun.
    window.__edmFavoriTazele = tazele;
    document.addEventListener('astro:page-load', tazele);

    // Başka sekmede eklendiyse burası da haberdar olsun.
    window.addEventListener('storage', (o) => {
      if (o.key === ANAHTAR) tazele();
    });
    // Geri tuşuyla önbellekten dönen sayfa için.
    window.addEventListener('pageshow', tazele);

    tazele();
  })();
</script>
