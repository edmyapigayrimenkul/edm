---
import type { Danisman } from '../../lib/site';
import AdresAlanlari from './AdresAlanlari.astro';
import {
  ILAN_GRUPLARI,
  yeniIlanFormGruplari,
  alanGerekliMi,
  donanimGruplariSec,
  ISLEM_TURLERI,
  PARA_BIRIMLERI,
  KIMDEN_ALANI,
  kimdenAlaniniSec,
  YETKI_ALANLARI,
  MEDYA_PORTAL_ALANLARI,
  type AlanTanimi,
  type IlanDogrulamaHatasi,
} from '../../lib/ilan-bilgileri';
import { EN_COK_ILAN_FOTOGRAFI } from '../../lib/fotograf-kurallari';
import { videoBoyutMetni, videoSureMetni } from '../../lib/video-kurallari';
import { sahibindenDetayEslesmeDurumu } from '../../lib/sahibinden-detay';

interface Props {
  mod: 'ekle' | 'duzenle';
  ekip: Danisman[];
  degerler?: Record<string, string | string[]>;
  hatalar?: IlanDogrulamaHatasi[];
  ilanId?: string;
  kaynak?: string;
  kaydedildi?: boolean;
  gorselSayisi?: number;
  videoKaydi?: { video: string; poster: string; sure: number; boyut: number } | null;
}

const {
  mod,
  ekip,
  degerler = {},
  hatalar = [],
  ilanId,
  kaynak = 'elle',
  kaydedildi = false,
  gorselSayisi = 0,
  videoKaydi = null,
} = Astro.props;

const formGruplari = mod === 'ekle' ? yeniIlanFormGruplari() : ILAN_GRUPLARI;

const deger = (ad: string, varsayilan = ''): string => {
  const bulunan = degerler[ad];
  return Array.isArray(bulunan) ? (bulunan[0] ?? varsayilan) : (bulunan ?? varsayilan);
};
const secili = (ad: string, aranan: string): boolean => {
  const bulunan = degerler[ad];
  return Array.isArray(bulunan) ? bulunan.includes(aranan) : bulunan === aranan;
};
const hatali = (ad: string) => hatalar.some((h) => h.alan === ad);
const ilkGrupHam = deger('tip_grup', 'konut');
const ilkGrupAdayi = ilkGrupHam === 'diger' ? 'turistik' : ilkGrupHam;
const ilkGrup = formGruplari.some((g) => g.kimlik === ilkGrupAdayi) ? ilkGrupAdayi : formGruplari[0].kimlik;
const ilkSema = formGruplari.find((g) => g.kimlik === ilkGrup) ?? formGruplari[0];
const ilkIslem = ilkSema.islemler.includes(deger('islem') as never) ? deger('islem') : ilkSema.islemler[0];
const ilkTipler = ilkSema.altTipler.filter((tip) => !tip.islemler?.length || tip.islemler.includes(ilkIslem as never));
const ilkTip = ilkTipler.some((tip) => tip.deger === deger('tip')) ? deger('tip') : ilkTipler[0]?.deger ?? ilkSema.altTipler[0].deger;
const ilkTipEtiketi = ilkSema.altTipler.find((tip) => tip.deger === ilkTip)?.etiket ?? ilkTip;
const ilkKimden = kimdenAlaniniSec(ilkSema.kimlik, ilkIslem, ilkTip);
const ilkKaynakEslesmeDurumu = sahibindenDetayEslesmeDurumu(ilkSema.kimlik, ilkIslem, ilkTip, ilkTipEtiketi);
const ilkDonanimGruplari = donanimGruplariSec(ilkSema.kimlik, ilkIslem, ilkTip);
const ilkDonanimOgeListesi = new Set(ilkDonanimGruplari.flatMap((grup) => grup.ogeListesi));
const kayitliDonanim = Array.isArray(degerler.donanim) ? degerler.donanim : degerler.donanim ? [degerler.donanim] : [];
const eskiDonanim = kayitliDonanim.filter((oge) => !ilkDonanimOgeListesi.has(oge));
const taslakAnahtari = `edm-ilan-formu:${ilanId ?? 'yeni'}`;
const semaOzeti = formGruplari.map((g) => ({
  kimlik: g.kimlik,
  etiket: g.etiket,
  aciklama: g.aciklama,
  islemler: g.islemler,
  altTipler: g.altTipler,
  donanimGruplari: g.donanimGruplari,
}));
const teknikAlanAdlari = new Set(ilkSema.bolumler.flatMap((bolum) => bolum.alanlar.map((alan) => alan.ad)));
const hataHedefi = (ad: string) => teknikAlanAdlari.has(ad) ? `alan-${ilkSema.kimlik}-${ad}` : `alan-${ad}`;

const alanCiz = (alan: AlanTanimi) => alan;
---

<form
  method="POST"
  enctype="multipart/form-data"
  id="ana-ilan-formu"
  class="ilan-formu"
  novalidate
  data-ilan-formu
  data-mod={mod}
  data-taslak-anahtari={taslakAnahtari}
  data-kaydedildi={kaydedildi ? 'evet' : 'hayir'}
  data-gorsel-sayisi={String(gorselSayisi)}
  data-yukleme-ilan-id={ilanId}
>
  {ilanId && <input type="hidden" name="taslak_id" value={ilanId} />}
  <script type="application/json" data-ilan-semalari set:html={JSON.stringify(semaOzeti)} />

  <div class="form-durum" aria-label="İlan doluluk durumu">
    <div>
      <span class="form-durum-etiket">YAYIN HAZIRLIĞI</span>
      <strong data-doluluk-metin>Temel bilgiler bekleniyor</strong>
    </div>
    <div class="form-durum-sag">
      <span data-taslak-durumu>Taslak bu cihazda korunur</span>
      <span class="form-yuzde" data-doluluk-yuzde>%0</span>
    </div>
    <div class="form-ilerleme" aria-hidden="true"><span data-doluluk-cubugu></span></div>
  </div>

  <div class="taslak-uyari" data-taslak-uyari hidden>
    <div><strong>Bu cihazda daha yeni bir taslak bulundu.</strong><span>Kaydetmeden kapatılan bilgiler geri yüklenebilir.</span></div>
    <div class="taslak-eylem"><button type="button" data-taslak-yukle>Taslağı geri yükle</button><button type="button" data-taslak-sil>Sil</button></div>
  </div>

  {
    hatalar.length > 0 && (
      <div class="hata-ozeti" role="alert" tabindex="-1" data-hata-ozeti>
        <strong>İlan kaydedilmedi. {hatalar.length} alanı düzeltin:</strong>
        <ul>{hatalar.map((h) => <li><a href={`#${hataHedefi(h.alan)}`}>{h.mesaj}</a></li>)}</ul>
      </div>
    )
  }
  <div class="hata-ozeti" role="alert" tabindex="-1" data-istemci-hata-ozeti hidden>
    <strong>İlan kaydedilmedi. Eksik veya hatalı alanları düzeltin:</strong>
    <ul data-istemci-hata-listesi></ul>
  </div>

  <div class="form-yerlesim">
    <aside class="form-rehber" aria-label="İlan formu bölümleri">
      <p class="form-rehber-baslik">İlan dosyası</p>
      <ol>
        <li><a href="#kategori"><span>01</span>Kategori</a></li>
        <li><a href="#temel"><span>02</span>Fiyat ve başlık</a></li>
        <li><a href="#konum"><span>03</span>Konum ve yetki</a></li>
        <li><a href="#teknik"><span>04</span>Teknik bilgiler</a></li>
        <li><a href="#donanim"><span>05</span>Nitelikler</a></li>
        <li><a href="#medya"><span>06</span>Medya ve portallar</a></li>
        <li><a href="#aciklama"><span>07</span>Açıklama ve kontrol</a></li>
        <li><a href="#isletim"><span>08</span>Yayın ve takip</a></li>
      </ol>
      <div class="form-kontrol">
        <p>Yayın kontrolü</p>
        <ul>
          <li data-kontrol="kategori">Kategori ve işlem</li>
          <li data-kontrol="konum">İl, ilçe ve mahalle</li>
          <li data-kontrol="fiyat">Fiyat ve alan</li>
          <li data-kontrol="aciklama">Açıklama</li>
          <li data-kontrol="gorsel">En az 5 fotoğraf</li>
          <li data-kontrol="yetki">İlan verme yetkisi</li>
        </ul>
      </div>
    </aside>

    <div class="form-icerik">
      <section class="form-bolum" id="kategori" data-adim="kategori">
        <header class="form-bolum-bas"><span>01</span><div><h2>Kategoriyi kesinleştirin</h2><p>İşlem türü, mülk grubu ve alt tür birlikte veri şablonunu belirler.</p></div></header>
        <fieldset class="alan-grubu">
          <legend>İşlem türü <em>*</em></legend>
          <div class="secenek-seridi" data-islem-listesi>
            {ISLEM_TURLERI.map((islem) => (
              <label class="secenek-dugme">
                <input type="radio" name="islem" value={islem.deger} checked={ilkIslem === islem.deger} />
                <span>{islem.etiket}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="alan-grubu">
          <legend>Mülk grubu <em>*</em></legend>
          <div class="kategori-izgara">
            {formGruplari.map((grup, sira) => (
              <label class="kategori-secim">
                <input type="radio" name="tip_grup" value={grup.kimlik} checked={ilkSema.kimlik === grup.kimlik} />
                <span class="kategori-no">0{sira + 1}</span>
                <strong>{grup.etiket}</strong><small>{grup.aciklama}</small>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="alan-grid alan-grid--iki">
          <label class="alan" id="alan-tip"><span>Alt mülk türü <em>*</em></span>
            <select name="tip" required aria-invalid={hatali('tip') ? 'true' : undefined}>
              {ilkTipler.map((tip) => <option value={tip.deger} selected={ilkTip === tip.deger}>{tip.etiket}</option>)}
            </select>
          </label>
          <div class="kategori-sonuc"><span>Seçili şablon</span><strong data-kategori-sonuc>{ilkSema.etiket}</strong><small data-kategori-aciklama>{ilkSema.aciklama}</small></div>
        </div>
      </section>

      <section class="form-bolum" id="temel" data-adim="temel">
        <header class="form-bolum-bas"><span>02</span><div><h2>Fiyat ve vitrin bilgileri</h2><p>Başlık, konumu ve en güçlü farkı ilk bakışta anlatmalı.</p></div></header>
        <div class="alan-grid alan-grid--iki">
          <label class="alan alan--tam" id="alan-baslik"><span>İlan başlığı <em>*</em><b data-baslik-sayac>0 / 64</b></span>
            <input name="baslik" value={deger('baslik')} required minlength="10" maxlength="64" placeholder="Örn. Silivri Selimpaşa’da deniz manzaralı müstakil villa" aria-invalid={hatali('baslik') ? 'true' : undefined} data-onerilen />
            <small>Konum + mülk türü + ayırt edici özellik sırası iyi çalışır.</small>
          </label>
          <label class="alan" id="alan-fiyat" data-fiyat-alani hidden={ilkIslem === 'kat-karsiligi-satilik'}><span><strong data-fiyat-etiketi>Fiyat</strong> <em>*</em></span><div class="birimli-girdi"><input type="text" name="fiyat" value={deger('fiyat')} required={ilkIslem !== 'kat-karsiligi-satilik'} inputmode="numeric" autocomplete="off" aria-invalid={hatali('fiyat') ? 'true' : undefined} data-fiyat-girdisi /><select name="para_birimi" aria-label="Para birimi">{PARA_BIRIMLERI.map((p) => <option value={p.deger} selected={deger('para_birimi', 'TRY') === p.deger}>{p.deger}</option>)}</select></div><small class="fiyat-okunus" data-fiyat-okunus aria-live="polite"></small></label>
          <div class="kategori-sonuc" data-kat-karsiligi-notu hidden={ilkIslem !== 'kat-karsiligi-satilik'}><span>Bedel türü</span><strong>Kat karşılığı</strong><small>Fiyat girilmez; paylaşım ve teklif koşulları açıklamada belirtilir.</small></div>
          <label class="alan"><span>Danışman</span><select name="danisman_slug"><option value="">Ofis geneli</option>{ekip.map((u) => <option value={u.slug} selected={deger('danisman_slug') === u.slug}>{u.ad}</option>)}</select></label>
          <label class="alan" id="alan-kimden" data-kimden-alani><span>{KIMDEN_ALANI.etiket} <em>*</em></span><select name={KIMDEN_ALANI.ad} required data-kimden-secimi disabled={ilkKimden.secenekler?.length === 1} aria-invalid={hatali(KIMDEN_ALANI.ad) ? 'true' : undefined}>{ilkKimden.secenekler?.length === 1 && <option value={ilkKimden.secenekler[0].deger} selected>{ilkKimden.secenekler[0].etiket}</option>}{(ilkKimden.secenekler?.length ?? 0) > 1 && <><option value="">Seçin</option>{ilkKimden.secenekler?.map((o) => <option value={o.deger} selected={deger(KIMDEN_ALANI.ad) === o.deger}>{o.etiket}</option>)}</>}</select><input type="hidden" name={KIMDEN_ALANI.ad} value={ilkKimden.secenekler?.[0]?.deger ?? 'Emlak Ofisinden'} data-kimden-gizli disabled={(ilkKimden.secenekler?.length ?? 0) > 1} />{ilkKimden.secenekler?.length === 1 && <small>{KIMDEN_ALANI.yardim}</small>}</label>
        </div>
      </section>

      <section class="form-bolum" id="konum" data-adim="konum">
        <header class="form-bolum-bas"><span>03</span><div><h2>Konum ve yayın yetkisi</h2><p>Ziyaretçiye mahalle gösterilir; taşınmaz numarası ve iç notlar yalnızca panelde kalır.</p></div></header>
        <AdresAlanlari il={deger('il', 'İstanbul')} ilce={deger('ilce', 'Silivri')} mahalle={deger('mahalle')} hatalar={hatalar.map((hata) => hata.alan)} degerler={Object.fromEntries(Object.entries(degerler).map(([anahtar, deger]) => [anahtar, Array.isArray(deger) ? deger[0] ?? '' : deger]))} />
        <div class="alt-kart"><div class="alt-kart-bas"><strong>Yetki dosyası</strong><span>Bu bilgiler halka açık sayfada gösterilmez.</span></div><div class="alan-grid alan-grid--iki">
          {YETKI_ALANLARI.map((alan) => {
            const x = alanCiz(alan), v = deger(x.ad);
            return <label class:list={['alan', x.tamGenislik && 'alan--tam']} id={`alan-${x.ad}`}><span>{x.etiket}{x.gerekli && <em> *</em>}</span>
              {x.tur === 'secim' ? <select name={x.ad} required={x.gerekli} aria-invalid={hatali(x.ad) ? 'true' : undefined}><option value="">Seçin</option>{x.secenekler?.map((o) => <option value={o.deger} selected={v === o.deger}>{o.etiket}</option>)}</select> : x.tur === 'uzun-metin' ? <textarea name={x.ad} rows="3" placeholder={x.yerTutucu}>{v}</textarea> : <input type={x.tur === 'tarih' ? 'date' : 'text'} name={x.ad} value={v} placeholder={x.yerTutucu} />}
            </label>;
          })}
        </div></div>
      </section>

      <section class="form-bolum" id="teknik" data-adim="teknik">
        <header class="form-bolum-bas"><span>04</span><div><h2>Kategoriye özel teknik bilgiler</h2><p>Yalnızca seçilen mülk grubuyla ilgili alanlar kaydedilir ve yayınlanır.</p></div></header>
        {formGruplari.map((grup) => (
          <div data-grup-panel={grup.kimlik} hidden={grup.kimlik !== ilkSema.kimlik}>
            {grup.bolumler.map((bolum) => (
              <fieldset class="teknik-grup"><legend><strong>{bolum.baslik}</strong><small>{bolum.aciklama}</small></legend><div class="alan-grid alan-grid--uc">
                {bolum.alanlar.map((alan) => {
                  const x = alanCiz(alan), v = deger(x.ad), mevcutSecenek = x.secenekler?.some((o) => o.deger === v), gerekliMi = alanGerekliMi(x, ilkIslem, ilkTip, grup.kimlik, degerler);
                  if (x.tur === 'coklu') return <fieldset class:list={['alan', 'alan--coklu', x.tamGenislik && 'alan--tam']} id={`alan-${grup.kimlik}-${x.ad}`} data-alan-anahtari={x.ad} data-islemler={x.islemler?.join(',')} data-tipler={x.tipler?.join(',')} data-gerekli={x.gerekli ? 'evet' : 'hayir'} data-zorunlu-kosullar={JSON.stringify(x.zorunluKosullar ?? [])}>
                    <legend>{x.etiket}<em data-gerekli-isareti hidden={!gerekliMi}> *</em>{x.onerilen && <i data-onerilen-isareti hidden={gerekliMi}>önerilen</i>}</legend>
                    <div class="coklu-secim">{x.secenekler?.map((o) => <label><input type="checkbox" name={x.ad} value={o.deger} checked={secili(x.ad, o.deger)} /><span>{o.etiket}</span></label>)}</div>
                    {x.yardim && <small>{x.yardim}</small>}
                  </fieldset>;
                  return <label class:list={['alan', x.tamGenislik && 'alan--tam']} id={`alan-${grup.kimlik}-${x.ad}`} data-alan-anahtari={x.ad} data-islemler={x.islemler?.join(',')} data-tipler={x.tipler?.join(',')} data-gerekli={x.gerekli ? 'evet' : 'hayir'} data-zorunlu-kosullar={JSON.stringify(x.zorunluKosullar ?? [])}>
                    <span>{x.etiket}<em data-gerekli-isareti hidden={!gerekliMi}> *</em>{x.onerilen && <i data-onerilen-isareti hidden={gerekliMi}>önerilen</i>}</span>
                    {x.tur === 'secim' ? <select name={x.ad} required={gerekliMi} data-onerilen={x.onerilen ? '' : undefined} aria-invalid={hatali(x.ad) ? 'true' : undefined}><option value="">Seçin</option>{v && !mevcutSecenek && <option value={v} selected>{v}</option>}{x.secenekler?.map((o) => <option value={o.deger} selected={v === o.deger}>{o.etiket}</option>)}</select>
                    : x.tur === 'uzun-metin' ? <textarea name={x.ad} rows="3" placeholder={x.yerTutucu}>{v}</textarea>
                    : <div class:list={['birimli-girdi', !x.birim && 'birimli-girdi--yalin']}><input type={x.tur === 'tarih' ? 'date' : x.tur === 'metin' ? 'text' : 'number'} name={x.ad} value={v} required={gerekliMi} min={x.enAz} max={x.enFazla} step={x.adim ?? (x.tur === 'ondalik' ? '0.01' : undefined)} placeholder={x.yerTutucu} data-onerilen={x.onerilen ? '' : undefined} aria-invalid={hatali(x.ad) ? 'true' : undefined} />{x.birim && <b>{x.birim}</b>}</div>}
                    {x.yardim && <small>{x.yardim}</small>}
                  </label>;
                })}
              </div></fieldset>
            ))}
          </div>
        ))}
      </section>

      <section class="form-bolum" id="donanim" data-adim="donanim">
        <header class="form-bolum-bas"><span>05</span><div><h2>Nitelikler ve olanaklar</h2><p>Yalnızca sahada görülen veya belgeden doğrulanan nitelikleri seçin.</p></div><b class="secim-sayaci" data-donanim-sayaci>0 seçili</b></header>
        <p class="donanim-kaynak-notu" data-kaynak-profil-uyarisi role="status" data-kaynak-durumu={ilkKaynakEslesmeDurumu} hidden={ilkKaynakEslesmeDurumu === 'dogrudan'}><strong data-kaynak-profil-baslik>{ilkKaynakEslesmeDurumu === 'diger-islem-tek-profil' ? 'Sahibinden’de diğer işlemlerdeki tek profil kullanılıyor' : ilkKaynakEslesmeDurumu === 'yakin-islem-profili' ? 'Sahibinden’deki en yakın işlem profili kullanılıyor' : ilkKaynakEslesmeDurumu === 'yakin-alt-tur-profili' ? 'Sahibinden’deki en yakın kategori profili kullanılıyor' : 'EDM genel nitelik şablonu'}</strong><span data-kaynak-profil-aciklama>{ilkKaynakEslesmeDurumu === 'diger-islem-tek-profil' ? 'Bu işlem için doğrudan kaynak profili yok. Alınan Sahibinden şablonlarında aynı alt türün seçenekleri diğer işlemlerde birebir aynı olduğundan bu tekil profil gösteriliyor.' : ilkKaynakEslesmeDurumu === 'yakin-islem-profili' ? 'Aynı alt tür için Sahibinden’de bu işlem bulunmadı. Seçenekler en yakın mevcut satılık/kiralık kaynak formundan alındı; işlem birebir eşleşmesi değildir.' : ilkKaynakEslesmeDurumu === 'yakin-alt-tur-profili' ? 'Bu alt tür Sahibinden kategori ağacında yok. Seçenekler yakın kategoriden alındı; bu nedenle kategori birebir eşleşmesi değildir.' : 'Bu işlem ve alt tür için eşdeğer Sahibinden profili yok. Gösterilen seçenekler EDM’nin genel listesidir; yalnızca taşınmaz için doğruladığınız özellikleri işaretleyin.'}</span></p>
        <label class="arama-alani"><span class="sr-only">Nitelik ara</span><input type="search" placeholder="Niteliklerde ara…" data-donanim-ara /></label>
        <div data-donanim-panel data-donanim-key={`${ilkSema.kimlik}|${ilkIslem}|${ilkTip}`}>{ilkDonanimGruplari.map((donanimGrubu) => {
          const gruptaSecimVar = donanimGrubu.ogeListesi.some((oge) => secili('donanim', oge));
          return <fieldset class="donanim-grup" id={`donanim-${donanimGrubu.kimlik}`} data-donanim-grup={donanimGrubu.kimlik} data-gerekli={donanimGrubu.gerekli ? 'evet' : 'hayir'}><legend><strong>{donanimGrubu.baslik}{donanimGrubu.gerekli && <em> *</em>}</strong><small>{donanimGrubu.aciklama}</small></legend><div class="donanim-izgara">{donanimGrubu.ogeListesi.map((oge) => <label data-donanim-oge data-ara={oge.toLocaleLowerCase('tr-TR')}><input type="checkbox" name="donanim" value={oge} checked={secili('donanim', oge)} /><span>{oge}</span></label>)}</div>{donanimGrubu.gerekli && <label class="donanim-atla"><input type="checkbox" name="donanim_secim_yok" value={donanimGrubu.kimlik} data-donanim-atla checked={mod === 'duzenle' && !gruptaSecimVar} /><span>Bu grup için seçim yapmak istemiyorum</span></label>}</fieldset>;
        })}{eskiDonanim.length > 0 && <fieldset class="donanim-grup" data-donanim-grup="eski"><legend><strong>Önceden kayıtlı diğer nitelikler</strong><small>Bu ilanda daha önce kaydedilmiş bilgiler.</small></legend><div class="donanim-izgara">{eskiDonanim.map((oge) => <label data-donanim-oge data-ara={oge.toLocaleLowerCase('tr-TR')}><input type="checkbox" name="donanim" value={oge} checked /><span>{oge}</span></label>)}</div></fieldset>}</div>
      </section>

      <section class="form-bolum" id="medya" data-adim="medya">
        <header class="form-bolum-bas"><span>06</span><div><h2>Medya ve portal bağlantıları</h2><p>Önce güçlü kapak, sonra mekânı doğal gezi sırasıyla anlatan fotoğraflar.</p></div></header>
        {mod === 'duzenle' && ilanId && <div class="medya-yonetim"><div><strong>{gorselSayisi} mevcut fotoğraf</strong><span>Kapak seçimi, ayrıntılı sıralama ve tek tek gizleme için görsel yöneticisini açın.</span></div><a href={`/yonetim/gorsel/${ilanId}`}>Görselleri yönet →</a></div>}
        <div class="dosya-yukleme" data-form-gorsel-alani>
          <label class="dosya-birakma">
            <input type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" multiple data-form-gorsel-secici />
            <span class="dosya-ikon" aria-hidden="true">↑</span>
            <strong>Fotoğrafları seçin veya buraya sürükleyin</strong>
            <small>JPG, PNG, WebP veya HEIC · en fazla {EN_COK_ILAN_FOTOGRAFI} fotoğraf · seçilenler kaydederken küçültülüp yüklenir</small>
          </label>
          <details class="foto-standardi">
            <summary>İlan fotoğrafı seçme rehberi</summary>
            <ul>
              <li>Kapak için yatay 4:3 veya 3:2 kadraj, net odak ve dengeli gün ışığı seçin. Dikey fotoğraflar ek kare olarak uygundur.</li>
              <li>Önce dış cephe veya en güçlü genel görünüm; sonra salon, mutfak, odalar, banyo ve diğer alanları gezi sırasıyla ekleyin.</li>
              <li>Önerilen en düşük ölçü 1200 × 800 pikseldir. Seçimde görünen uyarılar öneridir; fotoğraf yüklemeyi engellemez.</li>
              <li>Kullanım izni olan özgün fotoğraf kullanın. Portal filigranını kaldırmayın; kişi, belge, plaka veya özel eşya görünüyorsa paylaşmadan önce kadrajı/izni kontrol edin.</li>
            </ul>
          </details>
          <div class="dosya-onizleme" data-form-gorsel-onizleme hidden></div>
          <p class="dosya-durum" data-form-gorsel-durum hidden aria-live="polite"></p>
        </div>
        <div class="video-yukleme" data-video-yukleme-alani>
          <div class="video-yukleme-bas"><div><strong>Doğrudan ilan videosu</strong><span>Tek video · MP4, WebM veya MOV · en fazla {videoSureMetni()} ve {videoBoyutMetni()}</span></div>{videoKaydi && <button type="button" data-video-sil>Yüklenen videoyu sil</button>}</div>
          {videoKaydi && <video controls preload="metadata" poster={videoKaydi.poster} src={videoKaydi.video}></video>}
          <label class="video-dosya"><input type="file" accept="video/mp4,video/webm,video/quicktime" data-video-secici /><span>{videoKaydi ? 'Videoyu değiştirmek için dosya seçin' : 'Video dosyası seçin'}</span></label>
          <p data-video-durum aria-live="polite">{videoKaydi ? `${Math.round(videoKaydi.sure)} saniye · ${(videoKaydi.boyut / 1024 / 1024).toLocaleString('tr-TR', { maximumFractionDigits: 1 })} MB` : 'Poster karesi videodan otomatik hazırlanır.'}</p>
        </div>
        <details class="gelismis-medya">
          <summary>Harici görsel adresi ekle</summary>
          <label class="alan alan--tam" id="alan-gorseller"><span>Kaynak görsel adresleri</span><textarea name="gorseller" rows="4" placeholder="Her satıra bir görsel adresi">{deger('gorseller')}</textarea><small>Başka bir sunucudaki izinli görseller için kullanın. Bilgisayardan veya telefondan yüklemek için yukarıdaki alan yeterlidir.</small></label>
        </details>
        <div class="alan-grid alan-grid--iki mt-5">{MEDYA_PORTAL_ALANLARI.map((alan) => { const x = alanCiz(alan), v = deger(x.ad, x.ad === 'portal_iletisim_tercihi' ? 'danisman' : ''); return <label class="alan" id={`alan-${x.ad}`}><span>{x.etiket}</span>{x.tur === 'secim' ? <select name={x.ad}><option value="">Seçin</option>{x.secenekler?.map((o) => <option value={o.deger} selected={v === o.deger}>{o.etiket}</option>)}</select> : <input type={x.ad.endsWith('_url') ? 'url' : 'text'} name={x.ad} value={v} placeholder={x.yerTutucu} inputmode={x.ad.endsWith('_no') ? 'numeric' : undefined} />}</label> })}</div>
        <div class="kaynak-notu"><strong>Veri kaynağı: {kaynak === 'elle' ? 'Panelden girilen ilan' : 'Emlakjet senkronu'}</strong><span>{kaynak === 'elle' ? 'Bu ilan otomatik portal senkronunda pasife alınmaz.' : 'Paneldeki içerik kararları senkron verisinin üstünde korunur.'}</span></div>
      </section>

      <section class="form-bolum" id="aciklama" data-adim="aciklama">
        <header class="form-bolum-bas"><span>07</span><div><h2>Açıklama ve yayın kontrolü</h2><p>Önce somut fayda, sonra teknik durum, çevre ve randevu çağrısı.</p></div></header>
        <label class="alan alan--tam" id="alan-aciklama"><span>İlan açıklaması <em>*</em><b data-aciklama-sayac>0 karakter</b></span><textarea name="aciklama" required minlength="80" maxlength="8000" rows="14" aria-invalid={hatali('aciklama') ? 'true' : undefined} data-onerilen>{deger('aciklama')}</textarea><small>Doğrulanmayan getiri, imar veya mesafe iddiası yazmayın. Portal metnini kopyalamak yerine bu mülke özgü bir anlatım kullanın.</small></label>
        <div class="yayin-ozeti"><div><span>Kategori</span><strong data-ozet-kategori>—</strong></div><div><span>Konum</span><strong data-ozet-konum>—</strong></div><div><span>Fiyat</span><strong data-ozet-fiyat>—</strong></div><div><span>Teknik doluluk</span><strong data-ozet-doluluk>—</strong></div></div>
      </section>

      <section class="form-bolum" id="isletim" data-adim="isletim">
        <header class="form-bolum-bas"><span>08</span><div><h2>Yayın, takip ve sosyal medya</h2><p>İlanın sitedeki durumunu, geri dönüş tarihini ve kayıttan sonra çalışacak sosyal yayın kuyruğunu belirleyin.</p></div></header>
        <div class="isletim-izgara">
          <fieldset class="isletim-karti"><legend>Sitedeki durum</legend><div class="secenek-seridi">
            <label class="secenek-dugme"><input type="radio" name="yayin_durumu" value="aktif" checked={deger('yayin_durumu', 'aktif') === 'aktif'} /><span>Aktif ve yayında</span></label>
            <label class="secenek-dugme"><input type="radio" name="yayin_durumu" value="pasif" checked={deger('yayin_durumu') === 'pasif'} /><span>Pasif / yayından al</span></label>
          </div><small>{kaynak === 'elle' ? 'Elle girilen ilanı yalnızca siz aktif veya pasif yaparsınız.' : 'Portal ilanı kaynaktan düşerse ayrıca otomatik pasif olur. Buradaki karar senkron sonrasında korunur.'}</small></fieldset>
          <fieldset class="isletim-karti"><legend>Takip hatırlatması</legend><div class="alan-grid alan-grid--iki"><label class="alan"><span>Kontrol tarihi</span><input type="date" name="hatirlatma_tarihi" value={deger('hatirlatma_tarihi')} /></label><label class="alan"><span>İç not</span><input type="text" name="hatirlatma_notu" value={deger('hatirlatma_notu')} maxlength="500" placeholder="Örn. Yetki belgesini yenile" /></label></div><small>Tarihi geldiğinde sabah özetine eklenir ve panelde gecikmiş olarak görünür.</small></fieldset>
        </div>
        <fieldset class="sosyal-karti" data-sosyal-karti>
          <label class="sosyal-ana"><input type="checkbox" name="sosyal_medya_paylas" value="evet" checked={secili('sosyal_medya_paylas', 'evet')} data-sosyal-ac /><span><strong>Kaydettikten sonra sosyal medya kuyruğuna ekle</strong><small>Yayın otomasyonu aktiflik, güncel fiyat ve fotoğrafları göndermeden hemen önce siteden yeniden doğrular.</small></span></label>
          <div class="sosyal-platformlar" data-sosyal-platformlar hidden>
            {[['ig', 'Instagram'], ['facebook', 'Facebook'], ['threads', 'Threads'], ['reels', 'Instagram Reels'], ['youtube', 'YouTube Shorts'], ['tiktok', 'TikTok']].map(([degerPlatform, etiket]) => <label><input type="checkbox" name="sosyal_platform" value={degerPlatform} checked={secili('sosyal_platform', degerPlatform) || !degerler.sosyal_platform} /><span>{etiket}</span></label>)}
          </div>
        </fieldset>
      </section>
    </div>
  </div>

  <footer class="form-eylem-cubugu">
    <div><strong data-alt-durum>{mod === 'ekle' ? 'Yeni ilan taslağı' : `İlan no: ${ilanId}`}</strong><span>Fotoğraflar ve sosyal yayın tercihi son adımda işlenir.</span></div>
    <div><a href="/yonetim/ilanlar" class="form-ikincil">Vazgeç</a>{mod === 'duzenle' && ilanId && <a href={`/ilan/${ilanId}`} target="_blank" class="form-ikincil">Sitede gör ↗</a>}<button type="submit" class="form-kaydet">{mod === 'ekle' ? 'İlanı kaydet ve yayınla' : 'Değişiklikleri kaydet'}</button></div>
  </footer>
</form>

<style>
