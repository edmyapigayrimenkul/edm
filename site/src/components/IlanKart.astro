---
import type { Ilan } from '../lib/ilanlar';
import { fiyatKisa } from '../lib/ilanlar';
import { islemEtiketi } from '../lib/ilan-bilgileri';
import FavoriDugme from './FavoriDugme.astro';
import { gorselSunumu, GORSEL_YEDEK_BETIGI } from '../lib/gorsel-sunum';

interface Props {
  ilan: Ilan;
  /** İlk ekranda görünen kartlarda görsel hemen yüklenir. */
  oncelikli?: boolean;
  /** Geniş kart: iki sütun kaplar, görsel daha yatay. */
  genis?: boolean;
  /** Kapalı başlar: /favorilerim kartları yalnızca kayıtlıysa açılıyor. */
  gizli?: boolean;
}

const { ilan, oncelikli = false, genis = false, gizli = false } = Astro.props;
const gorsel = ilan.kapak ? gorselSunumu(ilan.kapak, genis ? 'kapak' : 'kart') : undefined;
const durumEtiketi = islemEtiketi(ilan.islem);
const satisMi = ilan.islem.endsWith('satilik');
const fiyatDonemi = ilan.islem === 'gunluk-kiralik' ? '/gün' : ilan.islem === 'sezonluk-kiralik' ? '/sezon' : ilan.islem === 'kiralik' ? '/ay' : '';
---

<article
  class:list={['grup-kart ilan-kart', genis && 'ilan-kart--genis']}
  data-ilan
  data-islem={ilan.islem}
  data-tip-grup={ilan.tipGrup}
  data-tip={ilan.tip}
  data-ilce={ilan.ilce ?? ''}
  data-mahalle={ilan.mahalle ?? ''}
  data-il={ilan.il ?? ''}
  data-fiyat={ilan.fiyat ?? 0}
  data-para={ilan.paraBirimi}
  data-m2={ilan.alanlar.karsilastirmaM2 ?? 0}
  data-oda={ilan.oda ?? ''}
  data-tarih={Date.parse(ilan.guncellenme ?? ilan.ilkGorulme) || 0}
  data-ara={ilan.aramaMetni}
  data-id={ilan.id}
  data-baslik={ilan.baslikTemiz}
  data-fiyat-metin={ilan.fiyatMetin}
  data-yol={ilan.yol}
  hidden={gizli}
>
  <FavoriDugme id={ilan.id} baslik={ilan.baslikTemiz} />

  <a href={ilan.yol} class="flex h-full flex-col">
    <div class:list={['goruntu-kutu ilan-gorsel', genis && 'ilan-gorsel--genis']}>
      {
        ilan.kapak ? (
          <picture>
          {gorsel?.mobilYogunKaynak && <source media="(min-resolution: 1.5dppx) and (max-width: 899px)" srcset={gorsel.mobilYogunKaynak} />}
          {gorsel?.yogunKaynak && <source media="(min-resolution: 1.5dppx)" srcset={gizli ? undefined : gorsel.yogunKaynak} data-srcset={gizli ? gorsel.yogunKaynak : undefined} />}
          <img
            src={gizli ? undefined : gorsel?.kaynak}
            srcset={gizli ? undefined : gorsel?.secenekler}
            data-src={gizli ? gorsel?.kaynak : undefined}
            data-srcset={gizli ? gorsel?.secenekler : undefined}
            data-gorsel-alternatif={gizli ? undefined : gorsel?.alternatifKaynak}
            data-gorsel-yedek={gorsel?.yogunKaynak || gorsel?.mobilYogunKaynak ? ilan.kapak : undefined}
            onerror={gorsel?.yogunKaynak || gorsel?.mobilYogunKaynak ? GORSEL_YEDEK_BETIGI : undefined}
            alt={ilan.baslikTemiz}
            loading={oncelikli ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={oncelikli ? 'high' : 'auto'}
          />
          </picture>
        ) : (
          <div class="grid h-full place-items-center">
            <span class="etiket">Görsel yok</span>
          </div>
        )
      }

      <div class="ilan-rozetler">
        <span class:list={['rozet', satisMi ? 'rozet--kirmizi' : 'rozet--murekkep']}>
          {durumEtiketi}
        </span>
        {ilan.yeniMi && <span class="rozet rozet--yeni">Yeni</span>}
      </div>

      {
        ilan.gorseller.length > 1 && (
          <span class="ilan-foto-sayisi font-veri">{ilan.gorseller.length} fotoğraf</span>
        )
      }
    </div>

    <div class="flex flex-1 flex-col p-5">
      <p class="etiket">{ilan.kategori} · {ilan.konumKisa}</p>

      <h3 class="baslik-kucuk mt-2.5 line-clamp-2">{ilan.baslikTemiz}</h3>

      {ilan.mahalle && <p class="mt-1.5 text-sm text-metin-2">{ilan.mahalle}</p>}

      <div class="mt-auto pt-5">
        <div class="cizgi"></div>
        <div class="ilan-alt">
          <ul class="ilan-ozellikler font-veri">
            {ilan.etiketler.map((e) => <li>{e}</li>)}
          </ul>
          <p class="ilan-fiyat">
            {fiyatKisa(ilan.fiyat, ilan.paraBirimi, ilan.islem)}
            {fiyatDonemi && <span class="ilan-fiyat-ek">{fiyatDonemi}</span>}
          </p>
        </div>
      </div>
    </div>
  </a>
</article>
