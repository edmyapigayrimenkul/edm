---
import { whatsappBaglanti } from '../lib/site';

interface Props {
  /** Sayfaya özel açılış mesajı — ilan detayında ilan başlığıyla dolar. */
  mesaj?: string;
}
const { mesaj = 'Merhaba, EDM Yapı & Gayrimenkul ile görüşmek istiyorum.' } = Astro.props;
---

<a
  href={whatsappBaglanti(mesaj)}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-dugme"
  aria-label="WhatsApp ile yazın"
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z"
    ></path>
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.96L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.36 8.24 8.24 0 0 1 8.23-8.23c2.2 0 4.26.86 5.81 2.42a8.16 8.16 0 0 1 2.41 5.82c0 4.54-3.7 8.21-8.23 8.21Z"
    ></path>
  </svg>
  <span class="wa-metin">WhatsApp</span>
</a>

<style>
  .wa-dugme {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 45;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: 3.25rem;
    padding-inline: 1rem;
    border-radius: 999px;
    background: var(--color-murekkep);
    color: var(--color-kagit);
    box-shadow: 0 4px 12px -4px rgb(18 19 22 / 0.4), 0 16px 36px -12px rgb(18 19 22 / 0.35);
    transition: transform 0.5s var(--ease-yumusak), background-color 0.4s var(--ease-yumusak);
  }
  .wa-dugme:hover {
    background: #25d366;
    transform: translateY(-2px);
  }
  .wa-dugme:active {
    transform: translateY(0) scale(0.97);
  }

  .wa-dugme svg {
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
  }

  .wa-metin {
    font-size: 0.875rem;
    font-weight: 600;
    /* Dar ekranda yalnızca simge kalsın */
    display: none;
  }
  @media (min-width: 480px) {
    .wa-metin {
      display: inline;
    }
  }
  @media (max-width: 479px) {
    .wa-dugme {
      padding-inline: 0;
      width: 3.25rem;
      justify-content: center;
    }
  }
</style>
