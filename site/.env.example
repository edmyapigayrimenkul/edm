# Cloudflare dağıtımı için — gerçek değerler .env dosyasında, git'e girmez.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GOOGLE_ANAHTARI=

# Cloudflare Access politikasına ve Worker'ın ikinci izin katmanına yazılır.
# Birden fazla tam yetkili admini virgülle ayırın.
PANEL_ADMIN_EPOSTALARI=yonetici@example.com,ikinci.yonetici@example.com

# Site ile postedm GitHub işi arasında ortak, uzun ve rastgele anahtar.
POSTEDM_API_ANAHTARI=
# postedm'e "kuyrukta iş var" haberi vermek için (repository_dispatch).
# Tanımlı değilse tetikleme atlanır ve iş postedm'in saatlik cron'uyla alınır.
# İnce taneli PAT, yalnızca postedm deposu, Contents: read + Actions: write
POSTEDM_GITHUB_JETONU=
POSTEDM_DEPO=edmyapigayrimenkul/postedm

# Pasife düşen portal ilanları için WhatsApp Cloud API bildirimi.
WHATSAPP_TELEFON_NO_KIMLIGI=
WHATSAPP_ERISIM_JETONU=
WHATSAPP_BILDIRIM_ALICI=
WHATSAPP_PASIF_SABLONU=
