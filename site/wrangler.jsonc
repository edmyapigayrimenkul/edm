{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edm-yapi-gayrimenkul",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },

  "observability": { "enabled": true },

  // İlan ve talep veritabanı
  "d1_databases": [
    {
      "binding": "VT",
      "database_name": "edm-talepler",
      "database_id": "30d4df58-b49f-43c8-95c5-5a538ce44f68"
    }
  ],

  // Portföy senkronu: her gün 06:00, 12:00, 18:00 ve 00:00 (UTC)
  "triggers": {
    "crons": ["0 3,9,15,21 * * *"]
  },

  // Form bildirimleri — Cloudflare Email Service.
  // Doğrulanmış hedef adrese gönderim ücretsiz ve kotaya sayılmıyor.
  "send_email": [{ "name": "EPOSTA" }],

  "vars": {
    "BILDIRIM_ADRESI": "ozdogandogukan@gmail.com"
  }
}
